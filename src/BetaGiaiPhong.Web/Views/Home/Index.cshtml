@using System.Globalization
@using BetaGiaiPhong.Web.Models.Responses
@model BetaGiaiPhong.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["HeaderOverlay"] = true;

    var hero = Model.HeroMovie;
    var slides = Model.BillboardSlides;
    int slideCount = slides.Count;
    bool hasMultipleSlides = slideCount > 1;
    bool isSpotlightWide = Model.OnSaleMovies.Count <= 3;
}

@functions {
    private static string GetAgeBadgeClass(string? ageLabel)
    {
        if (string.IsNullOrWhiteSpace(ageLabel)) return "bgp-age-badge";
        return ageLabel.Trim().ToUpperInvariant() switch
        {
            "P" => "bgp-age-badge bgp-age-badge--p",
            "K" => "bgp-age-badge bgp-age-badge--k",
            "T13" or "C13" => "bgp-age-badge bgp-age-badge--t13",
            "T16" or "C16" => "bgp-age-badge bgp-age-badge--t16",
            "T18" or "C18" => "bgp-age-badge bgp-age-badge--t18",
            _ => "bgp-age-badge bgp-age-badge--t13"
        };
    }

    private static string? BuildPosterSrcSet(MovieSummaryDto movie)
    {
        if (movie.Artwork?.HasVerifiedPoster == true
            && !string.IsNullOrWhiteSpace(movie.Artwork.PosterW342Url)
            && !string.IsNullOrWhiteSpace(movie.Artwork.PosterUrl))
        {
            return $"{movie.Artwork.PosterW342Url} 342w, {movie.Artwork.PosterUrl} 780w";
        }
        return null;
    }

    private static string? BuildWideBackdropSrcSet(MovieSummaryDto movie)
    {
        if (movie.Artwork?.HasVerifiedBackdrop == true
            && !string.IsNullOrWhiteSpace(movie.Artwork.BackdropW780Url)
            && !string.IsNullOrWhiteSpace(movie.Artwork.BackdropUrl))
        {
            return $"{movie.Artwork.BackdropW780Url} 780w, {movie.Artwork.BackdropUrl} 1280w";
        }
        return null;
    }

    private static string? ResolveBackdropSrc(MovieSummaryDto? movie)
    {
        if (movie == null) return null;
        if (movie.Artwork?.HasVerifiedBackdrop == true && !string.IsNullOrWhiteSpace(movie.Artwork.BackdropUrl))
        {
            return movie.Artwork.BackdropUrl;
        }
        return !string.IsNullOrWhiteSpace(movie.PosterUrl) ? movie.PosterUrl : null;
    }

    private static string ResolveThumbSrc(MovieSummaryDto movie)
    {
        if (movie.Artwork?.HasVerifiedBackdrop == true
            && !string.IsNullOrWhiteSpace(movie.Artwork.BackdropW780Url ?? movie.Artwork.BackdropUrl))
        {
            return movie.Artwork.BackdropW780Url ?? movie.Artwork.BackdropUrl!;
        }
        return !string.IsNullOrWhiteSpace(movie.PosterUrl) ? movie.PosterUrl : "/images/poster-fallback.svg";
    }

    private static string FormatPrimaryGenre(string? genreText)
    {
        if (string.IsNullOrWhiteSpace(genreText)) return "Điện ảnh";
        var parts = genreText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length > 0 ? parts[0] : genreText;
    }

    private static IReadOnlyList<string> SplitGenres(string? genreText, int maxCount = 3)
    {
        if (string.IsNullOrWhiteSpace(genreText)) return [];
        return genreText
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(maxCount)
            .ToList();
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-home.css" asp-append-version="true" />
}

<div class="bgp-home">
    <!-- 1. Mục 3: Full-Bleed Immersive Billboard Carousel + 16:9 Thumbnail Strip -->
    @if (slideCount == 0)
    {
        <section class="bgp-home-hero bgp-home-hero--empty" aria-labelledby="hero-title">
            <div class="bgp-hero__vignette" aria-hidden="true"></div>
            <div class="bgp-container bgp-hero__inner">
                <div class="bgp-hero__content">
                    <div class="bgp-hero-eyebrow">
                        <span class="bgp-hero-pill bgp-hero-pill--live">
                            <span class="bgp-hero-pill__dot" aria-hidden="true"></span>
                            BETA GIẢI PHÓNG CINEMA
                        </span>
                    </div>
                    <h1 id="hero-title" class="bgp-hero-title">
                        @await Html.PartialAsync("_MovieTitleTreatment", ((MovieSummaryDto?)null, "hero"))
                    </h1>
                    <p class="bgp-hero-synopsis">
                        Chào mừng bạn đến với hệ thống rạp Beta Giải Phóng. Nền tảng tra cứu lịch chiếu, chọn ghế thời gian thực và quản lý vé xem phim tiện lợi.
                    </p>
                    <div class="bgp-hero-actions">
                        <a class="bgp-hero-cta-primary"
                           data-testid="hero-primary-cta"
                           asp-controller="Movies"
                           asp-action="Index">
                            <span class="bgp-hero-cta-primary__play" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <polygon points="6 4 20 12 6 20 6 4"></polygon>
                                </svg>
                            </span>
                            <span>Khám phá phim</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        var initialSlide = slides[0];
        bool initialHasTrailer = !string.IsNullOrWhiteSpace(initialSlide.Movie.OfficialTrailerYoutubeId);
        bool initialHasVideo = !string.IsNullOrWhiteSpace(initialSlide.DirectVideoPreviewUrl) || initialHasTrailer;

        <section class="bgp-home-hero bgp-billboard"
                 data-billboard
                 data-testid="hero-billboard"
                 aria-roledescription="carousel"
                 aria-label="Tác phẩm nổi bật tại Beta Giải Phóng">
            <div class="bgp-billboard__viewport" data-billboard-viewport>
                <div class="bgp-billboard__track" data-billboard-track data-testid="billboard-track">
                    @for (int idx = 0; idx < slideCount; idx++)
                    {
                        var slide = slides[idx];
                        var item = slide.Movie;
                        bool isFirst = idx == 0;
                        string? backdropSrc = ResolveBackdropSrc(item);
                        string? backdropSrcSet = BuildWideBackdropSrcSet(item);
                        var genreParts = SplitGenres(item.GenreText, 3);
                        bool hasDistinctOriginal = !string.IsNullOrWhiteSpace(item.OriginalTitle)
                            && !string.Equals(item.OriginalTitle.Trim(), item.Title.Trim(), StringComparison.OrdinalIgnoreCase);

                        <article class="bgp-billboard-slide @(isFirst ? "is-active" : "")"
                                 data-billboard-slide
                                 data-testid="billboard-slide"
                                 data-slide-index="@idx"
                                 data-movie-id="@item.MovieId"
                                 data-movie-title="@item.Title"
                                 data-age-label="@(item.AgeLabel ?? "")"
                                 data-trailer-youtube-id="@(item.OfficialTrailerYoutubeId ?? "")"
                                 data-direct-video-url="@(slide.DirectVideoPreviewUrl ?? "")"
                                 aria-roledescription="slide"
                                 aria-label="@($"{idx + 1} / {slideCount}: {item.Title}")"
                                 aria-hidden="@(isFirst ? "false" : "true")"
                                 @(isFirst ? null : Html.Raw("inert"))>

                            @if (!string.IsNullOrWhiteSpace(backdropSrc))
                            {
                                <img src="@backdropSrc"
                                     srcset="@backdropSrcSet"
                                     sizes="100vw"
                                     alt="Hình nền phim @item.Title"
                                     class="bgp-hero__backdrop"
                                     data-slide-backdrop
                                     data-testid="@(isFirst ? "hero-backdrop-img" : null)"
                                     fetchpriority="@(isFirst ? "high" : null)"
                                     loading="@(isFirst ? "eager" : "lazy")"
                                     decoding="async"
                                     onerror="this.onerror=null;this.removeAttribute('srcset');this.style.opacity='0';" />
                            }

                            <!-- Inline Full-Bleed Highlight Video Layer (Mounted on demand) -->
                            <div class="bgp-billboard-slide__video-stage"
                                 data-billboard-video-stage
                                 aria-hidden="true"></div>

                            <div class="bgp-hero__vignette" aria-hidden="true"></div>

                            <div class="bgp-container bgp-hero__inner">
                                <div class="bgp-hero__content">
                                    <!-- Frosted Glass Metadata Pills -->
                                    <div class="@(isFirst ? "bgp-hero-eyebrow" : "bgp-billboard-slide__eyebrow")"
                                         data-slide-eyebrow>
                                        @if (item.UpcomingShowtimesCount > 0)
                                        {
                                            <span class="bgp-hero-pill bgp-hero-pill--live">
                                                <span class="bgp-hero-pill__dot" aria-hidden="true"></span>
                                                ĐANG CHIẾU
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bgp-hero-pill">SẮP CHIẾU</span>
                                        }

                                        @if (item.Rating != null)
                                        {
                                            <span class="bgp-hero-pill bgp-hero-pill--rating"
                                                  data-slide-rating
                                                  data-testid="@(isFirst ? "hero-rating-badge" : null)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="#F5C518" aria-hidden="true">
                                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                </svg>
                                                @item.Rating.DisplayText
                                            </span>
                                        }

                                        @if (item.ReleaseYear.HasValue)
                                        {
                                            <span class="bgp-hero-pill">@item.ReleaseYear.Value</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.AgeLabel))
                                        {
                                            <span class="@GetAgeBadgeClass(item.AgeLabel) bgp-hero-pill--age"
                                                  data-slide-age
                                                  data-testid="@(isFirst ? "hero-age-badge" : null)">@item.AgeLabel</span>
                                        }
                                    </div>

                                    @if (isFirst)
                                    {
                                        <h1 id="hero-title" class="bgp-hero-title" data-slide-heading>
                                            @await Html.PartialAsync("_MovieTitleTreatment", (item, "hero"))
                                        </h1>
                                    }
                                    else
                                    {
                                        <h2 class="bgp-billboard-slide__title" data-slide-heading>
                                            @await Html.PartialAsync("_MovieTitleTreatment", (item, "hero"))
                                        </h2>
                                    }

                                    @if (hasDistinctOriginal)
                                    {
                                        <p class="bgp-hero__original-title">@item.OriginalTitle</p>
                                    }

                                    <div class="bgp-hero-meta">
                                        @for (int gIdx = 0; gIdx < genreParts.Count; gIdx++)
                                        {
                                            if (gIdx > 0)
                                            {
                                                <span class="bgp-hero-sep" aria-hidden="true">·</span>
                                            }
                                            <span>@genreParts[gIdx]</span>
                                        }
                                        @if (genreParts.Count > 0)
                                        {
                                            <span class="bgp-hero-sep" aria-hidden="true">·</span>
                                        }
                                        <span>@item.DurationMin phút</span>
                                        @if (item.UpcomingShowtimesCount > 0)
                                        {
                                            <span class="bgp-hero-sep" aria-hidden="true">·</span>
                                            <span class="bgp-hero-meta__slots">@item.UpcomingShowtimesCount suất chiếu</span>
                                        }
                                    </div>

                                    <p class="@(isFirst ? "bgp-hero-synopsis" : "bgp-billboard-slide__synopsis")"
                                       data-slide-synopsis>
                                        @if (!string.IsNullOrWhiteSpace(item.Synopsis))
                                        {
                                            @item.Synopsis
                                        }
                                        else if (item.UpcomingShowtimesCount > 0)
                                        {
                                            @:Phim hiện đang có lịch chiếu tại Beta Giải Phóng. Mời bạn theo dõi lịch chiếu và chọn ghế trực tuyến.
                                        }
                                        else
                                        {
                                            @:Phim đã được phát hành trên hệ thống. Hiện chưa có suất chiếu sắp tới.
                                        }
                                    </p>

                                    @if (slide.NextShowtimes.Count > 0)
                                    {
                                        <div class="bgp-hero__quick-times"
                                             data-slide-quick-times
                                             data-testid="@(isFirst ? "hero-quick-showtimes" : null)">
                                            @foreach (var chip in slide.NextShowtimes.Take(3))
                                            {
                                                <a class="bgp-hero-time-chip"
                                                   asp-controller="Showtimes"
                                                   asp-action="Seats"
                                                   asp-route-id="@chip.ShowtimeId"
                                                   title="@chip.RoomName • Còn @chip.AvailableSeatsCount ghế trống">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                                        <circle cx="12" cy="12" r="10"></circle>
                                                        <polyline points="12 6 12 12 16 14"></polyline>
                                                    </svg>
                                                    @(chip.CrossesMidnight ? $"{chip.StartVietnamText} (+1n)" : chip.StartVietnamText)
                                                </a>
                                            }
                                        </div>
                                    }

                                    <!-- Circular + Pill Glass Action Bar -->
                                    <div class="bgp-hero-actions">
                                        <a class="bgp-hero-cta-primary"
                                           data-slide-primary-cta
                                           data-testid="@(isFirst ? "hero-primary-cta" : null)"
                                           asp-controller="Movies"
                                           asp-action="Details"
                                           asp-route-id="@item.MovieId">
                                            <span class="bgp-hero-cta-primary__play" aria-hidden="true">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                    <polygon points="6 4 20 12 6 20 6 4"></polygon>
                                                </svg>
                                            </span>
                                            <span>@(item.UpcomingShowtimesCount > 0 ? "Xem lịch chiếu" : "Chi tiết phim")</span>
                                        </a>

                                        <button type="button"
                                                class="bgp-hero-circle-btn"
                                                data-preview-trigger="@item.MovieId"
                                                aria-label="Xem nhanh thông tin phim @item.Title"
                                                title="Xem nhanh tóm tắt & suất chiếu">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                                                <path d="M12 12h.01"></path>
                                                <path d="M17 12h.01"></path>
                                                <path d="M7 12h.01"></path>
                                            </svg>
                                        </button>

                                        <a class="bgp-hero-cta-glass"
                                           data-slide-secondary-cta
                                           data-testid="@(isFirst ? "hero-secondary-cta" : null)"
                                           href="#now-showing">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                            </svg>
                                            <span>Khám phá phim</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <!-- Top-Right Frosted Glass [Trailer] Pill + Inline Video / Mute Circular Controls -->
            <div class="bgp-billboard__top-dock" data-billboard-edge-dock>
                <button type="button"
                        class="bgp-billboard__trailer-pill"
                        data-billboard-trailer-pill
                        data-testid="hero-trailer-btn"
                        data-trailer-open="@(initialHasTrailer ? initialSlide.Movie.OfficialTrailerYoutubeId : null)"
                        data-trailer-title="@initialSlide.Movie.Title"
                        aria-label="Xem trailer chính thức phim @initialSlide.Movie.Title"
                        @(initialHasTrailer ? null : Html.Raw("hidden"))>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="3" width="20" height="18" rx="2.5"></rect>
                        <line x1="7" y1="3" x2="7" y2="21"></line>
                        <line x1="17" y1="3" x2="17" y2="21"></line>
                        <polygon points="10 9 15 12 10 15 10 9" fill="currentColor" stroke="none"></polygon>
                    </svg>
                    <span>Trailer</span>
                </button>

                <button type="button"
                        class="bgp-billboard__media-btn"
                        data-billboard-video-toggle
                        data-testid="billboard-video-toggle"
                        aria-pressed="false"
                        aria-label="Phát video nổi bật ngay trên nền"
                        title="Phát / Dừng video nổi bật trên nền"
                        @(initialHasVideo ? null : Html.Raw("hidden"))>
                    <svg class="bgp-billboard__icon-video-play" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="4" width="20" height="16" rx="2.5"></rect>
                        <polygon points="10 8.5 16 12 10 15.5 10 8.5" fill="currentColor" stroke="none"></polygon>
                    </svg>
                    <svg class="bgp-billboard__icon-video-stop" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="2.5"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                </button>

                <button type="button"
                        class="bgp-billboard__media-btn"
                        data-billboard-mute-toggle
                        data-testid="billboard-mute-toggle"
                        aria-pressed="true"
                        aria-label="Bật âm thanh video nền"
                        title="Bật / Tắt âm thanh"
                        hidden>
                    <svg class="bgp-billboard__icon-muted" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                        <line x1="23" y1="9" x2="17" y2="15"></line>
                        <line x1="17" y1="9" x2="23" y2="15"></line>
                    </svg>
                    <svg class="bgp-billboard__icon-unmuted" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                    </svg>
                </button>
            </div>

            @if (hasMultipleSlides)
            {
                <button type="button"
                        class="bgp-billboard__nav-btn bgp-billboard__nav-btn--prev"
                        data-billboard-prev
                        data-testid="billboard-prev-btn"
                        aria-label="Phim nổi bật trước">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                </button>

                <button type="button"
                        class="bgp-billboard__nav-btn bgp-billboard__nav-btn--next"
                        data-billboard-next
                        data-testid="billboard-next-btn"
                        aria-label="Phim nổi bật tiếp theo">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </button>

                <!-- Bottom-Right 16:9 Miniature Thumbnail Strip + Bottom White Progress Bar -->
                <div class="bgp-billboard__thumbs-wrap">
                    <div class="bgp-container bgp-billboard__thumbs-row">
                        <div class="bgp-billboard__thumbs"
                             role="tablist"
                             aria-label="Chọn phim nổi bật trên Billboard"
                             data-billboard-indicators
                             data-testid="billboard-indicators">
                            @for (int idx = 0; idx < slideCount; idx++)
                            {
                                var item = slides[idx].Movie;
                                bool isFirst = idx == 0;
                                string thumbSrc = ResolveThumbSrc(item);

                                <button type="button"
                                        role="tab"
                                        class="bgp-billboard__thumb @(isFirst ? "is-active" : "")"
                                        data-billboard-indicator="@idx"
                                        data-testid="billboard-indicator"
                                        aria-selected="@(isFirst ? "true" : "false")"
                                        aria-label="@($"Phim nổi bật {idx + 1}: {item.Title}")"
                                        title="@item.Title">
                                    <img src="@thumbSrc"
                                         alt=""
                                         class="bgp-billboard__thumb-img"
                                         loading="eager"
                                         decoding="async"
                                         onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.src='/images/poster-fallback.svg';}" />
                                    <span class="bgp-billboard__indicator-fill" aria-hidden="true"></span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="bgp-sr-only" aria-live="polite" aria-atomic="true" data-billboard-live></div>
        </section>
    }

    <!-- 2. Mục 4: Topic Bento Strip, Paginated Section Headers & Structured Cinema Rails -->
    <div class="bgp-container">
        <div class="bgp-rails-stack">

            @if (Model.FeaturedMovies.Count > 0)
            {
                <!-- 4.1 Quick Topic Bento Strip ("Bạn đang quan tâm gì?") -->
                <section class="bgp-topics-section" aria-labelledby="topics-heading" data-testid="topics-bento-section">
                    <h2 id="topics-heading" class="bgp-topics-heading">Bạn đang quan tâm gì?</h2>
                    <div class="bgp-topics-grid">
                        <a class="bgp-topic-card bgp-topic-card--crimson"
                           data-testid="topic-bento-card"
                           asp-controller="Movies"
                           asp-action="Index"
                           asp-route-filter="has-showtimes">
                            <span class="bgp-topic-card__icon" aria-hidden="true">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="3" width="20" height="18" rx="2.5"></rect>
                                    <line x1="7" y1="3" x2="7" y2="21"></line>
                                    <line x1="17" y1="3" x2="17" y2="21"></line>
                                    <line x1="2" y1="12" x2="22" y2="12"></line>
                                </svg>
                            </span>
                            <div class="bgp-topic-card__body">
                                <span class="bgp-topic-card__title">Đang Mở Bán Vé</span>
                                <span class="bgp-topic-card__sub">Xem chủ đề &rsaquo;</span>
                            </div>
                        </a>

                        <a class="bgp-topic-card bgp-topic-card--amber"
                           data-testid="topic-bento-card"
                           href="#upcoming-schedule">
                            <span class="bgp-topic-card__icon" aria-hidden="true">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </span>
                            <div class="bgp-topic-card__body">
