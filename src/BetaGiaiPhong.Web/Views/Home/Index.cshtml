            @if (Model.OnSaleMovies.Count > 0)
            {
                <!-- 4.2 Rail 1: 16:9 Landscape Cards with Detached Dark Footer & Showtime Chips -->
                <section id="on-sale-today"
                         class="bgp-rail-section"
                         aria-labelledby="on-sale-heading"
                         @(isSpotlightWide ? null : Html.Raw("data-rail-root"))>
                    <div class="bgp-rail-header">
                        <div class="bgp-rail-heading-group">
                            <h2 id="on-sale-heading" class="bgp-rail-title">Đang Mở Bán Vé Trực Tuyến</h2>
                            <p class="bgp-rail-subtitle">Chọn nhanh suất chiếu để vào thẳng sơ đồ ghế</p>
                        </div>

                        <div class="bgp-rail-controls">
                            @if (!isSpotlightWide)
                            {
                                <span class="bgp-rail-page" data-rail-page aria-live="polite">1/2</span>
                                <button type="button"
                                        class="bgp-rail-nav-circle"
                                        data-rail-prev
                                        aria-label="Cuộn hàng phim đang mở bán sang trái"
                                        disabled>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m15 18-6-6 6-6"></path>
                                    </svg>
                                </button>
                                <button type="button"
                                        class="bgp-rail-nav-circle"
                                        data-rail-next
                                        aria-label="Cuộn hàng phim đang mở bán sang phải">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m9 18 6-6-6-6"></path>
                                    </svg>
                                </button>
                            }
                            <a class="bgp-rail-more" asp-controller="Movies" asp-action="Index" asp-route-filter="has-showtimes">
                                Xem tất cả &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="bgp-rail-wrapper">
                        <div class="bgp-wide-rail @(isSpotlightWide ? "bgp-wide-rail--spotlight" : "")"
                             @(isSpotlightWide ? null : Html.Raw("data-rail-scroller"))
                             data-testid="wide-movie-rail"
                             tabindex="0"
                             role="region"
                             aria-label="Các phim đang mở bán suất chiếu">
                            @foreach (var item in Model.OnSaleMovies)
                            {
                                var m = item.Movie;
                                bool hasWideBackdrop = m.Artwork?.HasVerifiedBackdrop == true && !string.IsNullOrWhiteSpace(m.Artwork.BackdropW780Url ?? m.Artwork.BackdropUrl);
                                string wideSrc = hasWideBackdrop
                                    ? (m.Artwork!.BackdropW780Url ?? m.Artwork.BackdropUrl!)
                                    : (string.IsNullOrWhiteSpace(m.PosterUrl) ? "/images/poster-fallback.svg" : m.PosterUrl);
                                string? wideSrcSet = hasWideBackdrop ? BuildWideBackdropSrcSet(m) : BuildPosterSrcSet(m);
                                string subtitleLine = !string.IsNullOrWhiteSpace(m.OriginalTitle)
                                    ? m.OriginalTitle
                                    : (m.GenreText ?? "Phim chiếu rạp");

                                <article class="bgp-wide-card"
                                         data-testid="wide-movie-card"
                                         data-preview-movie-id="@m.MovieId">
                                    <div class="bgp-wide-card__stage">
                                        <a class="bgp-wide-card__media"
                                           asp-controller="Movies"
                                           asp-action="Details"
                                           asp-route-id="@m.MovieId">
                                            <img src="@wideSrc"
                                                 srcset="@wideSrcSet"
                                                 sizes="(max-width: 767px) 84vw, 320px"
                                                 alt="Hình phim @m.Title"
                                                 class="bgp-wide-card__img @(hasWideBackdrop ? "" : "bgp-wide-card__img--contain")"
                                                 loading="lazy"
                                                 decoding="async"
                                                 onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.removeAttribute('srcset');this.classList.add('bgp-wide-card__img--contain');this.src='/images/poster-fallback.svg';}" />

                                            <div class="bgp-card-corner bgp-card-corner--tl">
                                                @if (!string.IsNullOrWhiteSpace(m.AgeLabel))
                                                {
                                                    <span class="@GetAgeBadgeClass(m.AgeLabel)">@m.AgeLabel</span>
                                                }
                                                else
                                                {
                                                    <span class="bgp-micro-pill">MỞ BÁN</span>
                                                }
                                            </div>

                                            <div class="bgp-card-corner bgp-card-corner--bl">
                                                <span class="bgp-micro-pill">@m.DurationMin phút</span>
                                            </div>

                                            @if (m.Rating != null)
                                            {
                                                <div class="bgp-card-corner bgp-card-corner--br">
                                                    <span class="bgp-micro-pill bgp-micro-pill--star" title="@m.Rating.DisplayText">
                                                        <span class="bgp-star-glyph" aria-hidden="true">★</span> @m.Rating.Score.ToString("0.0", CultureInfo.InvariantCulture)
                                                    </span>
                                                </div>
                                            }
                                        </a>

                                        <button type="button"
                                                class="bgp-wide-card__preview-btn"
                                                data-preview-trigger="@m.MovieId"
                                                data-testid="wide-card-preview-btn"
                                                aria-label="Xem nhanh thông tin phim @m.Title">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </button>
                                    </div>

                                    <div class="bgp-wide-card__body">
                                        <h3 class="bgp-wide-card__title">
                                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.MovieId">@m.Title</a>
                                        </h3>
                                        <p class="bgp-wide-card__orig">@subtitleLine</p>

                                        <div class="bgp-wide-card__meta">
                                            <span>
                                                @(m.ReleaseYear?.ToString() ?? "Rạp")
                                                @if (m.Rating != null)
                                                {
                                                    <span class="bgp-inline-star"><span class="bgp-star-glyph" aria-hidden="true">★</span> @m.Rating.Score.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                                }
                                            </span>
                                            <span class="bgp-wide-card__genre">@FormatPrimaryGenre(m.GenreText)</span>
                                        </div>

                                        <div class="bgp-time-pills">
                                            @foreach (var chip in item.NextShowtimes.Take(3))
                                            {
                                                <a class="bgp-time-pill"
                                                   data-testid="wide-card-showtime-chip"
                                                   asp-controller="Showtimes"
                                                   asp-action="Seats"
                                                   asp-route-id="@chip.ShowtimeId"
                                                   title="@chip.StartVietnamText • @chip.RoomName • Còn @chip.AvailableSeatsCount ghế">
                                                    @(chip.CrossesMidnight ? $"{chip.StartTimeOnlyText} (+1n)" : chip.StartTimeOnlyText)
                                                </a>
                                            }
                                            <a class="bgp-time-pill bgp-time-pill--highlight"
                                               asp-controller="Movies"
                                               asp-action="Details"
                                               asp-route-id="@m.MovieId">
                                                @m.UpcomingShowtimesCount suất &rarr;
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                </section>
            }

            @if (Model.AcclaimedMovies.Count >= 3)
            {
                <!-- 4.3 Rail 2: Skewed Parallelogram Poster Cards + Outlined Stroke Numerals -->
                <section id="acclaimed-showcase"
                         class="bgp-rail-section"
                         aria-labelledby="acclaimed-heading"
                         data-rail-root
                         data-testid="acclaimed-showcase-section">
                    <div class="bgp-rail-header">
                        <div class="bgp-rail-heading-group">
                            <h2 id="acclaimed-heading" class="bgp-rail-title">Tuyển Tập Điện Ảnh Kinh Điển</h2>
                            <p class="bgp-rail-subtitle">Các tác phẩm đạt điểm đánh giá xác thực cao trên IMDb</p>
                        </div>

                        <div class="bgp-rail-controls">
                            <span class="bgp-rail-page" data-rail-page aria-live="polite">1/2</span>
                            <button type="button"
                                    class="bgp-rail-nav-circle"
                                    data-rail-prev
                                    aria-label="Cuộn tuyển tập kinh điển sang trái"
                                    disabled>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m15 18-6-6 6-6"></path>
                                </svg>
                            </button>
                            <button type="button"
                                    class="bgp-rail-nav-circle"
                                    data-rail-next
                                    aria-label="Cuộn tuyển tập kinh điển sang phải">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m9 18 6-6-6-6"></path>
                                </svg>
                            </button>
                            <a class="bgp-rail-more" asp-controller="Movies" asp-action="Index">
                                Xem tất cả &rarr;
                            </a>
                        </div>
                    </div>

                    <div class="bgp-rail-wrapper">
                        <div class="bgp-skew-rail"
                             data-rail-scroller
                             data-testid="acclaimed-movie-rail"
                             tabindex="0"
                             role="region"
                             aria-label="Tuyển tập điện ảnh kinh điển">
                            @for (int rankIdx = 0; rankIdx < Model.AcclaimedMovies.Count; rankIdx++)
                            {
                                var acMovie = Model.AcclaimedMovies[rankIdx];
                                string acPoster = string.IsNullOrWhiteSpace(acMovie.PosterUrl)
                                    ? "/images/poster-fallback.svg"
                                    : acMovie.PosterUrl;
                                string? acSrcSet = BuildPosterSrcSet(acMovie);
                                string acOrig = !string.IsNullOrWhiteSpace(acMovie.OriginalTitle)
                                    ? acMovie.OriginalTitle
                                    : FormatPrimaryGenre(acMovie.GenreText);

                                <a class="bgp-skew-card"
                                   data-testid="acclaimed-movie-card"
                                   data-preview-movie-id="@acMovie.MovieId"
                                   asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@acMovie.MovieId">
                                    <div class="bgp-skew-card__poster-frame">
                                        <img src="@acPoster"
                                             srcset="@acSrcSet"
                                             sizes="(max-width: 575px) 46vw, 210px"
                                             alt="Poster phim @acMovie.Title"
                                             class="bgp-skew-card__img"
                                             loading="lazy"
                                             decoding="async"
                                             onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.removeAttribute('srcset');this.src='/images/poster-fallback.svg';}" />
                                    </div>

                                    <div class="bgp-skew-card__footer">
                                        <span class="bgp-skew-card__rank" aria-hidden="true">@(rankIdx + 1)</span>
                                        <div class="bgp-skew-card__info">
                                            <h3 class="bgp-skew-card__title">@acMovie.Title</h3>
                                            <div class="bgp-skew-card__orig">@acOrig</div>
                                            <div class="bgp-skew-card__badges">
                                                @if (acMovie.Rating != null)
                                                {
                                                    <span class="bgp-skew-card__tag">★ @acMovie.Rating.Score.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                                }
                                                <span>@acMovie.DurationMin phút</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </section>
            }

            <!-- 4.4 Rail 3: 2:3 Vertical Poster Cards with Detached Dark Footer (#now-showing) -->
            <section id="now-showing"
                     class="bgp-rail-section"
                     aria-labelledby="rail-heading"
                     @(Model.FeaturedMovies.Count > 0 ? Html.Raw("data-rail-root") : null)>
                <div class="bgp-rail-header">
                    <div class="bgp-rail-heading-group">
                        <h2 id="rail-heading" class="bgp-rail-title">Phim Đang Chiếu &amp; Danh Mục Tuyển Chọn</h2>
                        @if (Model.FeaturedMovies.Count > 0)
                        {
                            <p class="bgp-rail-subtitle">Khám phá toàn bộ tác phẩm điện ảnh tại rạp</p>
                        }
                    </div>

                    <div class="bgp-rail-controls">
                        @if (Model.FeaturedMovies.Count > 0)
                        {
                            <span class="bgp-rail-page" data-rail-page aria-live="polite">1/2</span>
                            <button type="button"
                                    class="bgp-rail-nav-circle"
                                    data-rail-prev
                                    data-testid="rail-btn-prev"
                                    aria-label="Cuộn sang trái"
                                    disabled>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m15 18-6-6 6-6"></path>
                                </svg>
                            </button>
                            <button type="button"
                                    class="bgp-rail-nav-circle"
                                    data-rail-next
                                    data-testid="rail-btn-next"
                                    aria-label="Cuộn sang phải">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m9 18 6-6-6-6"></path>
                                </svg>
                            </button>
                        }
                        <a class="bgp-rail-more" asp-controller="Movies" asp-action="Index">
                            Xem tất cả &rarr;
                        </a>
                    </div>
                </div>

                @if (Model.FeaturedMovies.Count == 0)
                {
                    <div class="bgp-empty-state">
                        <div class="bgp-empty-state-icon">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                                <line x1="7" y1="2" x2="7" y2="22"></line>
                                <line x1="17" y1="2" x2="17" y2="22"></line>
                                <line x1="2" y1="12" x2="22" y2="12"></line>
                            </svg>
                        </div>
                        <h3 class="bgp-empty-state__title">Hiện chưa có phim nào đang chiếu</h3>
                        <p class="bgp-empty-state__desc">Lịch chiếu mới đang được cập nhật. Vui lòng quay lại sau!</p>
                        <a class="bgp-btn bgp-btn--outline bgp-btn--sm" asp-controller="Movies" asp-action="Index">
                            Xem danh mục phim
                        </a>
                    </div>
                }
                else
                {
                    <div class="bgp-rail-wrapper">
                        <div class="bgp-movie-rail"
                             data-rail-scroller
                             data-testid="movie-rail"
                             tabindex="0"
                             role="region"
                             aria-label="Danh sách phim đang chiếu cuộn ngang">
                            @foreach (var movie in Model.FeaturedMovies)
                            {
                                string posterSrc = string.IsNullOrWhiteSpace(movie.PosterUrl)
                                    ? "/images/poster-fallback.svg"
                                    : movie.PosterUrl;
                                string? posterSrcSet = BuildPosterSrcSet(movie);
                                string origSubtitle = !string.IsNullOrWhiteSpace(movie.OriginalTitle)
                                    ? movie.OriginalTitle
                                    : "Phim điện ảnh";

                                <a class="bgp-movie-card"
                                   data-testid="movie-card"
                                   data-preview-movie-id="@movie.MovieId"
                                   asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@movie.MovieId">
                                    <div class="bgp-card-poster-wrap">
                                        <img src="@posterSrc"
                                             srcset="@posterSrcSet"
                                             sizes="(max-width: 575px) 44vw, (max-width: 991px) 26vw, 206px"
                                             alt="Poster phim @movie.Title"
                                             class="bgp-card-poster"
                                             loading="lazy"
                                             decoding="async"
                                             onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.removeAttribute('srcset');this.src='/images/poster-fallback.svg';}" />

                                        @if (!string.IsNullOrWhiteSpace(movie.AgeLabel))
                                        {
                                            <span class="bgp-card-badge-age @GetAgeBadgeClass(movie.AgeLabel)">@movie.AgeLabel</span>
                                        }
                                        @if (movie.UpcomingShowtimesCount > 0)
                                        {
                                            <span class="bgp-card-badge-slots">@movie.UpcomingShowtimesCount suất</span>
                                        }

                                        <span class="bgp-card-pill-bl">@movie.DurationMin phút</span>

                                        @if (movie.Rating != null)
                                        {
                                            <span class="bgp-card-pill-br" title="@movie.Rating.DisplayText">
                                                <span class="bgp-star-glyph" aria-hidden="true">★</span> @movie.Rating.Score.ToString("0.0", CultureInfo.InvariantCulture)
                                            </span>
                                        }
                                    </div>

                                    <div class="bgp-card-info">
                                        <h3 class="bgp-card-title">@movie.Title</h3>
                                        <div class="bgp-card-orig">@origSubtitle</div>
                                        <div class="bgp-card-meta">
                                            <span>
                                                @(movie.ReleaseYear?.ToString() ?? "Rạp")
                                                @if (movie.Rating != null)
                                                {
                                                    <span class="bgp-inline-star"><span class="bgp-star-glyph" aria-hidden="true">★</span> @movie.Rating.Score.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                                }
                                            </span>
                                            <span class="bgp-card-meta__genre">@FormatPrimaryGenre(movie.GenreText)</span>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }
            </section>

            <!-- 4.5 Section 4: Upcoming Showtimes Quick Table -->
            @if (Model.UpcomingShowtimes.Count > 0)
            {
                <section id="upcoming-schedule" class="bgp-upcoming-section" aria-labelledby="upcoming-heading">
                    <div class="bgp-rail-header">
                        <div class="bgp-rail-heading-group">
                            <h2 id="upcoming-heading" class="bgp-rail-title">Lịch Chiếu Sắp Diễn Ra</h2>
                            <p class="bgp-rail-subtitle">Theo dõi phòng chiếu và lượng ghế trống theo thời gian thực</p>
                        </div>
                    </div>

                    <div class="bgp-upcoming-card">
                        <div class="bgp-table-wrap">
                            <table class="bgp-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Giờ chiếu</th>
                                        <th scope="col">Tên phim</th>
                                        <th scope="col">Phòng chiếu</th>
                                        <th scope="col">Ghế trống</th>
                                        <th scope="col" class="bgp-upcoming-action-cell">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var st in Model.UpcomingShowtimes)
                                    {
                                        <tr>
                                            <td>
                                                <div class="bgp-upcoming-time">@st.StartVietnamText</div>
                                                <span class="bgp-upcoming-end">Kết thúc: @st.EndVietnamText</span>
                                            </td>
                                            <td>
                                                <a class="bgp-upcoming-movie-link"
                                                   asp-controller="Movies"
                                                   asp-action="Details"
                                                   asp-route-id="@st.MovieId">
                                                    @st.MovieTitle
                                                </a>
                                            </td>
                                            <td>
                                                <span class="bgp-upcoming-room-pill" data-testid="upcoming-room-pill">@st.RoomName</span>
                                            </td>
                                            <td>
                                                <span class="bgp-badge @(st.AvailableSeatsCount > 0 ? "bgp-badge--success" : "bgp-badge--danger")">
                                                    @st.AvailableSeatsCount / @st.SellableCapacity ghế trống
                                                </span>
                                            </td>
                                            <td class="bgp-upcoming-action-cell">
                                                <a class="bgp-btn bgp-btn--outline bgp-btn--sm bgp-upcoming-pill-btn"
                                                   data-testid="upcoming-seat-cta"
                                                   asp-controller="Showtimes"
                                                   asp-action="Seats"
                                                   asp-route-id="@st.ShowtimeId">
                                                    Xem sơ đồ ghế
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

<!-- Click-to-Load Official YouTube Trailer Modal (<dialog>) -->
<dialog id="bgp-trailer-dialog"
        class="bgp-trailer-dialog"
        data-testid="trailer-dialog"
        aria-labelledby="bgp-trailer-dialog-title">
    <div class="bgp-trailer-dialog__header">
        <div class="bgp-trailer-dialog__title-group">
            <div class="bgp-trailer-dialog__eyebrow">Official Trailer</div>
            <h2 id="bgp-trailer-dialog-title" class="bgp-trailer-dialog__title" data-trailer-dialog-title>
                Trailer chính thức
            </h2>
        </div>
        <button type="button"
                class="bgp-icon-btn"
                data-trailer-close
                data-testid="trailer-dialog-close"
                aria-label="Đóng cửa sổ trailer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
    <div class="bgp-trailer-dialog__stage" data-trailer-stage></div>
    <div class="bgp-trailer-dialog__footer" style="justify-content: flex-end;">
        <a href="https://www.youtube.com"
           target="_blank"
           rel="noopener noreferrer"
           class="bgp-cinema-footer__link"
           data-trailer-external-link>
            Mở trên YouTube &nearr;
        </a>
    </div>
</dialog>

<script type="application/json" id="bgp-quick-preview-island">@Html.Raw(Model.QuickPreviewJson)</script>

@section Scripts {
    <script type="module" src="~/js/modules/billboard-carousel.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/rail-carousel.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/preview-popover.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/trailer-dialog.js" asp-append-version="true"></script>
}
