@{
    ViewData["Title"] = "Từ chối truy cập (403 Forbidden)";
}

<div class="container mt-5 mb-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 p-4 p-md-5">
                <div class="display-1 text-danger fw-bold mb-3">403</div>
                <h2 class="h3 fw-bold mb-2">Truy Cập Bị Từ Chối</h2>
                <p class="text-muted mb-4">
                    Tài khoản của bạn không có đủ đặc quyền hoặc vai trò (Role) phù hợp để truy cập vào tài nguyên này.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
                    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Đổi tài khoản khác</a>
                </div>
            </div>
        </div>
    </div>
</div>
