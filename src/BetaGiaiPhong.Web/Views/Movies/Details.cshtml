@using System.Globalization
@using BetaGiaiPhong.Web.Models.Responses
@model BetaGiaiPhong.Web.Models.ViewModels.MovieDetailViewModel
@{
    ViewData["Title"] = Model.Movie.Title;
    ViewData["HeaderOverlay"] = true;

    var movie = Model.Movie;
    bool hasShowtimes = Model.DateGroups.Count > 0;
    bool hasTrailer = !string.IsNullOrWhiteSpace(movie.OfficialTrailerYoutubeId);
    bool hasVerifiedBackdrop = movie.Artwork?.HasVerifiedBackdrop == true && !string.IsNullOrWhiteSpace(movie.Artwork.BackdropUrl);

    string? backdropSrcSet = hasVerifiedBackdrop && !string.IsNullOrWhiteSpace(movie.Artwork!.BackdropW780Url)
        ? $"{movie.Artwork.BackdropW780Url} 780w, {movie.Artwork.BackdropUrl} 1280w"
        : null;

    string posterSrc = string.IsNullOrWhiteSpace(movie.PosterUrl)
        ? "/images/poster-fallback.svg"
        : movie.PosterUrl;

    string? posterSrcSet = movie.Artwork?.HasVerifiedPoster == true
        && !string.IsNullOrWhiteSpace(movie.Artwork.PosterW342Url)
        && !string.IsNullOrWhiteSpace(movie.Artwork.PosterUrl)
        ? $"{movie.Artwork.PosterW342Url} 342w, {movie.Artwork.PosterUrl} 780w"
        : null;

    bool hasDistinctOriginal = !string.IsNullOrWhiteSpace(movie.OriginalTitle)
        && !string.Equals(movie.OriginalTitle, movie.Title, StringComparison.OrdinalIgnoreCase);

    var identityParts = new List<string>();
    if (hasDistinctOriginal)
    {
        identityParts.Add(movie.OriginalTitle!);
    }
    if (movie.ReleaseYear.HasValue)
    {
        identityParts.Add(movie.ReleaseYear.Value.ToString(CultureInfo.InvariantCulture));
    }
    if (!string.IsNullOrWhiteSpace(movie.OriginCountry))
    {
        identityParts.Add(movie.OriginCountry);
    }

    var genreTokens = string.IsNullOrWhiteSpace(movie.GenreText)
        ? Array.Empty<string>()
        : movie.GenreText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var recommendedGridItems = Model.RankedRecommendations.Count > 0
        ? Model.RankedRecommendations
        : Model.SuggestedOnSaleMovies;
}

@functions {
    private static string GetAgeBadgeClass(string? ageLabel)
    {
        if (string.IsNullOrWhiteSpace(ageLabel)) return "bgp-age-badge";
        return ageLabel.Trim().ToUpperInvariant() switch
        {
            "P" => "bgp-age-badge bgp-age-badge--p",
            "K" => "bgp-age-badge bgp-age-badge--k",
            "T13" or "C13" => "bgp-age-badge bgp-age-badge--t13",
            "T16" or "C16" => "bgp-age-badge bgp-age-badge--t16",
            "T18" or "C18" => "bgp-age-badge bgp-age-badge--t18",
            _ => "bgp-age-badge bgp-age-badge--t13"
        };
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "DV";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string FormatPrimaryGenre(string? genreText)
    {
        if (string.IsNullOrWhiteSpace(genreText)) return "Điện ảnh";
        var parts = genreText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length > 0 ? parts[0] : genreText;
    }

    private static string GetRankBadgeClass(int rank) => rank switch
    {
        1 => "bgp-rank-num bgp-rank-num--gold",
        2 => "bgp-rank-num bgp-rank-num--silver",
        3 => "bgp-rank-num bgp-rank-num--bronze",
        _ => "bgp-rank-num"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-detail.css" asp-append-version="true" />
}

<div class="bgp-movie-detail">
    <!-- 1. RapPhim-Inspired Full-Bleed Atmospheric Stage Hero -->
    <section class="bgp-detail-hero" aria-label="Sân khấu giới thiệu tác phẩm @movie.Title">
        @if (hasVerifiedBackdrop)
        {
            <img src="@movie.Artwork!.BackdropUrl"
                 srcset="@backdropSrcSet"
                 sizes="100vw"
                 alt=""
                 aria-hidden="true"
                 class="bgp-detail-backdrop-img"
                 data-testid="detail-backdrop-img"
                 fetchpriority="high"
                 loading="eager"
                 decoding="async"
                 onerror="this.onerror=null;this.removeAttribute('srcset');this.style.display='none';" />
        }
        <div class="bgp-detail-backdrop-scrim" aria-hidden="true"></div>

        @if (hasTrailer)
        {
            <div class="bgp-detail-hero-top-dock">
                <button type="button"
                        class="bgp-detail-top-pill"
                        data-trailer-open="@movie.OfficialTrailerYoutubeId"
                        data-trailer-title="@movie.Title"
                        aria-label="Phát nhanh trailer chính thức phim @movie.Title"
                        title="Xem trailer chính thức">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="3" width="20" height="18" rx="2.5"></rect>
                        <line x1="7" y1="3" x2="7" y2="21"></line>
                        <line x1="17" y1="3" x2="17" y2="21"></line>
                        <polygon points="10 9 15 12 10 15 10 9" fill="currentColor" stroke="none"></polygon>
                    </svg>
                    <span>Trailer</span>
                </button>
            </div>
        }

        <div class="bgp-container bgp-detail-hero-container">
            <div class="bgp-detail-stage-content">
                <!-- Graphic Title Treatment Wordmark Logo -->
                <div class="bgp-detail-stage-logo" aria-hidden="true">
                    @await Html.PartialAsync("_MovieTitleTreatment", (Model.TitleSummary, "hero"))
                </div>

                <!-- Minimalist Icon Meta Strip -->
                <div class="bgp-detail-stage-meta">
                    @if (hasShowtimes)
                    {
                        <span class="bgp-detail-badge-live" data-testid="detail-status-badge">
                            <span class="bgp-detail-badge-live__dot" aria-hidden="true"></span>
                            Đang mở bán
                        </span>
                    }
                    else
                    {
                        <span class="bgp-detail-badge-muted" data-testid="detail-status-badge">Chưa xếp lịch</span>
                    }

                    @if (movie.ReleaseYear.HasValue)
                    {
                        <span class="bgp-detail-stage-meta__item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>@movie.ReleaseYear.Value</span>
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(movie.OriginCountry))
                    {
                        <span class="bgp-detail-stage-meta__item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                            </svg>
                            <span>@movie.OriginCountry</span>
                        </span>
                    }

                    <span class="bgp-detail-stage-meta__item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>@movie.DurationMin phút</span>
                    </span>

                    @if (movie.Rating != null)
                    {
                        <span class="bgp-detail-stage-rating" data-testid="detail-rating-badge">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#F5C518" aria-hidden="true">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span>@movie.Rating.DisplayText</span>
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(movie.AgeLabel))
                    {
                        <span class="@GetAgeBadgeClass(movie.AgeLabel)" data-testid="detail-age-label">@movie.AgeLabel</span>
                    }
                </div>

                <!-- White Primary Button + Circular Frosted Action Bar -->
                <div class="bgp-detail-actions">
                    @if (hasShowtimes)
                    {
                        <a href="#showtimes-section"
                           class="bgp-detail-cta-white"
                           data-testid="detail-cta-scroll-showtimes">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <polygon points="6 4 20 12 6 20 6 4"></polygon>
                            </svg>
                            <span>Chọn Suất Chiếu</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Movies"
                           asp-action="Index"
                           class="bgp-detail-cta-white"
                           data-testid="detail-cta-back-catalog">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m15 18-6-6 6-6"></path>
                            </svg>
                            <span>Danh mục phim</span>
                        </a>
                    }

                    @if (hasTrailer)
                    {
                        <button type="button"
                                class="bgp-detail-circle-btn"
                                data-testid="detail-trailer-btn"
                                data-trailer-open="@movie.OfficialTrailerYoutubeId"
                                data-trailer-title="@movie.Title"
                                aria-label="Xem trailer chính thức phim @movie.Title"
                                title="Xem trailer chính thức">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="2" y="4" width="20" height="16" rx="2.5"></rect>
                                <polygon points="10 8.5 16 12 10 15.5 10 8.5" fill="currentColor" stroke="none"></polygon>
                            </svg>
                        </button>
                    }

                    <button type="button"
                            class="bgp-detail-circle-btn"
                            data-detail-share-btn
                            data-testid="detail-share-btn"
                            aria-label="Chia sẻ liên kết bộ phim"
                            title="Sao chép liên kết phim">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </button>

                    <a asp-controller="Movies"
                       asp-action="Index"
                       class="bgp-detail-circle-btn"
                       aria-label="Duyệt toàn bộ danh mục phim"
                       title="Duyệt danh mục phim">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                    </a>

                    <span class="bgp-detail-share-toast" data-detail-share-feedback role="status" aria-live="polite" hidden>
                        Đã sao chép liên kết
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. RapPhim-Style White-Underline Sub-Tab Bar -->
    <div class="bgp-detail-subtabs-wrap">
        <div class="bgp-container">
            <div class="bgp-detail-subtabs"
                 role="tablist"
                 aria-label="Chuyển đổi phân vùng thông tin phim"
                 data-detail-tabbar
                 data-testid="detail-subtabs">
                <button type="button"
                        role="tab"
                        aria-selected="true"
                        class="bgp-detail-subtab is-active"
                        data-detail-tab="info"
                        data-testid="detail-tab-info">
                    Thông tin &amp; Lịch chiếu
                </button>
                <button type="button"
                        role="tab"
                        aria-selected="false"
                        class="bgp-detail-subtab"
                        data-detail-tab="cast"
                        data-testid="detail-tab-cast">
                    Diễn viên &amp; Đoàn phim
                </button>
                <button type="button"
                        role="tab"
                        aria-selected="false"
                        class="bgp-detail-subtab"
                        data-detail-tab="trailer"
                        data-testid="detail-tab-trailer">
                    Trailer
                </button>
                <button type="button"
                        role="tab"
                        aria-selected="false"
                        class="bgp-detail-subtab"
                        data-detail-tab="recommended"
                        data-testid="detail-tab-recommended">
                    Đề xuất
                </button>
            </div>
        </div>
    </div>

    <!-- 3. 3-Column Asymmetric Workspace: Left Poster Dossier + Center Interactive Stack + Right Ranked Top 1->8 -->
    <div class="bgp-container bgp-detail-workspace" data-testid="detail-workspace">
        <!-- 3.1 Left Column: Unified 2:3 Poster + Synopsis + Metadata Dossier Card -->
        <aside class="bgp-detail-dossier-card" data-testid="detail-poster-dossier" aria-label="Tóm tắt và thông số phim">
            <div class="bgp-detail-poster-frame">
                <img src="@posterSrc"
                     srcset="@posterSrcSet"
                     sizes="(max-width: 839px) 210px, 260px"
                     alt="Poster phim @movie.Title"
                     class="bgp-detail-poster-img"
                     loading="eager"
                     decoding="async"
                     data-testid="detail-poster-img"
                     onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.removeAttribute('srcset');this.src='/images/poster-fallback.svg';}" />

                @if (hasShowtimes)
                {
                    <span class="bgp-detail-poster-pill bgp-detail-poster-pill--live">MỞ BÁN</span>
                }
            </div>

            <div class="bgp-detail-dossier-body">
                <h1 id="movie-detail-title" class="bgp-detail-title">@movie.Title</h1>

                @if (identityParts.Count > 0)
                {
                    <p class="bgp-detail-identity" data-testid="detail-identity">
                        @string.Join(" · ", identityParts)
                    </p>
                }

                <p class="bgp-detail-synopsis" data-testid="detail-synopsis">
                    @if (!string.IsNullOrWhiteSpace(movie.Synopsis))
                    {
                        @movie.Synopsis
                    }
                    else
                    {
                        @:Nội dung tóm tắt của bộ phim đang được cập nhật.
                    }
                </p>

                <dl class="bgp-detail-specs">
                    @if (!string.IsNullOrWhiteSpace(movie.OriginCountry))
                    {
                        <div class="bgp-detail-specs__row">
                            <dt>Quốc gia:</dt>
                            <dd>@movie.OriginCountry</dd>
                        </div>
                    }

                    @if (genreTokens.Length > 0)
                    {
                        <div class="bgp-detail-specs__row">
                            <dt>Thể loại:</dt>
                            <dd data-testid="detail-genre">
                                @for (int gIdx = 0; gIdx < genreTokens.Length; gIdx++)
                                {
                                    <a asp-controller="Movies" asp-action="Index" asp-route-genre="@genreTokens[gIdx]" class="bgp-detail-spec-link">@genreTokens[gIdx]</a>@(gIdx < genreTokens.Length - 1 ? ", " : "")
                                }
                            </dd>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(movie.DirectorNames))
                    {
                        <div class="bgp-detail-specs__row" data-testid="detail-director">
                            <dt>Đạo diễn:</dt>
                            <dd>
                                <a asp-controller="Movies"
                                   asp-action="Index"
                                   asp-route-q="@movie.DirectorNames"
                                   class="bgp-detail-spec-link">@movie.DirectorNames</a>
                            </dd>
                        </div>
                    }

                    <div class="bgp-detail-specs__row">
                        <dt>Thời lượng:</dt>
                        <dd data-testid="detail-duration">@movie.DurationMin phút</dd>
                    </div>

                    <div class="bgp-detail-specs__row">
                        <dt>Trạng thái:</dt>
                        <dd>
                            @if (hasShowtimes)
                            {
                                <span class="bgp-detail-spec-live" data-testid="detail-showtime-count">@movie.UpcomingShowtimes.Count suất chiếu sắp tới</span>
                            }
                            else
                            {
                                <span class="bgp-detail-spec-muted" data-testid="detail-showtime-count">Chưa có suất chiếu</span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>
        </aside>

        <!-- 3.2 Center Column: Modular Dark Cards (#13131A) Controlled by Sub-Tabs -->
        <div class="bgp-detail-center-col" data-detail-center data-active-tab="info" data-testid="detail-center-col">
            <!-- Card A: Showtimes Workspace (Date Selector Box + Slot Grid Box) -->
            <section id="showtimes-section"
                     class="bgp-showtimes-section"
                     data-detail-card="showtimes"
                     aria-labelledby="showtimes-heading">
                @if (!hasShowtimes)
                {
                    <div class="bgp-detail-panel-box">
                        <div class="bgp-detail-panel-box__head">
                            <h2 id="showtimes-heading" class="bgp-detail-panel-box__title">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <span>Lịch Chiếu Tại Beta Giải Phóng</span>
                            </h2>
                        </div>

                        <div class="bgp-discovery-empty" data-testid="detail-no-showtimes">
                            <div class="bgp-discovery-empty-icon">
                                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                            <h3 class="bgp-showtimes-empty-title">Hiện chưa có suất chiếu sắp tới</h3>
                            <p class="bgp-showtimes-sub">
                                Bộ phim này hiện chưa mở lịch chiếu trong thời gian tới. Mời bạn tham khảo các tác phẩm đang mở bán vé tại rạp bên dưới.
                            </p>
                            <a asp-controller="Movies"
                               asp-action="Index"
                               asp-route-filter="has-showtimes"
                               class="bgp-btn bgp-btn--primary bgp-btn--sm"
                               data-testid="detail-no-showtimes-browse-btn">
                                Xem các phim có lịch chiếu
                            </a>
                        </div>

                        @if (Model.SuggestedOnSaleMovies.Count > 0)
                        {
                            <div class="bgp-suggested-block" data-testid="detail-suggested-movies">
                                <h3 class="bgp-suggested-title">Các phim đang mở bán vé tại rạp</h3>
                                <div class="bgp-suggested-grid">
                                    @foreach (var sug in Model.SuggestedOnSaleMovies.Take(4))
                                    {
                                        string sugPoster = string.IsNullOrWhiteSpace(sug.PosterUrl)
                                            ? "/images/poster-fallback.svg"
                                            : sug.PosterUrl;

                                        <a class="bgp-suggested-card"
                                           asp-controller="Movies"
                                           asp-action="Details"
                                           asp-route-id="@sug.MovieId">
                                            <div class="bgp-suggested-card__poster-wrap">
                                                <img src="@sugPoster"
                                                     alt="Poster phim @sug.Title"
                                                     class="bgp-suggested-card__poster"
                                                     loading="lazy"
                                                     onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.src='/images/poster-fallback.svg';}" />
                                            </div>
                                            <div class="bgp-suggested-card__info">
                                                <div class="bgp-suggested-card__title">@sug.Title</div>
                                                <div class="bgp-suggested-card__sub">@sug.UpcomingShowtimesCount suất sắp tới</div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Box 1: Chọn Ngày Chiếu (RapPhim Glass-Pill Server Box Style) -->
                    <div class="bgp-detail-panel-box">
                        <div class="bgp-detail-panel-box__head">
                            <h2 id="showtimes-heading" class="bgp-detail-panel-box__title">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <span>Chọn Ngày Chiếu</span>
                            </h2>
                        </div>

                        <div class="bgp-date-tabs" role="tablist" aria-label="Chọn ngày chiếu">
                            @foreach (var group in Model.DateGroups)
                            {
                                var isSelected = string.Equals(group.DateKey, Model.SelectedDateKey, StringComparison.OrdinalIgnoreCase);
                                <a href="@Url.Action("Details", "Movies", new { id = movie.MovieId, date = group.DateKey })#showtimes-section"
                                   role="tab"
                                   id="tab-date-@group.DateKey"
                                   aria-selected="@(isSelected ? "true" : "false")"
                                   aria-controls="panel-date-@group.DateKey"
                                   data-date-key="@group.DateKey"
                                   data-testid="showtime-date-tab"
                                   class="bgp-date-tab @(isSelected ? "is-active" : "")">
                                    <span class="bgp-date-tab-dow">@group.DayOfWeekLabel</span>
                                    <span class="bgp-date-tab-date">@group.DateDisplayText</span>
                                    <span class="bgp-date-tab-count">@group.Showtimes.Count suất</span>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Box 2: Danh Sách Suất Chiếu Theo Ngày (RapPhim Episode Box Style) -->
                    <div class="bgp-detail-panel-box">
                        @foreach (var group in Model.DateGroups)
                        {
                            var isSelected = string.Equals(group.DateKey, Model.SelectedDateKey, StringComparison.OrdinalIgnoreCase);
                            <div id="panel-date-@group.DateKey"
                                 role="tabpanel"
                                 aria-labelledby="tab-date-@group.DateKey"
                                 data-date-panel="@group.DateKey"
                                 data-testid="showtime-date-panel"
                                 class="bgp-showtime-date-group @(isSelected ? "is-active" : "")">
                                <div class="bgp-detail-panel-box__head">
                                    <h3 class="bgp-detail-panel-box__title">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <polygon points="6 4 20 12 6 20 6 4"></polygon>
                                        </svg>
                                        <span>Suất chiếu: @group.DayOfWeekLabel, @group.DateDisplayText</span>
                                    </h3>
                                    <span class="bgp-detail-slot-pill">@group.Showtimes.Count suất</span>
                                </div>

                                <div class="bgp-showtime-grid">
                                    @foreach (var item in group.Showtimes)
                                    {
                                        var st = item.Showtime;
                                        string seatStatusClass = item.IsSoldOut
                                            ? "bgp-showtime-seats--soldout"
                                            : (item.IsLowAvailability ? "bgp-showtime-seats--low" : "bgp-showtime-seats--available");

                                        <div class="bgp-showtime-card @(item.IsSoldOut ? "bgp-showtime-card--soldout" : "")"
                                             data-testid="showtime-card"
                                             data-showtime-id="@st.ShowtimeId"
                                             data-sold-out="@(item.IsSoldOut ? "true" : "false")">
                                            <div class="bgp-showtime-top">
                                                <div class="bgp-showtime-time-block">
                                                    <span class="bgp-showtime-start" data-testid="showtime-start">@item.StartTimeText</span>
                                                    <span class="bgp-showtime-end" data-testid="showtime-end">~ @item.EndTimeText</span>
                                                    @if (item.CrossesMidnight)
                                                    {
                                                        <span class="bgp-showtime-nextday"
                                                              title="Kết thúc sang ngày hôm sau (@item.EndDateShortText)"
                                                              data-testid="showtime-crosses-midnight">
                                                            +1 ngày (@item.EndDateShortText)
                                                        </span>
                                                    }
                                                </div>
                                                <span class="bgp-showtime-room" data-testid="showtime-room">@st.RoomName</span>
                                            </div>

                                            <div class="bgp-showtime-meta-row">
                                                @if (!item.IsSoldOut)
                                                {
                                                    <span class="bgp-showtime-seats @seatStatusClass" data-testid="showtime-seats">
                                                        Còn @st.AvailableSeatsCount / @st.SellableCapacity ghế trống@(item.IsLowAvailability ? " • Sắp hết" : "")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="bgp-showtime-seats bgp-showtime-seats--soldout" data-testid="showtime-seats">
                                                        Hết ghế trống (0 / @st.SellableCapacity)
                                                    </span>
                                                }
                                            </div>

                                            @if (!item.IsSoldOut)
                                            {
                                                <a class="bgp-showtime-cta bgp-showtime-cta--book"
                                                   data-testid="showtime-cta"
                                                   asp-controller="Showtimes"
                                                   asp-action="Seats"
                                                   asp-route-id="@st.ShowtimeId">
                                                    Chọn ghế &rarr;
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="bgp-showtime-cta bgp-showtime-cta--view"
                                                   data-testid="showtime-cta"
                                                   asp-controller="Showtimes"
                                                   asp-action="Seats"
                                                   asp-route-id="@st.ShowtimeId">
                                                    Xem sơ đồ ghế
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Card B: Cast & Crew Showcase Card -->
            @if (!string.IsNullOrWhiteSpace(movie.DirectorNames) || (movie.Cast != null && movie.Cast.Count > 0))
            {
                <section class="bgp-detail-panel-box"
                         data-detail-card="cast"
                         aria-label="Diễn viên và đoàn phim">
                    <div class="bgp-detail-panel-box__head">
                        <h2 class="bgp-detail-panel-box__title">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>Diễn viên &amp; Đoàn phim</span>
                        </h2>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(movie.DirectorNames))
                    {
                        <div class="bgp-cast-group">
                            <div class="bgp-cast-group__label">ĐẠO DIỄN</div>
                            <div class="bgp-director-pill">
                                <span class="bgp-cast-avatar bgp-cast-avatar--director" aria-hidden="true">@GetInitials(movie.DirectorNames)</span>
                                <span class="bgp-director-pill__name">@movie.DirectorNames</span>
                            </div>
                        </div>
                    }

                    @if (movie.Cast != null && movie.Cast.Count > 0)
                    {
                        <div class="bgp-cast-group">
                            <div class="bgp-cast-group__label">DIỄN VIÊN THAM GIA</div>
                            <div class="bgp-cast-grid" data-testid="detail-cast-grid">
                                @foreach (var member in movie.Cast.Take(8))
                                {
                                    <div class="bgp-cast-chip" data-testid="detail-cast-chip">
                                        <span class="bgp-cast-avatar" aria-hidden="true">@GetInitials(member.Name)</span>
                                        <div class="bgp-cast-chip__text">
                                            <div class="bgp-cast-chip__name">@member.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(member.Character))
                                            {
                                                <div class="bgp-cast-chip__role">@member.Character</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>
            }

            <!-- Card C: Inline Official Trailer Stage (Shown in "Trailer" Tab) -->
            <section class="bgp-detail-panel-box is-tab-hidden"
                     data-detail-card="trailer-inline"
                     data-testid="detail-trailer-tab-panel"
                     aria-label="Trailer chính thức"
                     hidden>
                <div class="bgp-detail-panel-box__head">
                    <h2 class="bgp-detail-panel-box__title">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="4" width="20" height="16" rx="2.5"></rect>
                            <polygon points="10 8.5 16 12 10 15.5 10 8.5" fill="currentColor" stroke="none"></polygon>
                        </svg>
                        <span>Trailer Chính Thức</span>
                    </h2>
                </div>

                @if (hasTrailer)
                {
                    <div class="bgp-detail-inline-trailer">
                        <button type="button"
                                class="bgp-detail-inline-trailer__trigger"
                                data-inline-trailer-play
                                data-youtube-id="@movie.OfficialTrailerYoutubeId"
                                data-movie-title="@movie.Title"
                                aria-label="Phát trailer chính thức @movie.Title">
                            @if (hasVerifiedBackdrop)
                            {
                                <img src="@(movie.Artwork!.BackdropW780Url ?? movie.Artwork.BackdropUrl)"
                                     alt=""
                                     class="bgp-detail-inline-trailer__thumb"
                                     loading="lazy" />
                            }
                            <span class="bgp-detail-inline-trailer__play" aria-hidden="true">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                    <polygon points="7 4 20 12 7 20 7 4"></polygon>
                                </svg>
                            </span>
                            <span class="bgp-detail-inline-trailer__caption">Nhấn để phát Trailer chính thức (YouTube Privacy-Enhanced)</span>
                        </button>
                        <div class="bgp-detail-inline-trailer__mount" data-inline-trailer-mount></div>
                    </div>
                }
                else
                {
                    <div class="bgp-discovery-empty">
                        <h3 class="bgp-showtimes-empty-title">Chưa cập nhật video trailer chính thức</h3>
                        <p class="bgp-showtimes-sub">
                            Bộ phim hiện chưa đính kèm video giới thiệu chính thức trên hệ thống rạp.
                        </p>
                    </div>
                }
            </section>

            <!-- Card E: Recommended 2:3 Poster Grid (Shown in "Đề xuất" Tab) -->
            <section class="bgp-detail-panel-box is-tab-hidden"
                     data-detail-card="recommended-grid"
                     data-testid="detail-recommended-tab-panel"
                     aria-label="Danh sách phim đề xuất"
                     hidden>
                <div class="bgp-detail-panel-box__head">
                    <h2 class="bgp-detail-panel-box__title">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="#F5C518" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>Phim Đề Xuất Tại Rạp</span>
                    </h2>
                </div>

                <div class="bgp-detail-rec-grid">
                    @foreach (var rec in recommendedGridItems.Take(8))
                    {
                        string recPoster = string.IsNullOrWhiteSpace(rec.PosterUrl)
                            ? "/images/poster-fallback.svg"
                            : rec.PosterUrl;
                        string recOrig = !string.IsNullOrWhiteSpace(rec.OriginalTitle)
                            && !string.Equals(rec.OriginalTitle, rec.Title, StringComparison.OrdinalIgnoreCase)
                            ? rec.OriginalTitle
                            : "Phim điện ảnh";

                        <a class="bgp-detail-rec-card"
                           asp-controller="Movies"
                           asp-action="Details"
                           asp-route-id="@rec.MovieId">
                            <div class="bgp-detail-rec-card__poster-wrap">
                                <img src="@recPoster"
                                     alt="Poster phim @rec.Title"
                                     class="bgp-detail-rec-card__poster"
                                     loading="lazy"
                                     onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.src='/images/poster-fallback.svg';}" />
                                <span class="bgp-detail-rec-card__duration">@rec.DurationMin phút</span>
                            </div>
                            <div class="bgp-detail-rec-card__footer">
                                <h3 class="bgp-detail-rec-card__title">@rec.Title</h3>
                                <div class="bgp-detail-rec-card__orig">@recOrig</div>
                                <div class="bgp-detail-rec-card__meta">
                                    <span>
                                        @(rec.ReleaseYear?.ToString(CultureInfo.InvariantCulture) ?? "Rạp")
                                        @if (rec.Rating != null)
                                        {
                                            <span class="bgp-detail-rec-card__score">★ @rec.Rating.Score.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                        }
                                    </span>
                                    <span>@FormatPrimaryGenre(rec.GenreText)</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        </div>

        <!-- 3.3 Right Column: RapPhim-Inspired Ranked "Phim đề xuất" Sidebar (1 -> 8) -->
        @if (Model.RankedRecommendations.Count > 0)
        {
            <aside class="bgp-detail-ranked-sidebar"
                   data-testid="detail-ranked-sidebar"
                   aria-label="Bảng xếp hạng phim đề xuất">
                <div class="bgp-detail-ranked-sidebar__head">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
                        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"></path>
                    </svg>
                    <h2 class="bgp-detail-ranked-sidebar__title">Phim đề xuất</h2>
                </div>

                <ol class="bgp-detail-ranked-list">
                    @for (int rIdx = 0; rIdx < Model.RankedRecommendations.Count; rIdx++)
                    {
                        var item = Model.RankedRecommendations[rIdx];
                        int rank = rIdx + 1;
                        string rankPoster = string.IsNullOrWhiteSpace(item.PosterUrl)
                            ? "/images/poster-fallback.svg"
                            : item.PosterUrl;

                        <li class="bgp-detail-ranked-item" data-testid="detail-ranked-item">
                            <a class="bgp-detail-ranked-link"
                               asp-controller="Movies"
                               asp-action="Details"
                               asp-route-id="@item.MovieId">
                                <span class="@GetRankBadgeClass(rank)" aria-hidden="true">@rank</span>
                                <img src="@rankPoster"
                                     alt="Poster phim @item.Title"
                                     class="bgp-detail-ranked-thumb"
                                     loading="lazy"
                                     onerror="this.onerror=null;if(!this.src.endsWith('/images/poster-fallback.svg')){this.src='/images/poster-fallback.svg';}" />
                                <div class="bgp-detail-ranked-info">
                                    <h3 class="bgp-detail-ranked-name">@item.Title</h3>
                                    <div class="bgp-detail-ranked-meta">
                                        <span>@(item.ReleaseYear?.ToString(CultureInfo.InvariantCulture) ?? "Rạp")</span>
                                        @if (item.Rating != null)
                                        {
                                            <span class="bgp-detail-ranked-score">★ @item.Rating.Score.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                        }
                                        else if (item.UpcomingShowtimesCount > 0)
                                        {
                                            <span class="bgp-detail-ranked-slots">@item.UpcomingShowtimesCount suất</span>
                                        }
                                    </div>
                                </div>
                            </a>
                        </li>
                    }
                </ol>

                <a asp-controller="Movies"
                   asp-action="Index"
                   class="bgp-detail-ranked-more">
                    Xem tất cả &rarr;
                </a>
            </aside>
        }
    </div>
</div>

<!-- Click-to-Load Official YouTube Trailer Modal (<dialog>) -->
<dialog id="bgp-trailer-dialog"
        class="bgp-trailer-dialog"
        data-testid="trailer-dialog"
        aria-labelledby="bgp-trailer-dialog-title">
    <div class="bgp-trailer-dialog__header">
        <div class="bgp-trailer-dialog__title-group">
            <div class="bgp-trailer-dialog__eyebrow">Official Trailer</div>
            <h2 id="bgp-trailer-dialog-title" class="bgp-trailer-dialog__title" data-trailer-dialog-title>
                Trailer chính thức — @movie.Title
            </h2>
        </div>
        <button type="button"
                class="bgp-icon-btn"
                data-trailer-close
                data-testid="trailer-dialog-close"
                aria-label="Đóng cửa sổ trailer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
    <div class="bgp-trailer-dialog__stage" data-trailer-stage></div>
    <div class="bgp-trailer-dialog__footer">
        <a href="https://www.youtube.com"
           target="_blank"
           rel="noopener noreferrer"
           class="bgp-cinema-footer__link"
           data-trailer-external-link>
            Mở trên YouTube &nearr;
        </a>
    </div>
</dialog>

@section Scripts {
    <script type="module" src="~/js/modules/detail-tabs.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/showtime-picker.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/trailer-dialog.js" asp-append-version="true"></script>
}
