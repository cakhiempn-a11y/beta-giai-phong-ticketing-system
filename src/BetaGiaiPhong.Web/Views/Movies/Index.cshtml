@model IReadOnlyList<BetaGiaiPhong.Web.Models.Responses.MovieSummaryDto>
@{
    ViewData["Title"] = "Danh sách phim đang chiếu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">Danh Sách Phim Đang Chiếu</h1>
            <p class="text-muted mb-0">Các tác phẩm điện ảnh hiện có lịch chiếu tại rạp Beta Giải Phóng</p>
        </div>
        <span class="badge bg-primary px-3 py-2 fs-6">@Model.Count phim</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <h5>Hiện tại không có phim nào đang chiếu.</h5>
            <p class="text-muted mb-0">Vui lòng quay lại sau hoặc liên hệ ban quản lý rạp.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm movie-card">
                        <div class="movie-poster-placeholder">
                            <span class="badge bg-warning text-dark mb-2">@movie.GenreText</span>
                            <h5 class="card-title fw-bold text-white px-2 mb-0">@movie.Title</h5>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between text-muted small mb-2">
                                <span>Thời lượng:</span>
                                <strong class="text-dark">@movie.DurationMin phút</strong>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-3">
                                <span>Trạng thái:</span>
                                <span class="badge bg-success">Đang công chiếu</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-3">
                                <span>Suất chiếu sắp tới:</span>
                                <span class="badge bg-info text-dark">@movie.UpcomingShowtimesCount suất</span>
                            </div>
                            <a class="btn btn-primary mt-auto w-100" asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId">
                                Chi tiết & Lịch chiếu
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
