@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool isOperationsArea = controllerName.Equals("StaffCheckIn", StringComparison.OrdinalIgnoreCase)
                            || controllerName.Equals("Management", StringComparison.OrdinalIgnoreCase);

    Layout = isOperationsArea ? "_OperationsLayout" : "_CinemaLayout";
}
