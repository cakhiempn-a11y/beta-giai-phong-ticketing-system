@model BetaGiaiPhong.Web.Models.ViewModels.SeatMapViewModel
@{
    ViewData["Title"] = $"Chọn ghế — {Model.SeatMap.MovieTitle}";
    ViewData["HeaderOverlay"] = false;

    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isCustomer = User.IsInRole("CUSTOMER");
    bool isManagerOrAdmin = User.IsInRole("MANAGER") || User.IsInRole("ADMIN");
    bool isOperationalOnly = isAuthenticated && !isCustomer;
    string authMode = isOperationalOnly ? "operational" : (isCustomer ? "customer" : "guest");

    string opsConsoleController = isManagerOrAdmin ? "Management" : "StaffCheckIn";
    string opsConsoleAction = isManagerOrAdmin ? "Reports" : "Index";

    var sm = Model.SeatMap;
    var artwork = sm.MovieArtwork;
    bool isPendingTmdbNoPoster = artwork is not null
        && string.Equals(artwork.Source, "PENDING_TMDB_API_KEY", StringComparison.OrdinalIgnoreCase)
        && string.IsNullOrWhiteSpace(artwork.PosterUrl);

    string posterSrc = !string.IsNullOrWhiteSpace(artwork?.PosterW342Url)
        ? artwork.PosterW342Url!
        : (!string.IsNullOrWhiteSpace(artwork?.PosterUrl) ? artwork.PosterUrl! : "/images/poster-fallback.svg");

    string? posterSrcSet = (artwork?.HasVerifiedPoster == true
                            && !string.IsNullOrWhiteSpace(artwork.PosterW342Url)
                            && !string.IsNullOrWhiteSpace(artwork.PosterUrl))
        ? $"{artwork.PosterW342Url} 342w, {artwork.PosterUrl} 780w"
        : null;

    string? ageLabel = sm.MovieAgeLabel?.Trim().ToUpperInvariant();
    string ageBadgeModifier = ageLabel switch
    {
        "P" => "bgp-age-badge--p",
        "K" => "bgp-age-badge--k",
        "T13" => "bgp-age-badge--t13",
        "T16" => "bgp-age-badge--t16",
        "T18" => "bgp-age-badge--t18",
        _ => "bgp-age-badge--t13"
    };

    short maxCol = Model.MaxColumnNo;
    bool hasWingAisles = maxCol >= 8;
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-seat-map.css" asp-append-version="true" />
}

<div class="bgp-container bgp-seat-page"
     data-seat-page
     data-showtime-id="@sm.ShowtimeId"
     data-is-open="@(sm.IsOpenForBooking ? "true" : "false")"
     data-operational-locked="@(isOperationalOnly ? "true" : "false")"
     data-auth-mode="@authMode">

    <!-- Breadcrumb & 4-Step Booking Stepper -->
    <div class="bgp-seat-topbar">
        <nav aria-label="Đường dẫn trang">
            <ol class="bgp-seat-breadcrumb">
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="bgp-seat-breadcrumb__sep" aria-hidden="true">/</li>
                <li><a asp-controller="Movies" asp-action="Index">Danh mục phim</a></li>
                <li class="bgp-seat-breadcrumb__sep" aria-hidden="true">/</li>
                <li><a asp-controller="Movies" asp-action="Details" asp-route-id="@sm.MovieId">@sm.MovieTitle</a></li>
                <li class="bgp-seat-breadcrumb__sep" aria-hidden="true">/</li>
                <li class="bgp-seat-breadcrumb__current" aria-current="page">Chọn ghế ngồi</li>
            </ol>
        </nav>

        <nav aria-label="Tiến trình đặt vé">
            <ol class="bgp-stepper" data-testid="booking-stepper">
                <li class="bgp-stepper__item">
                    <a class="bgp-stepper__pill bgp-stepper__pill--done"
                       href="/movies/@sm.MovieId#showtimes-section">
                        <span aria-hidden="true">✓</span>
                        <span>1. Chọn suất chiếu</span>
                    </a>
                    <span class="bgp-stepper__arrow" aria-hidden="true">&rarr;</span>
                </li>
                <li class="bgp-stepper__item">
                    <span class="bgp-stepper__pill bgp-stepper__pill--active" aria-current="step">
                        <span>2. Chọn ghế ngồi (Tối đa 8)</span>
                    </span>
                    <span class="bgp-stepper__arrow" aria-hidden="true">&rarr;</span>
                </li>
                <li class="bgp-stepper__item">
                    <span class="bgp-stepper__pill">
                        <span>3. Giữ chỗ &amp; Thanh toán</span>
                    </span>
                    <span class="bgp-stepper__arrow" aria-hidden="true">&rarr;</span>
                </li>
                <li class="bgp-stepper__item">
                    <span class="bgp-stepper__pill">
                        <span>4. Nhận vé QR</span>
                    </span>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Contextual Flash & Live Status Banners -->
    <div class="bgp-seat-alerts">
        @if (TempData["Error"] != null)
        {
            <div class="bgp-seat-alert bgp-seat-alert--danger alert-danger"
                 role="alert"
                 data-testid="seat-flash-error">
                <div class="bgp-seat-alert__content">
                    <span class="bgp-seat-alert__icon" aria-hidden="true">⚠️</span>
                    <div class="bgp-seat-alert__body">
                        <span class="bgp-seat-alert__title">Không thể giữ ghế</span>
                        <span>@TempData["Error"]</span>
                    </div>
                </div>
                <button type="button" class="bgp-seat-alert__close" data-dismiss-alert aria-label="Đóng thông báo lỗi">&times;</button>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="bgp-seat-alert bgp-seat-alert--success alert-success"
                 role="status"
                 data-testid="seat-flash-success">
                <div class="bgp-seat-alert__content">
                    <span class="bgp-seat-alert__icon" aria-hidden="true">✓</span>
                    <div class="bgp-seat-alert__body">
                        <span class="bgp-seat-alert__title">Thao tác thành công</span>
                        <span>@TempData["Success"]</span>
                    </div>
                </div>
                <button type="button" class="bgp-seat-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
            </div>
        }

        @if (!sm.IsOpenForBooking)
        {
            <div class="bgp-seat-alert bgp-seat-alert--warning"
                 role="status"
                 data-testid="seat-closed-banner">
                <div class="bgp-seat-alert__content">
                    <span class="bgp-seat-alert__icon" aria-hidden="true">⛔</span>
                    <div class="bgp-seat-alert__body">
                        <span class="bgp-seat-alert__title">Suất chiếu đã đóng đặt vé trực tuyến</span>
                        <span>@(sm.IneligibleReason ?? "Suất chiếu hiện không mở bán vé trực tuyến hoặc đã bắt đầu chiếu.") Bạn vẫn có thể xem trạng thái ghế thực tế bên dưới.</span>
                    </div>
                </div>
            </div>
        }

        @if (isOperationalOnly)
        {
            <div class="bgp-seat-alert bgp-seat-alert--info"
                 role="status"
                 data-testid="seat-operational-lock-notice">
                <div class="bgp-seat-alert__content">
                    <span class="bgp-seat-alert__icon" aria-hidden="true">🛡️</span>
                    <div class="bgp-seat-alert__body">
                        <span class="bgp-seat-alert__title">Chế độ tra cứu dành cho Tài khoản Vận hành</span>
                        <span>
                            Tài khoản nội bộ (<strong>STAFF / MANAGER / ADMIN</strong>) không thực hiện giao dịch đặt giữ ghế khách hàng.
                            Để kiểm tra vé hoặc điều hành suất chiếu, vui lòng chuyển sang
                            <a asp-controller="@opsConsoleController" asp-action="@opsConsoleAction" style="color:#FFFFFF;font-weight:700;text-decoration:underline;">Console Vận hành</a>.
                        </span>
                    </div>
                </div>
            </div>
        }

        <!-- Restored Pre-Login Draft Seats Banner -->
        <div class="bgp-seat-alert bgp-seat-alert--info"
             role="status"
             aria-live="polite"
             data-testid="seat-draft-restored-banner"
             hidden>
            <div class="bgp-seat-alert__content">
                <span class="bgp-seat-alert__icon" aria-hidden="true">✓</span>
                <div class="bgp-seat-alert__body">
                    <span class="bgp-seat-alert__title">Đã khôi phục ghế bạn chọn trước khi đăng nhập</span>
                    <span>Kiểm tra lại danh sách ghế bên dưới và bấm <strong>Giữ ghế &amp; Tiếp tục thanh toán</strong> để khóa chỗ.</span>
                </div>
            </div>
            <button type="button" class="bgp-seat-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>

        <!-- Inline Max-8 Seat Limit Live Banner (Replaces window.alert) -->
        <div class="bgp-seat-alert bgp-seat-alert--warning"
             role="status"
             aria-live="polite"
             data-testid="seat-limit-banner"
             hidden>
            <div class="bgp-seat-alert__content">
                <span class="bgp-seat-alert__icon" aria-hidden="true">⚠️</span>
                <div class="bgp-seat-alert__body">
                    <span class="bgp-seat-alert__title">Giới hạn tối đa 8 ghế mỗi đơn hàng</span>
                    <span data-seat-limit-text>
                        Quý khách chỉ có thể giữ tối đa 8 ghế trong một đơn đặt vé. Vui lòng bỏ chọn một ghế đang giữ nếu muốn đổi sang vị trí khác.
                    </span>
                </div>
            </div>
            <button type="button" class="bgp-seat-alert__close" data-dismiss-alert aria-label="Đóng cảnh báo giới hạn ghế">&times;</button>
        </div>
    </div>

    <!-- Main Two-Column Cinema Auditorium & Sticky Summary -->
    <div class="bgp-booking-grid">
        <!-- Left Column: Multi-Cue Auditorium Stage -->
        <section class="bgp-auditorium-card" aria-labelledby="auditorium-heading">
            <div class="bgp-auditorium-head">
                <div class="bgp-auditorium-head__info">
                    <div class="bgp-auditorium-eyebrow">
                        <span class="bgp-room-pill" data-testid="seat-room-badge">@sm.RoomName</span>
                        <span class="bgp-badge bgp-badge--neutral">@sm.TotalCapacity ghế</span>
                    </div>
                    <h1 id="auditorium-heading" class="bgp-auditorium-title">@sm.MovieTitle</h1>
                    <p class="bgp-auditorium-sub">
                        Suất chiếu <strong>@sm.StartVietnamText</strong>
                    </p>
                </div>

                <div class="bgp-auditorium-stats-wrap">
                    <div class="bgp-auditorium-stats" aria-label="Thống kê trạng thái ghế">
                        <span class="bgp-stat-chip bgp-stat-chip--available">
                            <strong id="statAvailable">@sm.AvailableCount</strong>
                            <span>Ghế trống</span>
                        </span>
                        <span class="bgp-stat-chip bgp-stat-chip--held">
                            <strong id="statHeld">@sm.HeldCount</strong>
                            <span>Đang giữ</span>
                        </span>
                        <span class="bgp-stat-chip bgp-stat-chip--sold">
                            <strong id="statSold">@sm.SoldCount</strong>
                            <span>Đã bán</span>
                        </span>
                    </div>

                    <div class="bgp-auditorium-controls">
                        <span class="bgp-scroll-hint">Vuốt ngang sơ đồ hoặc thu nhỏ:</span>
                        <button type="button"
                                class="bgp-zoom-btn"
                                aria-pressed="false"
                                data-testid="seat-zoom-toggle">
                            <span aria-hidden="true">⤢</span>
                            <span data-zoom-label>Thu nhỏ vừa màn hình</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Perspective Cinema Screen -->
            <div class="cinema-screen" aria-hidden="true">
                <div class="cinema-screen__arc"></div>
                <div class="cinema-screen__glow"></div>
                <span class="cinema-screen-label">MÀN HÌNH CHIẾU CHÍNH</span>
            </div>

            <!-- Scroll-Shadow Local Auditorium Viewport -->
            <div class="bgp-auditorium-viewport-wrap" data-auditorium-viewport-wrap>
                <div class="bgp-auditorium-viewport" data-auditorium-viewport>
                    <div class="seat-grid-container"
                         role="group"
                         aria-label="Ma trận ghế ngồi @sm.RoomName cho phim @sm.MovieTitle">
                        @foreach (var row in Model.DistinctRows)
                        {
                            var seatsInRow = sm.Seats
                                .Where(s => s.RowLabel == row)
                                .OrderBy(s => s.ColumnNo)
                                .ToList();

                            <div class="bgp-seat-row seat-row" role="group" aria-label="Hàng ghế @row">
                                <span class="bgp-seat-row__label seat-row-label" aria-hidden="true">@row</span>

                                @foreach (var seat in seatsInRow)
                                {
                                    bool isBookable = seat.IsBookable;
                                    bool isVip = string.Equals(seat.SeatTypeCode, "VIP", StringComparison.OrdinalIgnoreCase);

                                    string legacyAndVisualClasses = seat.DisplayState switch
                                    {
                                        "AVAILABLE" when isVip => "bgp-seat--vip seat-available-vip seat-bookable",
                                        "AVAILABLE" => "bgp-seat--standard seat-available-standard seat-bookable",
                                        "HELD" => "bgp-seat--held seat-held",
                                        "SOLD" => "bgp-seat--sold seat-sold",
                                        _ => "bgp-seat--blocked seat-blocked"
                                    };

                                    string cueGlyph = seat.DisplayState switch
                                    {
                                        "AVAILABLE" when isVip => "★",
                                        "AVAILABLE" => "•",
                                        "HELD" => "⏳",
                                        "SOLD" => "✕",
                                        _ => "⊘"
                                    };

                                    string stateLabelVn = seat.DisplayState switch
                                    {
                                        "AVAILABLE" when isBookable => "còn trống",
                                        "AVAILABLE" => "suất chiếu đóng đặt vé",
                                        "HELD" => "đang tạm giữ bởi khách khác",
                                        "SOLD" => "đã bán, không thể đặt",
                                        _ => "khóa kỹ thuật, không thể đặt"
                                    };

                                    string ariaLabelText = $"Ghế {seat.SeatCode}, {seat.SeatTypeName}, {seat.PriceVnd:N0} đ, {stateLabelVn}";

                                    <button type="button"
                                            class="bgp-seat seat-box @legacyAndVisualClasses"
                                            id="seat-@seat.SeatId"
                                            data-seat-id="@seat.SeatId"
                                            data-seat-code="@seat.SeatCode"
                                            data-seat-type="@seat.SeatTypeName"
                                            data-seat-type-code="@seat.SeatTypeCode"
                                            data-display-state="@seat.DisplayState"
                                            data-row="@seat.RowLabel"
                                            data-col="@seat.ColumnNo"
                                            data-price="@seat.PriceVnd"
                                            data-bookable="@(isBookable ? "true" : "false")"
                                            aria-pressed="@(isBookable && !isOperationalOnly ? "false" : null)"
                                            aria-disabled="@(!isBookable || isOperationalOnly ? "true" : null)"
                                            aria-label="@ariaLabelText">
                                        <span class="bgp-seat__code">@seat.SeatCode</span>
                                        <span class="bgp-seat__cue" data-seat-cue aria-hidden="true">@cueGlyph</span>
                                    </button>

                                    @if (hasWingAisles && (seat.ColumnNo == 2 || seat.ColumnNo == maxCol - 2))
                                    {
                                        <span class="bgp-seat-aisle" aria-hidden="true"></span>
                                    }
                                }

                                <span class="bgp-seat-row__label seat-row-label" aria-hidden="true">@row</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 5-State Multi-Cue Legend & Price Tier Strip -->
            <div class="bgp-seat-legend" data-testid="seat-multi-cue-legend" aria-label="Chú giải ký hiệu và bảng giá ghế">
                <div class="bgp-seat-legend__item">
                    <span class="bgp-seat bgp-seat--standard bgp-seat--sample" aria-hidden="true">
                        <span class="bgp-seat__code">A1</span>
                        <span class="bgp-seat__cue">•</span>
                    </span>
                    <div class="bgp-seat-legend__text">
                        <span class="bgp-seat-legend__label">Ghế Thường (•)</span>
                        @if (sm.PriceTiersVnd.TryGetValue("STANDARD", out var stdPrice))
                        {
                            <span class="bgp-seat-legend__meta">@stdPrice.ToString("N0") đ</span>
                        }
                        else
                        {
                            <span class="bgp-seat-legend__meta">Tiêu chuẩn</span>
                        }
                    </div>
                </div>

                <div class="bgp-seat-legend__item">
                    <span class="bgp-seat bgp-seat--vip bgp-seat--sample" aria-hidden="true">
                        <span class="bgp-seat__code">C5</span>
                        <span class="bgp-seat__cue">★</span>
                    </span>
                    <div class="bgp-seat-legend__text">
                        <span class="bgp-seat-legend__label">Ghế VIP (★)</span>
                        @if (sm.PriceTiersVnd.TryGetValue("VIP", out var vipPrice))
                        {
                            <span class="bgp-seat-legend__meta bgp-seat-legend__meta--vip">@vipPrice.ToString("N0") đ</span>
                        }
                        else
                        {
                            <span class="bgp-seat-legend__meta bgp-seat-legend__meta--vip">Hạng trung tâm</span>
                        }
                    </div>
                </div>

                <div class="bgp-seat-legend__item">
                    <span class="bgp-seat bgp-seat--selected bgp-seat--sample" aria-hidden="true">
                        <span class="bgp-seat__code">C6</span>
                        <span class="bgp-seat__cue">✓</span>
                    </span>
                    <div class="bgp-seat-legend__text">
                        <span class="bgp-seat-legend__label">Đang chọn (✓)</span>
                        <span class="bgp-seat-legend__meta bgp-seat-legend__meta--selected">Tối đa 8 ghế</span>
                    </div>
                </div>

                <div class="bgp-seat-legend__item">
                    <span class="bgp-seat bgp-seat--held bgp-seat--sample" aria-hidden="true">
                        <span class="bgp-seat__code">B3</span>
                        <span class="bgp-seat__cue">⏳</span>
                    </span>
                    <div class="bgp-seat-legend__text">
                        <span class="bgp-seat-legend__label">Đang tạm giữ (⏳)</span>
                        <span class="bgp-seat-legend__meta">Sọc chéo khóa chỗ</span>
                    </div>
                </div>

                <div class="bgp-seat-legend__item">
                    <span class="bgp-seat bgp-seat--sold bgp-seat--sample" aria-hidden="true">
                        <span class="bgp-seat__code">B4</span>
                        <span class="bgp-seat__cue">✕</span>
                    </span>
                    <div class="bgp-seat-legend__text">
                        <span class="bgp-seat-legend__label">Đã bán (✕)</span>
                        <span class="bgp-seat-legend__meta">Không thể đặt</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Right Column: Sticky Booking Summary & Submission -->
        <aside class="bgp-summary-panel" data-summary-panel aria-label="Tóm tắt đặt ghế">
            <div class="bgp-summary-movie">
                @if (isPendingTmdbNoPoster)
                {
                    <div class="bgp-summary-poster bgp-summary-poster--placeholder" data-testid="summary-poster-placeholder">
                        <span>CHƯA CÓ</span>
                        <span>POSTER</span>
                    </div>
                }
                else
                {
                    <div class="bgp-summary-poster">
                        <img src="@posterSrc"
                             srcset="@posterSrcSet"
                             sizes="68px"
                             alt="Poster phim @sm.MovieTitle"
                             loading="eager"
                             decoding="async"
                             data-testid="summary-poster-img"
                             onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/images/poster-fallback.svg';" />
                    </div>
                }

                <div class="bgp-summary-movie__body">
                    <div class="bgp-summary-badges">
                        @if (sm.MovieRating is not null)
                        {
                            <span class="bgp-badge bgp-badge--imdb-solid" data-testid="summary-rating-badge">
                                IMDb @sm.MovieRating.Score.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)/10
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(ageLabel))
                        {
                            <span class="bgp-age-badge @ageBadgeModifier" data-testid="summary-age-badge">@ageLabel</span>
                        }
                    </div>

                    <h2 class="bgp-summary-movie__title">
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@sm.MovieId">@sm.MovieTitle</a>
                    </h2>

                    <p class="bgp-summary-movie__sub">
                        @if (!string.IsNullOrWhiteSpace(sm.MovieOriginalTitle))
                        {
                            <span>@sm.MovieOriginalTitle</span>
                            @if (sm.MovieReleaseYear.HasValue)
                            {
                                <span> (@sm.MovieReleaseYear.Value)</span>
                            }
                            <span> &bull; </span>
                        }
                        @if (sm.MovieDurationMin > 0)
                        {
                            <span>@sm.MovieDurationMin phút</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(sm.MovieGenreText))
                        {
                            <span> &bull; @sm.MovieGenreText</span>
                        }
                    </p>
                </div>
            </div>

            <div class="bgp-summary-schedule">
                <div class="bgp-summary-schedule__row">
                    <span class="bgp-summary-schedule__label">Phòng chiếu:</span>
                    <span class="bgp-summary-schedule__val">@sm.RoomName</span>
                </div>
                <div class="bgp-summary-schedule__row">
                    <span class="bgp-summary-schedule__label">Giờ chiếu:</span>
                    <span class="bgp-summary-schedule__val">@sm.StartVietnamText</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(sm.EndVietnamTimeOnlyText))
                {
                    <div class="bgp-summary-schedule__row">
                        <span class="bgp-summary-schedule__label">Kết thúc dự kiến:</span>
                        <span class="bgp-summary-schedule__val">
                            @sm.EndVietnamTimeOnlyText
                            @if (sm.CrossesMidnight)
                            {
                                <span class="bgp-midnight-tag" title="Suất chiếu kết thúc sang ngày kế tiếp">+1 ngày</span>
                            }
                        </span>
                    </div>
                }
            </div>

            @if (!sm.IsOpenForBooking)
            {
                <div data-testid="seat-closed-summary">
                    <p class="bgp-summary-honesty" style="margin-bottom: 14px;">
                        <strong>@(sm.IneligibleReason ?? "Suất chiếu này hiện không mở đặt vé trực tuyến.")</strong>
                        Vui lòng chọn một suất chiếu khác đang mở bán của bộ phim này.
                    </p>
                    <a href="/movies/@sm.MovieId#showtimes-section"
                       class="bgp-btn bgp-btn--outline bgp-summary-submit"
                       data-testid="seat-back-to-showtimes-cta">
                        &larr; Chọn suất chiếu khác
                    </a>
                </div>
            }
            else
            {
                <div>
                    <div class="bgp-summary-selection-head">
                        <strong>Ghế bạn đang chọn</strong>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span class="bgp-summary-selection-count">
                                <strong id="selectedCount">0</strong> / 8 ghế
                            </span>
                            <button type="button"
                                    class="bgp-summary-clear-btn"
                                    data-seat-clear-all
                                    hidden>
                                Xóa hết
                            </button>
                        </div>
                    </div>
                </div>

                <div id="selectedSeatsBadges"
                     class="bgp-selected-seats-list"
                     aria-live="polite"
                     aria-label="Danh sách ghế đã chọn">
                    <div class="bgp-selected-empty">
                        Chưa có ghế nào được chọn — Nhấp chuột hoặc dùng phím mũi tên + Space trên sơ đồ.
                    </div>
                </div>

                <div class="bgp-summary-subtotal">
                    <span class="bgp-summary-subtotal__label">Tạm tính:</span>
                    <strong id="selectedTotal" class="bgp-summary-total">0 đ</strong>
                </div>

                <form asp-controller="Bookings" asp-action="Reserve" method="post" id="formReserve" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="showtimeId" value="@sm.ShowtimeId" />
                    <input type="hidden" name="seatIdsCsv" id="seatIdsCsv" value="" />

                    @if (isOperationalOnly)
                    {
                        <button type="submit"
                                class="bgp-btn bgp-btn--outline bgp-summary-submit"
                                id="btnSubmit"
                                disabled>
                            Khóa đặt vé (Tài khoản vận hành)
                        </button>
                    }
                    else if (isAuthenticated)
                    {
                        <button type="submit"
                                class="bgp-btn bgp-btn--primary bgp-summary-submit"
                                id="btnSubmit"
                                disabled>
                            Giữ ghế &amp; Tiếp tục thanh toán &rarr;
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="bgp-btn bgp-btn--primary bgp-summary-submit"
                                id="btnSubmit"
                                disabled>
                            Đăng nhập để giữ ghế &rarr;
                        </button>
                    }
                </form>

                <p class="bgp-summary-honesty" data-testid="seat-hold-honesty-note">
                    <strong>Chưa tính giờ giữ chỗ ở bước này.</strong>
                    Ghế chỉ bắt đầu được khóa giao dịch và đếm ngược giữ chỗ sau khi máy chủ xác nhận ở bước tiếp theo.
                    @if (!isAuthenticated)
                    {
                        <span> Lựa chọn ghế của bạn sẽ được lưu nháp tạm thời (10 phút) khi chuyển sang trang Đăng nhập.</span>
                    }
                </p>
            }
        </aside>
    </div>

    <!-- Compact Mobile Sticky Dock (< 1100px when seats selected & summary card scrolled out of view) -->
    @if (sm.IsOpenForBooking && !isOperationalOnly)
    {
        <div class="bgp-mobile-seat-dock" data-testid="seat-mobile-dock" hidden>
            <div class="bgp-mobile-seat-dock__info">
                <div class="bgp-mobile-seat-dock__count" data-mobile-seat-count>0/8 ghế</div>
                <div class="bgp-mobile-seat-dock__total" data-mobile-seat-total>0 đ</div>
            </div>
            <button type="button"
                    class="bgp-btn bgp-btn--primary bgp-btn--sm"
                    style="min-height: 44px; padding-inline: 18px;"
                    data-mobile-submit-proxy>
                Tiếp tục &rarr;
            </button>
        </div>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/modules/seat-map.js" asp-append-version="true"></script>
}
