@model BetaGiaiPhong.Web.Models.ViewModels.OrderListViewModel
@{
    Layout = "_CinemaLayout";
    ViewData["HeaderOverlay"] = false;
    ViewData["Title"] = "Đơn hàng & Vé điện tử của tôi";

    string activeFilter = (Model.StatusFilter ?? "").Trim().ToLowerInvariant();
    bool isAllActive = string.IsNullOrEmpty(activeFilter) || activeFilter == "all";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-tickets.css" asp-append-version="true" />
}

<div class="bgp-orders-page" data-testid="orders-history-page">
    <!-- Breadcrumb -->
    <div class="bgp-tk-topbar">
        <nav aria-label="Đường dẫn điều hướng">
            <ol class="bgp-tk-breadcrumb">
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="bgp-tk-breadcrumb__sep" aria-hidden="true">/</li>
                <li class="bgp-tk-breadcrumb__current" aria-current="page" style="font-family: var(--bgp-font-sans);">Đơn hàng của tôi</li>
            </ol>
        </nav>
    </div>

    <!-- Page Header -->
    <header class="bgp-orders-hero">
        <div>
            <h1 class="bgp-orders-hero__title">Đơn hàng &amp; Vé điện tử của tôi</h1>
        </div>
        <div>
            <a class="bgp-btn bgp-btn--primary" asp-controller="Movies" asp-action="Index" asp-route-filter="has-showtimes">
                <span>Khám phá lịch chiếu</span>
                <span aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </header>

    <!-- Flash Alerts -->
    @if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
    {
        <div class="bgp-tk-alert bgp-tk-alert--success" role="status">
            <div class="bgp-tk-alert__body">
                <span aria-hidden="true" style="color: #86EFAC; font-weight: 800;">&#10003;</span>
                <div>
                    <span class="bgp-tk-alert__title">Thông báo</span>
                    <span>@Model.FlashMessage</span>
                </div>
            </div>
            <button type="button" class="bgp-tk-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.FlashError))
    {
        <div class="bgp-tk-alert bgp-tk-alert--error" role="alert">
            <div class="bgp-tk-alert__body">
                <span aria-hidden="true" style="color: #FCA5A5; font-weight: 800;">&#9888;</span>
                <div>
                    <span class="bgp-tk-alert__title">Không thể truy cập đơn hàng</span>
                    <span>@Model.FlashError</span>
                </div>
            </div>
            <button type="button" class="bgp-tk-alert__close" data-dismiss-alert aria-label="Đóng cảnh báo">&times;</button>
        </div>
    }

    <!-- Filter Bar -->
    <div class="bgp-orders-filters" data-testid="orders-status-filters">
        <div class="bgp-orders-filter-pills" role="navigation" aria-label="Lọc đơn hàng theo trạng thái">
            <a class="bgp-orders-filter-pill @(isAllActive ? "is-active" : "")"
               aria-current="@(isAllActive ? "page" : null)"
               asp-controller="Orders"
               asp-action="Index">
                Tất cả
            </a>
            <a class="bgp-orders-filter-pill @(activeFilter == "paid" ? "is-active" : "")"
               aria-current="@(activeFilter == "paid" ? "page" : null)"
               asp-controller="Orders"
               asp-action="Index"
               asp-route-status="paid">
                Đã thanh toán (PAID)
            </a>
            <a class="bgp-orders-filter-pill @(activeFilter == "pending" ? "is-active" : "")"
               aria-current="@(activeFilter == "pending" ? "page" : null)"
               asp-controller="Orders"
               asp-action="Index"
               asp-route-status="pending">
                Đang giữ chỗ
            </a>
            <a class="bgp-orders-filter-pill @(activeFilter == "inactive" ? "is-active" : "")"
               aria-current="@(activeFilter == "inactive" ? "page" : null)"
               asp-controller="Orders"
               asp-action="Index"
               asp-route-status="inactive">
                Đã hủy / Quá hạn / Lỗi
            </a>
        </div>

        <span class="bgp-orders-count-meta">
            Tổng cộng <strong>@Model.TotalCount</strong> đơn hàng
        </span>
    </div>

    <!-- Orders List or Empty State -->
    @if (Model.Orders.Count == 0)
    {
        <section class="bgp-orders-empty" data-testid="orders-empty-state" aria-labelledby="orders-empty-heading">
            <div class="bgp-orders-empty__icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
                    <path d="M13 5v2"></path>
                    <path d="M13 17v2"></path>
                    <path d="M13 11v2"></path>
                </svg>
            </div>
            @if (!isAllActive)
            {
                <h2 id="orders-empty-heading" class="bgp-orders-empty__title">Không có đơn hàng nào khớp bộ lọc hiện tại</h2>
                <p class="bgp-orders-empty__desc">
                    Bạn chưa có giao dịch nào thuộc nhóm trạng thái vừa chọn. Hãy xóa bộ lọc để xem toàn bộ lịch sử đơn hàng.
                </p>
                <a class="bgp-btn bgp-btn--outline" asp-controller="Orders" asp-action="Index">
                    Xem tất cả đơn hàng
                </a>
            }
            else
            {
                <h2 id="orders-empty-heading" class="bgp-orders-empty__title">Bạn chưa có đơn đặt vé nào</h2>
                <p class="bgp-orders-empty__desc">
                    Khám phá danh mục tác phẩm điện ảnh xác minh đang có lịch chiếu tại rạp Beta Giải Phóng để chọn ghế và nhận vé điện tử QR.
                </p>
                <a class="bgp-btn bgp-btn--primary" asp-controller="Movies" asp-action="Index" asp-route-filter="has-showtimes">
                    Xem lịch chiếu phim &rarr;
                </a>
            }
        </section>
    }
    else
    {
        <div class="bgp-orders-list" data-testid="orders-list">
            @foreach (var order in Model.Orders)
            {
                bool isPendingActive = order.Status == "PENDING_PAYMENT" && !order.IsHoldExpired;
                bool isPaid = order.Status == "PAID";

                string cardModifier = order.Status switch
                {
                    "PAID" => "bgp-order-card--paid",
                    "PENDING_PAYMENT" when !order.IsHoldExpired => "bgp-order-card--pending",
                    _ => "bgp-order-card--inactive"
                };

                string pillModifier = order.Status switch
                {
                    "PAID" => "bgp-order-status-pill--paid",
                    "PENDING_PAYMENT" when !order.IsHoldExpired => "bgp-order-status-pill--pending",
                    "CANCELLED" or "FAILED" => "bgp-order-status-pill--danger",
                    "NEEDS_REVIEW" => "bgp-order-status-pill--review",
                    _ => "bgp-order-status-pill--expired"
                };

                string statusText = order.Status switch
                {
                    "PENDING_PAYMENT" when !order.IsHoldExpired => "Chờ thanh toán",
                    "PENDING_PAYMENT" when order.IsHoldExpired => "Hết hạn giữ chỗ",
                    "PAID" => "Đã thanh toán • PAID",
                    "CANCELLED" => "Đã hủy",
                    "EXPIRED" => "Hết hạn giữ chỗ",
                    "FAILED" => "Thanh toán thất bại",
                    "NEEDS_REVIEW" => "Cần đối soát",
                    _ => order.Status
                };

                var art = order.MovieArtwork;
                bool hasVerifiedPoster = art?.HasVerifiedPoster == true && !string.IsNullOrWhiteSpace(art.PosterUrl);
                string posterSrc = hasVerifiedPoster
                    ? (art!.PosterW342Url ?? art.PosterUrl!)
                    : "/images/poster-fallback.svg";
                string? posterSrcSet = hasVerifiedPoster && !string.IsNullOrWhiteSpace(art!.PosterW342Url) && !string.IsNullOrWhiteSpace(art.PosterUrl)
                    ? $"{art.PosterW342Url} 342w, {art.PosterUrl} 780w"
                    : null;

                <article class="bgp-order-card @cardModifier"
                         data-testid="order-list-card"
                         data-order-id="@order.OrderId"
                         data-order-status="@order.Status">
                    <div class="bgp-order-card__poster-wrap">
                        <img src="@posterSrc"
                             srcset="@posterSrcSet"
                             sizes="60px"
                             alt="Poster @order.MovieTitle"
                             class="bgp-order-card__poster"
                             width="60"
                             height="90"
                             loading="lazy"
                             onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/images/poster-fallback.svg';" />
                    </div>

                    <div class="bgp-order-card__main">
                        <div class="bgp-order-card__top">
                            <span class="bgp-order-status-pill @pillModifier">@statusText</span>
                            <span class="bgp-order-card__code">#@order.OrderCode</span>
                        </div>

                        <h2 class="bgp-order-card__title">
                            @if (order.MovieId > 0)
                            {
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@order.MovieId">@order.MovieTitle</a>
                            }
                            else
                            {
                                @order.MovieTitle
                            }
                        </h2>

                        <div class="bgp-order-card__meta">
                            @if (!string.IsNullOrWhiteSpace(order.RoomName))
                            {
                                <span>Phòng: <strong>@order.RoomName</strong></span>
                            }
                            <span>Suất chiếu: <strong class="bgp-tk-mono">@order.StartVietnamText</strong></span>
                            <span>
                                Số ghế:
                                <strong>
                                    @order.SeatCount ghế@(!string.IsNullOrWhiteSpace(order.SeatCodesSummary) ? $" ({order.SeatCodesSummary})" : "")
                                </strong>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(order.CreatedVietnamText))
                            {
                                <span>Tạo lúc: <span class="bgp-tk-mono">@order.CreatedVietnamText</span></span>
                            }
                        </div>
                    </div>

                    <div class="bgp-order-card__right">
                        <div class="bgp-order-card__total">@order.TotalVnd.ToString("N0") đ</div>

                        <div class="bgp-order-card__actions">
                            @if (isPaid)
                            {
                                <a class="bgp-btn bgp-btn--primary"
                                   asp-controller="Orders"
                                   asp-action="Tickets"
                                   asp-route-id="@order.OrderId"
                                   data-testid="order-card-tickets-cta">
                                    Xem vé QR &rarr;
                                </a>
                            }
                            else if (isPendingActive)
                            {
                                <a class="bgp-btn bgp-btn--primary"
                                   asp-controller="Orders"
                                   asp-action="Checkout"
                                   asp-route-id="@order.OrderId"
                                   data-testid="order-card-checkout-cta">
                                    Thanh toán ngay &rarr;
                                </a>
                            }

                            <a class="bgp-btn bgp-btn--outline"
                               asp-controller="Orders"
                               asp-action="Details"
                               asp-route-id="@order.OrderId"
                               data-testid="order-card-details-cta">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang danh sách đơn hàng">
                <ul class="bgp-orders-pagination">
                    <li>
                        <a class="bgp-orders-page-link @(Model.CurrentPage <= 1 ? "is-disabled" : "")"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-status="@Model.StatusFilter">
                            &larr; Trước
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li>
                            <a class="bgp-orders-page-link @(Model.CurrentPage == i ? "is-active" : "")"
                               aria-current="@(Model.CurrentPage == i ? "page" : null)"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-status="@Model.StatusFilter">
                                @i
                            </a>
                        </li>
                    }
                    <li>
                        <a class="bgp-orders-page-link @(Model.CurrentPage >= Model.TotalPages ? "is-disabled" : "")"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-status="@Model.StatusFilter">
                            Sau &rarr;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script type="module" src="~/js/modules/tickets-print.js" asp-append-version="true"></script>
}
