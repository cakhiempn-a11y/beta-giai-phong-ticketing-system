@model BetaGiaiPhong.Web.Models.ViewModels.OrderListViewModel
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container mt-4 mb-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Đơn hàng của tôi</h1>
            <p class="text-muted mb-0">Quản lý lịch sử đặt vé và trạng thái giữ ghế tại Beta Giải Phóng.</p>
        </div>
        <div>
            <a class="btn btn-outline-primary" asp-controller="Movies" asp-action="Index">
                🎬 Đặt thêm vé mới
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.FlashMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>✅ Thông báo:</strong> @Model.FlashMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.FlashError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>⚠️ Lỗi:</strong> @Model.FlashError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Orders.Count == 0)
    {
        <div class="card shadow-sm border-0 p-5 text-center">
            <div class="display-3 text-muted mb-3">🎟️</div>
            <h2 class="h4 fw-bold mb-2">Bạn chưa có đơn đặt vé nào</h2>
            <p class="text-muted mb-4">Hãy khám phá các bộ phim bom tấn đang chiếu và chọn cho mình chỗ ngồi ưng ý nhất!</p>
            <div>
                <a class="btn btn-primary px-4 py-2" asp-controller="Movies" asp-action="Index">Khám phá phim ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã đơn hàng</th>
                            <th>Phim</th>
                            <th>Suất chiếu (VN)</th>
                            <th class="text-center">Số ghế</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            var badgeClass = order.Status switch
                            {
                                "PENDING_PAYMENT" when !order.IsHoldExpired => "bg-warning text-dark",
                                "PENDING_PAYMENT" when order.IsHoldExpired => "bg-secondary",
                                "PAID" => "bg-success",
                                "CANCELLED" => "bg-danger",
                                "EXPIRED" => "bg-secondary",
                                "FAILED" => "bg-danger",
                                _ => "bg-info text-dark"
                            };

                            var statusText = order.Status switch
                            {
                                "PENDING_PAYMENT" when !order.IsHoldExpired => "Chờ thanh toán",
                                "PENDING_PAYMENT" when order.IsHoldExpired => "Hết hạn giữ chỗ",
                                "PAID" => "Đã thanh toán",
                                "CANCELLED" => "Đã hủy",
                                "EXPIRED" => "Hết hạn",
                                "FAILED" => "Thất bại",
                                "NEEDS_REVIEW" => "Cần đối soát",
                                _ => order.Status
                            };

                            <tr>
                                <td class="ps-4">
                                    <span class="font-monospace fw-bold">@order.OrderCode</span>
                                    <small class="text-muted d-block">ID: @order.OrderId</small>
                                </td>
                                <td>
                                    <strong class="text-dark">@order.MovieTitle</strong>
                                </td>
                                <td>
                                    <span>@order.StartVietnamText</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@order.SeatCount ghế</span>
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    @order.TotalVnd.ToString("N0") đ
                                </td>
                                <td class="text-center">
                                    <span class="badge @badgeClass">@statusText</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId">
                                        Chi tiết &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
