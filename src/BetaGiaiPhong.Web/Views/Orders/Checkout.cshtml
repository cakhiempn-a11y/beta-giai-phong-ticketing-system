@model BetaGiaiPhong.Web.Models.ViewModels.CheckoutViewModel
@{
    Layout = "_CinemaLayout";
    ViewData["HeaderOverlay"] = false;
    ViewData["Title"] = $"Thanh toán đơn hàng #{Model.OrderCode}";

    string seatCodesText = Model.Seats.Count > 0
        ? string.Join(", ", Model.Seats.Select(s => s.SeatCode))
        : "Chưa ghi nhận ghế";

    string sampleSeatLabel = Model.Seats.Count > 0
        ? $"{Model.Seats[0].SeatCode} ({(string.Equals(Model.Seats[0].SeatTypeSnapshot, "VIP", StringComparison.OrdinalIgnoreCase) ? "VIP" : "Thường")})"
        : "A1";

    var art = Model.MovieArtwork;
    bool hasVerifiedPoster = art?.HasVerifiedPoster == true && !string.IsNullOrWhiteSpace(art.PosterUrl);
    string posterSrc = hasVerifiedPoster
        ? (art!.PosterW342Url ?? art.PosterUrl!)
        : "/images/poster-fallback.svg";
    string? posterSrcSet = hasVerifiedPoster && !string.IsNullOrWhiteSpace(art!.PosterW342Url) && !string.IsNullOrWhiteSpace(art.PosterUrl)
        ? $"{art.PosterW342Url} 342w, {art.PosterUrl} 780w"
        : null;

    bool hasVnClassification = !string.IsNullOrWhiteSpace(Model.MovieAgeLabel) &&
        string.Equals(Model.MovieAgeLabelMarket, "VN", StringComparison.OrdinalIgnoreCase);
    string ageCodeLower = (Model.MovieAgeLabel ?? "P").Trim().ToLowerInvariant();

    string expiresVnDisplay = !string.IsNullOrWhiteSpace(Model.ExpiresVietnamText)
        ? Model.ExpiresVietnamText
        : Model.ExpiresUtc.ToString("dd/MM/yyyy HH:mm:ss");
    string expiresTimeOnlyDisplay = !string.IsNullOrWhiteSpace(Model.ExpiresVietnamTimeOnlyText)
        ? Model.ExpiresVietnamTimeOnlyText
        : Model.ExpiresUtc.ToString("HH:mm:ss");
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-checkout.css" asp-append-version="true" />
}

<div class="bgp-tx-page" data-testid="checkout-page">
    <!-- 1. Top Breadcrumb & 4-Step Booking Stepper -->
    <div class="bgp-tx-topbar">
        <nav aria-label="Đường dẫn điều hướng">
            <ol class="bgp-tx-breadcrumb">
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="bgp-tx-breadcrumb__sep" aria-hidden="true">/</li>
                <li><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
                <li class="bgp-tx-breadcrumb__sep" aria-hidden="true">/</li>
                <li><a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@Model.OrderCode</a></li>
                <li class="bgp-tx-breadcrumb__sep" aria-hidden="true">/</li>
                <li class="bgp-tx-breadcrumb__current" aria-current="page">Thanh toán</li>
            </ol>
        </nav>

        <ol class="bgp-tx-stepper" aria-label="Tiến trình đặt vé">
            <li class="bgp-tx-stepper__item">
                @if (Model.MovieId > 0)
                {
                    <a class="bgp-tx-stepper__pill bgp-tx-stepper__pill--done"
                       asp-controller="Movies"
                       asp-action="Details"
                       asp-route-id="@Model.MovieId"
                       asp-fragment="showtimes-section">
                        <span aria-hidden="true">&#10003;</span>
                        <span>1. Chọn suất chiếu</span>
                    </a>
                }
                else
                {
                    <span class="bgp-tx-stepper__pill bgp-tx-stepper__pill--done">
                        <span aria-hidden="true">&#10003;</span>
                        <span>1. Chọn suất chiếu</span>
                    </span>
                }
                <span class="bgp-tx-stepper__arrow" aria-hidden="true">&rarr;</span>
            </li>
            <li class="bgp-tx-stepper__item">
                @if (Model.ShowtimeId > 0)
                {
                    <a class="bgp-tx-stepper__pill bgp-tx-stepper__pill--done"
                       asp-controller="Showtimes"
                       asp-action="Seats"
                       asp-route-id="@Model.ShowtimeId">
                        <span aria-hidden="true">&#10003;</span>
                        <span>2. Chọn ghế ngồi</span>
                    </a>
                }
                else
                {
                    <span class="bgp-tx-stepper__pill bgp-tx-stepper__pill--done">
                        <span aria-hidden="true">&#10003;</span>
                        <span>2. Chọn ghế ngồi</span>
                    </span>
                }
                <span class="bgp-tx-stepper__arrow" aria-hidden="true">&rarr;</span>
            </li>
            <li class="bgp-tx-stepper__item">
                <span class="bgp-tx-stepper__pill bgp-tx-stepper__pill--active" aria-current="step">
                    <span>3. Giữ chỗ &amp; Thanh toán</span>
                </span>
                <span class="bgp-tx-stepper__arrow" aria-hidden="true">&rarr;</span>
            </li>
            <li class="bgp-tx-stepper__item">
                <span class="bgp-tx-stepper__pill">4. Nhận vé QR</span>
            </li>
        </ol>
    </div>

    <!-- 2. Server-Synchronized Hold Countdown Banner -->
    <section class="bgp-hold-banner"
             data-hold-banner
             data-testid="order-hold-banner"
             aria-label="Thời hạn giữ ghế từ máy chủ">
        <div class="bgp-hold-banner__main">
            <div class="bgp-hold-banner__top">
                <span class="bgp-status-pill bgp-status-pill--pending">PENDING_PAYMENT &bull; Đang giữ chỗ</span>
                <span class="bgp-hold-banner__code">#@Model.OrderCode</span>
            </div>
            <h1 class="bgp-hold-banner__title">
                Xác nhận &amp; Thanh toán cho @Model.Seats.Count ghế (@seatCodesText)
            </h1>
            <p class="bgp-hold-banner__desc">
                Thời hạn giữ ghế tới <strong>@expiresTimeOnlyDisplay</strong> (@expiresVnDisplay).
            </p>
        </div>

        <div class="bgp-hold-banner__clock-wrap">
            <span class="bgp-hold-banner__clock-label">Thời gian giữ chỗ còn lại</span>
            <span id="countdownTimer"
                  class="bgp-hold-clock"
                  data-remaining="@Model.RemainingSeconds"
                  data-window-seconds="300"
                  data-testid="hold-countdown-timer">
                --:--
            </span>
        </div>

        <div class="bgp-hold-progress" aria-hidden="true">
            <div class="bgp-hold-progress__bar" data-hold-progress></div>
        </div>
    </section>

    <div id="bgp-hold-live-status" class="bgp-sr-only" aria-live="polite"></div>

    <!-- 3. Two-Column Checkout Workspace -->
    <div class="bgp-tx-grid">
        <!-- Left Column: Order Summary + Perforated Post-Payment QR Pass Spec Preview -->
        <section class="bgp-tx-panel" aria-labelledby="checkout-summary-heading">
            <div class="bgp-tx-panel__head">
                <h2 id="checkout-summary-heading" class="bgp-tx-panel__title">Chi tiết đơn đặt vé</h2>
            </div>

            <div class="bgp-tx-film" data-testid="checkout-verified-film-card">
                <div class="bgp-tx-film__poster-wrap">
                    <img src="@posterSrc"
                         srcset="@posterSrcSet"
                         sizes="84px"
                         alt="Poster phim @Model.MovieTitle"
                         class="bgp-tx-film__poster"
                         width="84"
                         height="126"
                         loading="eager"
                         onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/images/poster-fallback.svg';" />
                </div>

                <div class="bgp-tx-film__body">
                    <div class="bgp-tx-film__badges">
                        <span class="bgp-tx-room-pill">@Model.RoomName</span>

                        @if (hasVnClassification)
                        {
                            <span class="bgp-age-badge bgp-age-badge--@ageCodeLower">@Model.MovieAgeLabel</span>
                        }

                        @if (Model.MovieRating is not null)
                        {
                            <span class="bgp-badge bgp-badge--imdb-solid" data-testid="checkout-movie-rating">
                                @Model.MovieRating.DisplayText
                            </span>
                        }
                    </div>

                    <h3 class="bgp-tx-film__title">@Model.MovieTitle</h3>

                    <div class="bgp-tx-film__sub">
                        @if (!string.IsNullOrWhiteSpace(Model.MovieOriginalTitle) &&
                             !string.Equals(Model.MovieOriginalTitle, Model.MovieTitle, StringComparison.OrdinalIgnoreCase))
                        {
                            <span>@Model.MovieOriginalTitle@(Model.MovieReleaseYear.HasValue ? $" ({Model.MovieReleaseYear})" : "") &bull; </span>
                        }
                        else if (Model.MovieReleaseYear.HasValue)
                        {
                            <span>Năm @Model.MovieReleaseYear &bull; </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.MovieDirectorNames))
                        {
                            <span>Đạo diễn @Model.MovieDirectorNames &bull; </span>
                        }

                        @if (Model.MovieDurationMin > 0)
                        {
                            <span>@Model.MovieDurationMin phút</span>
                        }
                    </div>

                    <div class="bgp-tx-meta-grid">
                        <div>
                            <span class="bgp-tx-meta-item__label">Ngày chiếu</span>
                            <span class="bgp-tx-meta-item__val">
                                @(string.IsNullOrWhiteSpace(Model.StartVietnamDateText) ? Model.FormattedStartUtc : Model.StartVietnamDateText)
                            </span>
                        </div>
                        <div>
                            <span class="bgp-tx-meta-item__label">Khung giờ</span>
                            <span class="bgp-tx-meta-item__val bgp-tx-meta-item__val--mono">
                                @if (!string.IsNullOrWhiteSpace(Model.StartVietnamTimeOnlyText) && !string.IsNullOrWhiteSpace(Model.EndVietnamTimeOnlyText))
                                {
                                    @:@Model.StartVietnamTimeOnlyText &rarr; @Model.EndVietnamTimeOnlyText
                                }
                                else
                                {
                                    @Model.FormattedStartUtc
                                }
                                @if (Model.CrossesMidnight)
                                {
                                    <span class="bgp-tx-midnight-pill">+1 ngày</span>
                                }
                            </span>
                        </div>
                        <div>
                            <span class="bgp-tx-meta-item__label">Ghế khóa tạm</span>
                            <span class="bgp-tx-meta-item__val bgp-tx-meta-item__val--mono">@seatCodesText</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bgp-tx-section-label">
                <span>Danh sách ghế đã chọn (@Model.Seats.Count ghế)</span>
            </div>

            <div class="bgp-tx-seat-table-wrap">
                <table class="bgp-tx-seat-table" aria-label="Bảng đối chiếu ghế thanh toán">
                    <thead>
                        <tr>
                            <th scope="col">Mã ghế</th>
                            <th scope="col">Hạng ghế</th>
                            <th scope="col" class="is-right">Đơn giá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var seat in Model.Seats)
                        {
                            bool isVip = string.Equals(seat.SeatTypeSnapshot, "VIP", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td>
                                    <span class="bgp-tx-seat-code">@seat.SeatCode</span>
                                </td>
                                <td>
                                    @if (isVip)
                                    {
                                        <span class="bgp-tx-tier-badge bgp-tx-tier-badge--vip">
                                            <span aria-hidden="true">&#9733;</span>
                                            <span>Ghế VIP</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bgp-tx-tier-badge bgp-tx-tier-badge--std">
                                            <span aria-hidden="true">&bull;</span>
                                            <span>Ghế Thường</span>
                                        </span>
                                    }
                                </td>
                                <td class="is-right bgp-tx-price-mono">@seat.UnitPriceVnd.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bgp-tx-totals">
                <div class="bgp-tx-totals__row">
                    <span>Tạm tính (@Model.Seats.Count ghế)</span>
                    <strong>@Model.SubtotalVnd.ToString("N0") đ</strong>
                </div>
                <div class="bgp-tx-totals__row">
                    <span>Phí tiện ích</span>
                    <strong>@Model.FeeVnd.ToString("N0") đ</strong>
                </div>
                <div class="bgp-tx-totals__row">
                    <span>Khuyến mãi / Giảm giá</span>
                    <strong class="bgp-tx-totals__discount">-@Model.DiscountVnd.ToString("N0") đ</strong>
                </div>
                <div class="bgp-tx-totals__grand">
                    <span class="bgp-tx-totals__grand-label">Tổng thanh toán</span>
                    <strong class="bgp-tx-totals__grand-amount" data-testid="checkout-total-vnd">@Model.TotalVnd.ToString("N0") đ</strong>
                </div>
            </div>

            <!-- Perforated QR Boarding Pass Design Preview -->
            <div class="bgp-qr-pass-preview"
                 data-testid="qr-pass-preview"
                 aria-label="Mẫu cấu trúc vé điện tử QR phát hành sau khi thanh toán thành công">
                <div class="bgp-qr-pass-preview__body">
                    <div>
                        <div class="bgp-qr-pass-preview__eyebrow">
                            <span>Mẫu vé điện tử cấp nguyên tử sau khi PAID</span>
                            <span class="bgp-badge bgp-badge--success">ISSUED &bull; QR</span>
                        </div>
                        <div class="bgp-qr-pass-preview__title">
                            @Model.MovieTitle &bull; @Model.RoomName &bull; Ghế @sampleSeatLabel
                        </div>
                        <div class="bgp-qr-pass-preview__meta">
                            Đơn #@Model.OrderCode &bull; Suất @Model.FormattedStartUtc
                        </div>
                    </div>
                    <div class="bgp-qr-pass-preview__note">
                        Vé điện tử QR riêng cho từng ghế được phát hành tự động ngay sau khi giao dịch thành công.
                    </div>
                </div>
                <div class="bgp-qr-pass-preview__stub" aria-hidden="true">
                    <div class="bgp-qr-schematic-box">
                        <svg width="78" height="78" viewBox="0 0 21 21" shape-rendering="crispEdges" focusable="false">
                            <rect width="21" height="21" fill="#FFFFFF" />
                            <path fill="#000000" d="M0,0h7v7h-7zM1,1v5h5v-5zM2,2h3v3h-3zM14,0h7v7h-7zM15,1v5h5v-5zM16,2h3v3h-3zM0,14h7v7h-7zM1,15v5h5v-5zM2,16h3v3h-3zM8,1h2v2h-2zM11,2h2v3h-2zM8,5h3v2h-3zM1,8h3v2h-3zM5,8h2v3h-2zM9,8h4v2h-4zM14,9h3v2h-3zM18,8h3v2h-3zM2,11h2v2h-2zM8,11h2v4h-2zM11,12h4v2h-4zM16,12h2v3h-2zM19,11h2v4h-2zM9,16h3v2h-3zM13,15h2v4h-2zM16,17h5v2h-5zM10,19h3v2h-3zM17,20h3v1h-3z" />
                        </svg>
                    </div>
                    <span class="bgp-qr-pass-preview__stub-caption">MINH HỌA VÉ QR</span>
                </div>
            </div>
        </section>

        <!-- Right Column: Sandbox Payment Gateway Simulator -->
        <aside class="bgp-tx-panel bgp-tx-panel--sticky"
               aria-labelledby="payment-sim-heading"
               data-testid="mis-payment-simulator">
            <div class="bgp-mis-header">
                <span class="bgp-badge bgp-badge--warning">CỔNG THANH TOÁN THỬ NGHIỆM</span>
                <span class="bgp-mis-proto-tag">HMAC-SHA256 Signed</span>
            </div>

            <h2 id="payment-sim-heading" class="bgp-tx-panel__title" style="margin-bottom: 10px;">
                Xác nhận Cổng Thanh toán
            </h2>

            <div class="bgp-mis-disclosure" role="note" data-testid="mis-honest-disclosure">
                <strong>Cổng thanh toán thử nghiệm:</strong> Xác thực phản hồi ký số
                <code>HMAC-SHA256</code> — hệ thống <strong>không thu tiền thật</strong>,
                <strong>không kết nối tổ chức tín dụng</strong> và
                <strong>không yêu cầu nhập số thẻ ngân hàng</strong>.
            </div>

            @if (Model.IsSimulatorEnabled)
            {
                <div class="bgp-sim-actions">
                    <!-- Simulated SUCCESS Payment -->
                    <form asp-controller="Orders"
                          asp-action="DemoPay"
                          asp-route-id="@Model.OrderId"
                          method="post"
                          id="formPaySuccess">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="outcome" value="SUCCESS" />
                        <button type="submit"
                                class="bgp-btn-pay-primary"
                                id="btnPaySuccess"
                                data-testid="pay-success-btn">
                            <span>Xác nhận Mô phỏng Thành công (SUCCESS)</span>
                            <span class="bgp-btn-pay-primary__amount">@Model.TotalVnd.ToString("N0") đ &rarr;</span>
                        </button>
                    </form>

                    <!-- Simulated FAILED Payment (Confirmed via accessible <dialog>) -->
                    <form asp-controller="Orders"
                          asp-action="DemoPay"
                          asp-route-id="@Model.OrderId"
                          method="post"
                          id="formPayFailed"
                          data-confirm-dialog="bgp-fail-pay-dialog">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="outcome" value="FAILED" />
                        <button type="submit"
                                class="bgp-btn-pay-fail"
                                id="btnPayFailed"
                                data-testid="pay-failed-btn">
                            <span>Mô phỏng Giao dịch Bị từ chối (FAILED)</span>
                            <span class="bgp-btn-pay-fail__hint">Nhả ghế ngay</span>
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="bgp-state-card" data-testid="simulator-disabled-notice" style="margin-top: 0;">
                    <h3 class="bgp-state-card__title">Chế độ Callback Webhook Chuẩn</h3>
                    <p class="bgp-state-card__desc">
                        Nút mô phỏng trực tiếp trên trình duyệt chỉ bật khi cấu hình
                        <code>BGP_ENABLE_MOCK_PAYMENT_SIMULATOR=true</code> trong môi trường Development. Đơn hàng hiện chờ phản hồi ký số tại <code>POST /api/webhooks/mock-payment</code>.
                    </p>
                </div>
            }

            <!-- Dynamic Hold-Expired Lockout Card (Revealed automatically when countdown hits 00:00) -->
            <div class="bgp-state-card bgp-state-card--expired"
                 data-testid="hold-expired-inline-panel"
                 hidden>
                <h3 class="bgp-state-card__title">Thời gian giữ ghế đã hết hạn (00:00)</h3>
                <p class="bgp-state-card__desc">
                    Các nút mô phỏng thanh toán đã tự động khóa vì đơn hàng vượt quá <code>HoldExpiresUtc</code>. Vui lòng quay lại sơ đồ khán phòng để chọn lại ghế mới.
                </p>
                @if (Model.ShowtimeId > 0)
                {
                    <a class="bgp-btn bgp-btn--primary bgp-btn-full"
                       asp-controller="Showtimes"
                       asp-action="Seats"
                       asp-route-id="@Model.ShowtimeId"
                       data-testid="checkout-reselect-seats-cta">
                        Chọn lại ghế cho suất chiếu này &rarr;
                    </a>
                }
                else
                {
                    <a class="bgp-btn bgp-btn--primary bgp-btn-full"
                       asp-controller="Orders"
                       asp-action="Details"
                       asp-route-id="@Model.OrderId">
                        Kiểm tra trạng thái đơn hàng &rarr;
                    </a>
                }
            </div>

            <hr class="bgp-tx-divider" />

            <div class="bgp-tx-secondary-actions">
                <form asp-controller="Orders"
                      asp-action="Cancel"
                      asp-route-id="@Model.OrderId"
                      method="post"
                      id="formCancelCheckout"
                      data-confirm-dialog="bgp-cancel-order-dialog">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="bgp-btn bgp-btn--outline bgp-btn-full"
                            id="btnCancelCheckout"
                            data-testid="open-cancel-dialog-btn">
                        Hủy đơn hàng &amp; giải phóng ghế
                    </button>
                </form>

                <a class="bgp-btn bgp-btn--glass bgp-btn-full"
                   asp-controller="Orders"
                   asp-action="Details"
                   asp-route-id="@Model.OrderId">
                    &larr; Xem lại chi tiết đơn hàng
                </a>
            </div>
        </aside>
    </div>

    <!-- Accessible Confirmation <dialog> for Simulated FAILED Payment (Zero window.confirm) -->
    @if (Model.IsSimulatorEnabled)
    {
        <dialog id="bgp-fail-pay-dialog"
                class="bgp-confirm-dialog"
                aria-labelledby="fail-pay-dialog-title"
                aria-describedby="fail-pay-dialog-desc"
                data-testid="fail-payment-dialog">
            <div class="bgp-confirm-dialog__inner">
                <div class="bgp-confirm-dialog__head">
                    <span class="bgp-confirm-dialog__badge">Mô phỏng kết quả FAILED</span>
                </div>
                <h2 id="fail-pay-dialog-title" class="bgp-confirm-dialog__title">
                    Gửi callback từ chối thanh toán cho đơn #@Model.OrderCode?
                </h2>
                <p id="fail-pay-dialog-desc" class="bgp-confirm-dialog__desc">
                    Hệ thống sẽ ký gói tin <code>Outcome = FAILED</code> qua <code>HMAC-SHA256</code>: đơn hàng chuyển sang <strong>FAILED</strong>, không phát hành vé và giải phóng ngay <strong>@Model.Seats.Count ghế (@seatCodesText)</strong>.
                </p>
                <div class="bgp-confirm-dialog__summary">
                    @Model.MovieTitle &bull; @Model.RoomName &bull; @Model.TotalVnd.ToString("N0") đ
                </div>
                <div class="bgp-confirm-dialog__footer">
                    <button type="button"
                            class="bgp-btn bgp-btn--outline"
                            data-dialog-cancel
                            data-testid="dismiss-fail-payment-btn">
                        Quay lại thanh toán
                    </button>
                    <button type="button"
                            class="bgp-btn bgp-btn--primary"
                            data-dialog-confirm
                            data-testid="confirm-fail-payment-btn">
                        Xác nhận mô phỏng FAILED
                    </button>
                </div>
            </div>
        </dialog>
    }

    <!-- Accessible Confirmation <dialog> for Cancelling Hold from Checkout (Zero window.confirm) -->
    <dialog id="bgp-cancel-order-dialog"
            class="bgp-confirm-dialog"
            aria-labelledby="checkout-cancel-dialog-title"
            aria-describedby="checkout-cancel-dialog-desc"
            data-testid="cancel-order-dialog">
        <div class="bgp-confirm-dialog__inner">
            <div class="bgp-confirm-dialog__head">
                <span class="bgp-confirm-dialog__badge">Xác nhận hủy giữ chỗ</span>
            </div>
            <h2 id="checkout-cancel-dialog-title" class="bgp-confirm-dialog__title">
                Hủy đơn giữ ghế #@Model.OrderCode?
            </h2>
            <p id="checkout-cancel-dialog-desc" class="bgp-confirm-dialog__desc">
                Toàn bộ <strong>@Model.Seats.Count ghế (@seatCodesText)</strong> sẽ được nhả ngay về sơ đồ khán phòng và đơn hàng chuyển sang trạng thái <strong>CANCELLED</strong>.
            </p>
            <div class="bgp-confirm-dialog__summary">
                @Model.MovieTitle &bull; @Model.RoomName &bull; @Model.TotalVnd.ToString("N0") đ
            </div>
            <div class="bgp-confirm-dialog__footer">
                <button type="button"
                        class="bgp-btn bgp-btn--outline"
                        data-dialog-cancel
                        data-testid="dismiss-cancel-dialog-btn">
                    Giữ lại ghế &amp; tiếp tục
                </button>
                <button type="button"
                        class="bgp-btn bgp-btn--primary"
                        data-dialog-confirm
                        data-testid="confirm-cancel-order-btn">
                    Xác nhận hủy giữ chỗ
                </button>
            </div>
        </div>
    </dialog>
</div>

@section Scripts {
    <script type="module" src="~/js/modules/hold-countdown.js" asp-append-version="true"></script>
}
