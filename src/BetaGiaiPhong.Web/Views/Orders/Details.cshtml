@model BetaGiaiPhong.Web.Models.ViewModels.OrderDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Order.OrderCode}";
    var order = Model.Order;
    var badgeClass = order.OrderStatus switch
    {
        "PENDING_PAYMENT" when !order.IsHoldExpired => "bg-warning text-dark",
        "PENDING_PAYMENT" when order.IsHoldExpired => "bg-secondary",
        "PAID" => "bg-success",
        "CANCELLED" => "bg-danger",
        "EXPIRED" => "bg-secondary",
        "FAILED" => "bg-danger",
        _ => "bg-info text-dark"
    };

    var statusText = order.OrderStatus switch
    {
        "PENDING_PAYMENT" when !order.IsHoldExpired => "Chờ thanh toán",
        "PENDING_PAYMENT" when order.IsHoldExpired => "Hết hạn giữ chỗ",
        "PAID" => "Đã thanh toán",
        "CANCELLED" => "Đã hủy",
        "EXPIRED" => "Hết hạn",
        "FAILED" => "Thất bại",
        "NEEDS_REVIEW" => "Cần đối soát",
        _ => order.OrderStatus
    };
}

<div class="container mt-4 mb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">@order.OrderCode</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.FlashMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>✅ Thông báo:</strong> @Model.FlashMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.FlashError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>⚠️ Lỗi:</strong> @Model.FlashError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Order Header Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="h4 fw-bold mb-0">Đơn hàng: <span class="font-monospace text-primary">@order.OrderCode</span></h1>
                    <span class="badge @badgeClass fs-6">@statusText</span>
                </div>
                <p class="text-muted small mb-0">
                    Mã hệ thống: <strong>#@order.OrderId</strong> |
                    Ngày tạo: <strong>@order.CreatedUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC</strong>
                </p>
            </div>

            @if (order.OrderStatus == "PENDING_PAYMENT" && !order.IsHoldExpired)
            {
                <div class="border border-warning bg-warning bg-opacity-10 rounded p-3 text-center">
                    <span class="d-block small text-muted fw-bold">THỜI GIAN GIỮ CHỖ CÒN LẠI</span>
                    <span id="countdownTimer" class="h3 fw-bold text-danger font-monospace mb-0" data-remaining="@order.RemainingSeconds">
                        --:--
                    </span>
                </div>
            }
            else if (order.OrderStatus == "PENDING_PAYMENT" && order.IsHoldExpired)
            {
                <div class="border border-secondary bg-light rounded p-3 text-center">
                    <span class="d-block small text-muted fw-bold">TRẠNG THÁI GIỮ GHẾ</span>
                    <span class="badge bg-secondary fs-6">Đã hết hạn giữ chỗ</span>
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Movie & Screening Info -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h2 class="h5 fw-bold mb-0">Thông tin suất chiếu & Ghế ngồi</h2>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <span class="badge bg-primary mb-1">@order.RoomName</span>
                        <h3 class="h4 fw-bold text-dark mb-1">@order.MovieTitle</h3>
                        <p class="text-muted mb-0">
                            🕒 Thời gian chiếu: <strong>@order.StartVietnamText</strong> (Giờ Việt Nam)
                        </p>
                    </div>

                    <h4 class="h6 fw-bold text-uppercase text-secondary mb-3">Danh sách ghế đã giữ (@order.Seats.Count ghế)</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã ghế</th>
                                    <th>Hạng ghế</th>
                                    <th class="text-end">Đơn giá áp dụng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var seat in order.Seats)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-dark font-monospace px-2 py-1 fs-6">@seat.SeatCode</span>
                                        </td>
                                        <td>
                                            @if (seat.SeatTypeSnapshot == "VIP")
                                            {
                                                <span class="badge bg-danger">VIP</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Thường</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold">
                                            @seat.UnitPriceVnd.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment & Action Card -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h2 class="h5 fw-bold mb-0">Tóm tắt thanh toán</h2>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-semibold">@order.SubtotalVnd.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí tiện ích:</span>
                        <span class="fw-semibold">@order.FeeVnd.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Khuyến mãi / Giảm giá:</span>
                        <span class="text-success fw-semibold">-@order.DiscountVnd.ToString("N0") đ</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="h5 fw-bold mb-0">Tổng thanh toán:</span>
                        <span class="h4 fw-bold text-primary mb-0">@order.TotalVnd.ToString("N0") đ</span>
                    </div>

                    @if (order.OrderStatus == "PENDING_PAYMENT" && !order.IsHoldExpired)
                    {
                        <!-- Payment Notice for BE-02 -->
                        <div class="alert alert-info border mb-3" role="alert">
                            <h6 class="alert-heading fw-bold mb-1">💳 Thanh toán trực tuyến</h6>
                            <p class="small mb-0">
                                Chức năng thanh toán qua cổng điện tử và nhận vé điện tử QR Code sẽ được triển khai ở giai đoạn tiếp theo (BE-03).
                            </p>
                        </div>

                        <!-- Cancel Button Form -->
                        @if (order.CanCancel)
                        {
                            <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@order.OrderId" method="post" id="formCancelOrder">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger w-100 py-2" id="btnCancel" onclick="return confirm('Quý khách có chắc chắn muốn hủy đơn hàng này không? Ghế sẽ được giải phóng ngay lập tức.')">
                                    Hủy đơn giữ chỗ này
                                </button>
                            </form>
                        }
                    }
                    else if (order.OrderStatus == "PENDING_PAYMENT" && order.IsHoldExpired)
                    {
                        <div class="alert alert-secondary border mb-0 text-center" role="alert">
                            <p class="small mb-2">Đơn hàng này đã quá thời hạn giữ ghế 5 phút.</p>
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Showtimes" asp-action="Seats" asp-route-id="@order.ShowtimeId">
                                Chọn lại ghế cho suất chiếu này
                            </a>
                        </div>
                    }
                    else if (order.OrderStatus == "CANCELLED")
                    {
                        <div class="alert alert-danger border mb-0 text-center" role="alert">
                            <p class="small mb-0">Đơn hàng đã được hủy và toàn bộ ghế đã được giải phóng.</p>
                        </div>
                    }
                    else if (order.OrderStatus == "PAID")
                    {
                        <div class="alert alert-success border mb-0 text-center" role="alert">
                            <p class="small mb-0">Đơn hàng đã được thanh toán thành công.</p>
                        </div>
                    }
                </div>
            </div>

            <div>
                <a class="btn btn-light border w-100 py-2" asp-controller="Orders" asp-action="Index">
                    &larr; Quay lại danh sách đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var timerEl = document.getElementById('countdownTimer');
            if (!timerEl) return;

            var remaining = parseInt(timerEl.getAttribute('data-remaining'), 10) || 0;

            function updateTimer() {
                if (remaining <= 0) {
                    timerEl.textContent = '00:00 (Hết hạn)';
                    timerEl.classList.remove('text-danger');
                    timerEl.classList.add('text-muted');
                    var cancelBtn = document.getElementById('btnCancel');
                    if (cancelBtn) cancelBtn.disabled = true;
                    return;
                }

                var m = Math.floor(remaining / 60);
                var s = remaining % 60;
                var mStr = m < 10 ? '0' + m : m;
                var sStr = s < 10 ? '0' + s : s;

                timerEl.textContent = mStr + ':' + sStr;
                remaining--;
                setTimeout(updateTimer, 1000);
            }

            updateTimer();
        });
    </script>
}
