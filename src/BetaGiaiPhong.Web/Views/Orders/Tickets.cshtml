@model BetaGiaiPhong.Web.Models.ViewModels.OrderTicketsViewModel
@{
    ViewData["Title"] = $"Vé điện tử đơn hàng #{Model.OrderCode}";
}

<div class="container mt-4 mb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@Model.OrderCode</a></li>
            <li class="breadcrumb-item active" aria-current="page">Vé điện tử</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="card shadow-sm border-0 mb-4 bg-dark text-white">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge bg-warning text-dark font-monospace mb-2">BETA CINEMAS GIẢI PHÓNG</span>
                <h1 class="h3 fw-bold mb-1">🎟️ Vé Điện Tử Chính Thức</h1>
                <p class="mb-0 opacity-75">
                    Mã đơn hàng: <span class="font-monospace fw-bold text-info">@Model.OrderCode</span> |
                    Trạng thái: <span class="badge bg-success">Đã thanh toán (PAID)</span>
                </p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-light" onclick="window.print()">
                    🖨️ In vé
                </button>
                <a class="btn btn-light" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">
                    Chi tiết đơn hàng
                </a>
            </div>
        </div>
    </div>

    <!-- Movie & Showtime Info Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h2 class="h5 fw-bold mb-0 text-dark">🎬 @Model.MovieTitle</h2>
            </div>
            <div class="d-flex gap-3 text-muted small flex-wrap">
                <span>🏛️ Phòng chiếu: <strong class="text-dark">@Model.RoomName</strong></span>
                <span>🕒 Suất chiếu: <strong class="text-dark">@Model.FormattedStartUtc</strong></span>
                <span>🎫 Số lượng: <strong class="text-dark">@Model.Tickets.Count vé</strong></span>
            </div>
        </div>
    </div>

    <!-- Tickets Grid (Boarding Pass Cards) -->
    <div class="row g-4 mb-4">
        @foreach (var ticket in Model.Tickets)
        {
            <div class="col-md-6 col-lg-6">
                <div class="card shadow-sm border-0 h-100 position-relative overflow-hidden ticket-card">
                    <!-- Ticket Header Banner -->
                    <div class="p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                        <span class="small text-uppercase fw-bold opacity-75">VÉ XEM PHIM ĐIỆN TỬ</span>
                        <span class="badge @(ticket.Status == "ISSUED" ? "bg-success" : "bg-secondary")">
                            @(ticket.Status == "ISSUED" ? "HỢP LỆ / CHƯA SOÁT" : "ĐÃ SOÁT VÉ (USED)")
                        </span>
                    </div>

                    <div class="card-body p-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-4">
                        <!-- Left Details -->
                        <div class="flex-grow-1">
                            <div class="mb-3">
                                <span class="small text-muted d-block">Mã vé (Ticket Code)</span>
                                <span class="font-monospace fw-bold text-dark fs-6">@ticket.TicketCode</span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <span class="small text-muted d-block">Ghế ngồi</span>
                                    <span class="badge bg-dark font-monospace fs-4 px-3 py-1">@ticket.SeatCode</span>
                                </div>
                                <div class="col-6">
                                    <span class="small text-muted d-block">Loại ghế</span>
                                    @if (ticket.SeatType == "VIP")
                                    {
                                        <span class="badge bg-danger fs-6 px-2 py-1">VIP</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary fs-6 px-2 py-1">Thường</span>
                                    }
                                </div>
                            </div>

                            <div class="mb-2">
                                <span class="small text-muted d-block">Giá vé</span>
                                <span class="fw-bold text-primary fs-5">@ticket.PriceVnd.ToString("N0") đ</span>
                            </div>

                            <p class="small text-muted mb-0">
                                Phát hành: <strong>@ticket.IssuedUtc.ToString("dd/MM/yyyy HH:mm")</strong>
                            </p>
                        </div>

                        <!-- Right QR Code Box -->
                        <div class="text-center p-2 bg-light rounded border flex-shrink-0">
                            <img src="@ticket.QrCodeUrl" alt="Mã QR soát vé @ticket.TicketCode" class="img-fluid bg-white p-1 rounded" style="width: 140px; height: 140px; display: block;" />
                            <span class="d-block small text-muted font-monospace mt-1" style="font-size: 0.7rem;">MÃ SOÁT VÉ QR</span>
                        </div>
                    </div>

                    <!-- Card Footer -->
                    <div class="card-footer bg-white border-top small text-muted text-center py-2">
                        <span>ℹ️ Xuất trình mã QR tại cổng soát vé trước giờ chiếu 15 phút.</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Return to list -->
    <div class="text-center">
        <a class="btn btn-outline-secondary px-4 py-2" asp-controller="Orders" asp-action="Index">
            &larr; Quay lại danh sách đơn hàng
        </a>
    </div>
</div>
