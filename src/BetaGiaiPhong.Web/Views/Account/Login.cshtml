@model BetaGiaiPhong.Web.Models.ViewModels.LoginViewModel
@{
    Layout = "_CinemaLayout";
    ViewData["HeaderOverlay"] = false;
    ViewData["Title"] = "Đăng nhập hệ thống";

    bool hasReturnUrl = !string.IsNullOrWhiteSpace(Model.Request.ReturnUrl) && Url.IsLocalUrl(Model.Request.ReturnUrl);
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-account.css" asp-append-version="true" />
}

<section class="bgp-auth-stage" data-testid="login-page">
    <div class="bgp-auth-card">
        <header class="bgp-auth-head">
            <span class="bgp-auth-head__eyebrow">BETA GIẢI PHÓNG CINEMA</span>
            <h1 class="bgp-auth-head__title">Đăng nhập</h1>
            <p class="bgp-auth-head__sub">
                Đăng nhập để giữ ghế, nhận vé điện tử QR hoặc truy cập Console Vận hành rạp.
            </p>
        </header>

        @if (hasReturnUrl)
        {
            <div class="bgp-auth-return-note" role="status" data-testid="login-return-url-note">
                <span aria-hidden="true">&#8617;</span>
                <span>Sau khi đăng nhập thành công, hệ thống sẽ tự động đưa bạn quay lại trang đang thực hiện.</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bgp-auth-error" role="alert" data-testid="login-error-alert">
                <span aria-hidden="true">&#9888;</span>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form id="bgp-login-form"
              class="bgp-auth-form"
              asp-controller="Account"
              asp-action="Login"
              method="post"
              novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Request.ReturnUrl" />

            <div class="bgp-auth-field">
                <label asp-for="Request.Email" class="bgp-auth-label">Địa chỉ Email</label>
                <input asp-for="Request.Email"
                       class="bgp-auth-input"
                       placeholder="vidu@demo.invalid"
                       autocomplete="username" />
                <span asp-validation-for="Request.Email"></span>
            </div>

            <div class="bgp-auth-field">
                <label asp-for="Request.Password" class="bgp-auth-label">Mật khẩu</label>
                <input asp-for="Request.Password"
                       class="bgp-auth-input"
                       placeholder="••••••••••••"
                       autocomplete="current-password" />
                <span asp-validation-for="Request.Password"></span>
            </div>

            <div class="bgp-auth-check-row">
                <input asp-for="Request.RememberMe" class="bgp-auth-checkbox" />
                <label asp-for="Request.RememberMe" class="bgp-auth-check-label">
                    Ghi nhớ đăng nhập trên thiết bị này
                </label>
            </div>

            <button type="submit" class="bgp-auth-submit" data-testid="login-submit-btn">
                Đăng nhập
            </button>
        </form>

        @if (Model.IsDevelopment)
        {
            <aside class="bgp-demo-picker"
                   aria-label="Chọn nhanh tài khoản mô phỏng học thuật"
                   data-testid="dev-demo-account-picker">
                <div class="bgp-demo-picker__head">
                    <span class="bgp-demo-picker__title">Tài khoản thử nghiệm (Demo Seed)</span>
                    <span class="bgp-demo-picker__env">Development Only</span>
                </div>
                <p class="bgp-demo-picker__hint">
                    Nhấn vào vai trò bên dưới để điền nhanh địa chỉ email, sau đó nhập mật khẩu thử nghiệm đã cấu hình.
                </p>
                <div class="bgp-demo-picker__grid">
                    <button type="button"
                            class="bgp-demo-chip"
                            data-demo-email="customer1@demo.invalid"
                            data-testid="demo-chip-customer1">
                        <span class="bgp-demo-chip__role">Khách hàng 1</span>
                        <span class="bgp-demo-chip__email">customer1@demo.invalid</span>
                    </button>
                    <button type="button"
                            class="bgp-demo-chip"
                            data-demo-email="customer2@demo.invalid"
                            data-testid="demo-chip-customer2">
                        <span class="bgp-demo-chip__role">Khách hàng 2</span>
                        <span class="bgp-demo-chip__email">customer2@demo.invalid</span>
                    </button>
                    <button type="button"
                            class="bgp-demo-chip"
                            data-demo-email="staff@demo.invalid"
                            data-testid="demo-chip-staff">
                        <span class="bgp-demo-chip__role">Nhân viên Soát vé</span>
                        <span class="bgp-demo-chip__email">staff@demo.invalid</span>
                    </button>
                    <button type="button"
                            class="bgp-demo-chip"
                            data-demo-email="manager@demo.invalid"
                            data-testid="demo-chip-manager">
                        <span class="bgp-demo-chip__role">Quản lý Rạp</span>
                        <span class="bgp-demo-chip__email">manager@demo.invalid</span>
                    </button>
                </div>
            </aside>
        }
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/modules/account-login.js" asp-append-version="true"></script>
}
