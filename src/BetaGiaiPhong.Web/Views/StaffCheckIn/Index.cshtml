@model BetaGiaiPhong.Web.Models.ViewModels.StaffCheckInIndexViewModel
@{
    ViewData["Title"] = "Màn hình Soát vé QR";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <header class="bgp-ops-header">
        <div class="bgp-ops-header__main">
            <div class="bgp-ops-eyebrow">GATE OPERATIONS • AES-256-GCM VERIFICATION</div>
            <h1 class="bgp-ops-title">Màn hình Soát vé Điện tử</h1>
            <p class="bgp-ops-subtitle">
                Bàn kiểm soát cổng vào thời gian thực dành cho nhân sự soát vé — hỗ trợ camera trực tiếp, tải ảnh vé điện tử và đầu đọc mã vạch 2D USB.
            </p>
        </div>
        <div class="bgp-ops-actions">
            <button id="btnToggleSound"
                    type="button"
                    class="bgp-btn bgp-btn--glass bgp-btn--sm"
                    aria-pressed="false"
                    data-testid="toggle-scan-sound-btn">
                <span data-sound-label>Âm báo: Tắt</span>
            </button>
            <a asp-action="History" class="bgp-btn bgp-btn--outline bgp-btn--sm">
                Xem lịch sử soát vé
            </a>
        </div>
    </header>

    @Html.AntiForgeryToken()

    <div class="bgp-gate-grid">
        <!-- Cột trái: Chọn Suất Chiếu, Camera / Ảnh QR & Máy Quét USB -->
        <div>
            <!-- 1. Chọn Suất Chiếu -->
            <section class="bgp-ops-card" aria-labelledby="gate-step1-heading">
                <div class="bgp-ops-card__header">
                    <h2 id="gate-step1-heading" class="bgp-ops-card__title">1. Chọn Suất Chiếu Kiểm Soát</h2>
                    <span class="badge bgp-ops-badge bgp-ops-badge--info">Khung soát vé: Trước 30p &rarr; Kết thúc</span>
                </div>
                <div class="bgp-ops-card__body">
                    @if (!Model.Showtimes.Any())
                    {
                        <div class="bgp-ops-alert bgp-ops-alert--warning" role="status" style="margin-bottom:0;">
                            <span>Hiện không có suất chiếu nào đang mở bán hoặc nằm gần khung giờ chiếu. Vui lòng kiểm tra lại lịch chiếu.</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <label for="showtimeSelect" class="bgp-ops-label">Suất chiếu cần soát vé</label>
                            <select id="showtimeSelect" class="bgp-ops-select">
                                @foreach (var st in Model.Showtimes)
                                {
                                    <option value="@st.ShowtimeId" selected="@(st.ShowtimeId == Model.SelectedShowtimeId)">
                                        @st.DisplayText (@st.SoldTickets/@st.TotalCapacity vé đã bán)
                                    </option>
                                }
                            </select>
                            <div class="bgp-ops-hint">
                                Quy tắc cổng rạp: Vé chỉ được chấp nhận (<code>ACCEPTED</code>) khi khớp chính xác suất chiếu đang chọn.
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- 2. Quét QR Camera & Tải Ảnh -->
            <section class="bgp-ops-card" aria-labelledby="gate-step2-heading">
                <div class="bgp-ops-card__header">
                    <h2 id="gate-step2-heading" class="bgp-ops-card__title">2. Quét Mã QR Bằng Camera Hoặc Ảnh Vé</h2>
                    <div class="bgp-ops-actions">
                        <button id="btnStartCamera" type="button" class="bgp-btn bgp-btn--primary bgp-btn--sm">
                            Bật Camera
                        </button>
                        <button id="btnStopCamera" type="button" class="bgp-btn bgp-btn--danger bgp-btn--sm" disabled>
                            Tắt Camera
                        </button>
                    </div>
                </div>
                <div class="bgp-ops-card__body">
                    <div id="cameraErrorBanner"
                         class="bgp-ops-alert bgp-ops-alert--danger alert-danger is-hidden"
                         role="alert"
                         data-testid="camera-error-banner">
                        <span id="cameraErrorText">Không thể khởi động camera.</span>
                        <button id="btnDismissCameraError"
                                type="button"
                                class="bgp-ops-alert__close"
                                aria-label="Đóng thông báo lỗi camera">&times;</button>
                    </div>

                    <div id="reader-container" class="bgp-camera-stage">
                        <div id="reader" style="width: 100%;"></div>
                        <div id="camera-placeholder" class="bgp-camera-placeholder">
                            <div style="margin-bottom: 10px; color: var(--bgp-text-muted);">
                                <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
                                    <circle cx="12" cy="13" r="3"></circle>
                                </svg>
                            </div>
                            <p style="margin: 0; font-size: 0.9rem;">
                                Nhấn <strong>&ldquo;Bật Camera&rdquo;</strong> để quét trực tiếp hoặc chọn ảnh vé QR bên dưới
                            </p>
                        </div>
                    </div>

                    <!-- Dedicated offscreen container for deterministic file scanning (isolated from #reader camera DOM) -->
                    <div id="qrFileScratch"
                         aria-hidden="true"
                         style="position: fixed; left: -9999px; top: -9999px; width: 640px; height: 640px; overflow: hidden; pointer-events: none;"></div>

                    <div class="bgp-qr-upload-zone">
                        <div>
                            <div style="font-size: 0.84rem; font-weight: 700; color: #FFFFFF;">
                                Tải ảnh mã QR từ thiết bị kiểm thử / quầy hỗ trợ
                            </div>
                            <div id="qrUploadFileName" class="bgp-ops-hint" style="margin-top: 2px;">
                                Hỗ trợ PNG, JPG, WEBP từ vé điện tử
                            </div>
                        </div>
                        <div>
                            <input type="file"
                                   id="qrFileInput"
                                   class="bgp-sr-file-input"
                                   accept="image/*" />
                            <label for="qrFileInput" class="bgp-qr-upload-btn">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                <span>Chọn ảnh mã QR</span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. Quét Thủ Công / Máy Quét Cầm Tay USB -->
            <section class="bgp-ops-card" aria-labelledby="gate-step3-heading" style="margin-bottom:0;">
                <div class="bgp-ops-card__header">
                    <h2 id="gate-step3-heading" class="bgp-ops-card__title">3. Nhập Token / Đầu Đọc Mã Vạch 2D USB</h2>
                </div>
                <div class="bgp-ops-card__body">
                    <form id="manualScanForm" class="bgp-manual-scan-form">
                        <div>
                            <label for="manualQrToken" class="bgp-sr-only">Chuỗi mã QR token</label>
                            <input type="text"
                                   id="manualQrToken"
                                   class="bgp-ops-input bgp-ops-mono"
                                   placeholder="Dán mã QR token hoặc quét qua đầu đọc 2D USB..."
                                   autocomplete="off" />
                        </div>
                        <button type="submit" class="bgp-btn bgp-btn--outline" id="btnManualSubmit">
                            Soát vé
                        </button>
                    </form>
                    <div class="bgp-ops-hint">
                        Tương thích đầu đọc mã vạch 2D cổng USB chế độ HID Keyboard (tự động điền chuỗi và gửi lệnh).
                    </div>
                </div>
            </section>
        </div>

        <!-- Cột phải: Kết Quả Soát Vé Thời Gian Thực -->
        <aside class="bgp-gate-sticky" aria-live="polite">
            <section class="bgp-ops-card" style="margin-bottom:0;">
                <div class="bgp-ops-card__header">
                    <h2 class="bgp-ops-card__title">Kết Quả Soát Vé</h2>
                    <span id="scanStatusBadge" class="badge bgp-ops-badge bgp-ops-badge--slate">Chờ quét...</span>
                </div>
                <div class="bgp-ops-card__body">
                    <div id="resultCard">
                        <div class="bgp-gate-result-box">
                            <div style="margin-bottom: 10px; color: var(--bgp-text-muted);">
                                <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                    <path d="M14 14h3v3h-3zM18 18h3v3h-3zM14 19h2M19 14v2"></path>
                                </svg>
                            </div>
                            <h3 class="bgp-gate-result__heading" style="font-size: 1.05rem;">Chưa có lượt quét nào</h3>
                            <p class="bgp-gate-result__msg" style="margin-bottom: 0;">
                                Hãy chọn đúng suất chiếu và quét mã QR của khách hàng để kiểm tra vé hợp lệ.
                            </p>
                        </div>
                    </div>

                    <div id="ticketDetailsCard" class="bgp-ticket-kv-card is-hidden">
                        <h3 style="margin: 0 0 10px; font-size: 0.86rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--bgp-text-secondary);">
                            Thông Tin Chi Tiết Vé
                        </h3>
                        <ul class="bgp-ticket-kv-list">
                            <li class="bgp-ticket-kv-item">
                                <span class="bgp-ticket-kv-label">Mã vé</span>
                                <strong id="resTicketCode" class="bgp-ticket-kv-val bgp-ops-mono">-</strong>
                            </li>
                            <li class="bgp-ticket-kv-item">
                                <span class="bgp-ticket-kv-label">Phim</span>
                                <strong id="resMovieTitle" class="bgp-ticket-kv-val">-</strong>
                            </li>
                            <li class="bgp-ticket-kv-item">
                                <span class="bgp-ticket-kv-label">Phòng chiếu</span>
                                <strong id="resRoomName" class="bgp-ticket-kv-val">-</strong>
                            </li>
                            <li class="bgp-ticket-kv-item">
                                <span class="bgp-ticket-kv-label">Ghế ngồi</span>
                                <strong id="resSeatLabel" class="bgp-seat-callout">-</strong>
                            </li>
                            <li class="bgp-ticket-kv-item">
                                <span class="bgp-ticket-kv-label">Giờ bắt đầu</span>
                                <strong id="resShowtime" class="bgp-ticket-kv-val bgp-ops-mono">-</strong>
                            </li>
                            <li class="bgp-ticket-kv-item">
                                <span class="bgp-ticket-kv-label">Thời điểm quét</span>
                                <span id="resScannedTime" class="bgp-ticket-kv-val bgp-ops-mono">-</span>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="bgp-ops-card__footer">
                    <span class="bgp-ops-hint" style="margin:0;">
                        Xác thực mật mã học một chiều SHA-256 &amp; giải mã bộ nhớ trong AES-256-GCM.
                    </span>
                </div>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
    <script type="module" src="~/js/modules/qr-scanner.js" asp-append-version="true"></script>
}
