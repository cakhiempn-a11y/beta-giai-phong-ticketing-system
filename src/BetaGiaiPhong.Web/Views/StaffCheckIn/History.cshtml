@model BetaGiaiPhong.Web.Models.ViewModels.StaffCheckInHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử Soát vé";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <header class="bgp-ops-header">
        <div class="bgp-ops-header__main">
            <div class="bgp-ops-eyebrow">GATE AUDIT TRAIL • TICKETSCANS & AUDITLOGS</div>
            <h1 class="bgp-ops-title">Nhật Ký & Lịch Sử Soát Vé</h1>
            <p class="bgp-ops-subtitle">
                Truy vết toàn bộ lượt quét mã QR tại cổng rạp theo thời gian thực (múi giờ nghiệp vụ UTC+7), không lưu lộ chuỗi token gốc.
            </p>
        </div>
        <div class="bgp-ops-actions">
            <a asp-action="Index" class="bgp-btn bgp-btn--primary bgp-btn--sm">
                Quay lại Màn hình Soát vé
            </a>
        </div>
    </header>

    <!-- Bộ lọc suất chiếu và kết quả -->
    <div class="bgp-ops-filter-bar">
        <form method="get" asp-action="History" class="bgp-ops-filter-grid">
            <div>
                <label for="filterShowtime" class="bgp-ops-label">Lọc theo suất chiếu</label>
                <select id="filterShowtime" name="showtimeId" class="bgp-ops-select">
                    <option value="">-- Tất cả các suất chiếu --</option>
                    @foreach (var st in Model.Showtimes)
                    {
                        <option value="@st.ShowtimeId" selected="@(st.ShowtimeId == Model.SelectedShowtimeId)">
                            @st.DisplayText
                        </option>
                    }
                </select>
            </div>
            <div>
                <label for="filterOutcome" class="bgp-ops-label">Kết quả soát vé</label>
                <select id="filterOutcome" name="outcome" class="bgp-ops-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedOutcome))">-- Tất cả kết quả --</option>
                    <option value="ACCEPTED" selected="@(Model.SelectedOutcome == "ACCEPTED")">HỢP LỆ (ACCEPTED)</option>
                    <option value="ALREADY_USED" selected="@(Model.SelectedOutcome == "ALREADY_USED")">ĐÃ DÙNG (ALREADY_USED)</option>
                    <option value="WRONG_SHOWTIME" selected="@(Model.SelectedOutcome == "WRONG_SHOWTIME")">SAI SUẤT (WRONG_SHOWTIME)</option>
                    <option value="OUTSIDE_WINDOW" selected="@(Model.SelectedOutcome == "OUTSIDE_WINDOW")">NGOÀI GIỜ (OUTSIDE_WINDOW)</option>
                    <option value="NOT_FOUND" selected="@(Model.SelectedOutcome == "NOT_FOUND")">KHÔNG TỒN TẠI (NOT_FOUND)</option>
                </select>
            </div>
            <div class="bgp-ops-filter-actions">
                <button type="submit" class="bgp-btn bgp-btn--primary bgp-btn--sm">Lọc dữ liệu</button>
                @if (Model.SelectedShowtimeId.HasValue || !string.IsNullOrEmpty(Model.SelectedOutcome))
                {
                    <a asp-action="History" class="bgp-btn bgp-btn--outline bgp-btn--sm">Xóa lọc</a>
                }
            </div>
        </form>
    </div>

    <!-- Bảng dữ liệu lịch sử quét -->
    <section class="bgp-ops-card">
        <div class="bgp-ops-card__header">
            <h2 class="bgp-ops-card__title">Danh Sách Lượt Soát Vé (@Model.TotalCount lượt ghi nhận)</h2>
            <span class="badge bgp-ops-badge bgp-ops-badge--slate">Trang @Model.CurrentPage / @Model.TotalPages</span>
        </div>
        <div class="bgp-ops-card__body bgp-ops-card__body--flush">
            <div class="bgp-ops-table-wrap">
                <table class="bgp-ops-table">
                    <thead>
                        <tr>
                            <th scope="col">Thời gian (UTC+7)</th>
                            <th scope="col">Kết quả</th>
                            <th scope="col">Mã vé</th>
                            <th scope="col">Phim / Phòng</th>
                            <th scope="col">Ghế</th>
                            <th scope="col">Nhân viên soát</th>
                            <th scope="col">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="7" class="is-center" style="padding: 36px 16px; color: var(--bgp-text-muted);">
                                    Chưa có dữ liệu soát vé nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="bgp-ops-mono" style="white-space: nowrap;">@item.FormattedScannedTime</td>
                                    <td>
                                        @switch (item.Outcome)
                                        {
                                            case "ACCEPTED":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--emerald">HỢP LỆ (ACCEPTED)</span>
                                                break;
                                            case "ALREADY_USED":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--amber">ĐÃ DÙNG (ALREADY_USED)</span>
                                                break;
                                            case "WRONG_SHOWTIME":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--amber">SAI SUẤT (WRONG_SHOWTIME)</span>
                                                break;
                                            case "OUTSIDE_WINDOW":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--slate">NGOÀI GIỜ (OUTSIDE_WINDOW)</span>
                                                break;
                                            case "NOT_FOUND":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--danger">KHÔNG TỒN TẠI (NOT_FOUND)</span>
                                                break;
                                            case "REJECTED":
                                            default:
                                                <span class="badge bgp-ops-badge bgp-ops-badge--danger">TỪ CHỐI (@item.Outcome)</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.TicketCode))
                                        {
                                            <code class="bgp-inline-code">@item.TicketCode</code>
                                        }
                                        else
                                        {
                                            <span style="color: var(--bgp-text-muted);">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.MovieTitle))
                                        {
                                            <div style="font-weight: 700; color: #FFFFFF;">@item.MovieTitle</div>
                                            <div class="bgp-ops-movie-sub">@item.RoomName</div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--bgp-text-muted);">Không xác định</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.SeatLabel))
                                        {
                                            <span class="badge bgp-ops-badge bgp-ops-badge--info bgp-ops-mono">@item.SeatLabel</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--bgp-text-muted);">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span style="font-weight: 600; color: var(--bgp-text-primary);">@item.StaffName</span>
                                    </td>
                                    <td>
                                        <span>@item.Details</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="bgp-ops-card__footer">
                <span class="bgp-ops-hint" style="margin:0;">
                    Hiển thị trang @Model.CurrentPage / @Model.TotalPages
                </span>
                <nav aria-label="Phân trang lịch sử soát vé">
                    <ul class="bgp-ops-pagination">
                        <li>
                            <a class="bgp-ops-page-link @(Model.CurrentPage <= 1 ? "is-disabled" : "")"
                               asp-action="History"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-showtimeId="@Model.SelectedShowtimeId"
                               asp-route-outcome="@Model.SelectedOutcome">&laquo; Trước</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li>
                                <a class="bgp-ops-page-link @(p == Model.CurrentPage ? "is-active" : "")"
                                   asp-action="History"
                                   asp-route-page="@p"
                                   asp-route-showtimeId="@Model.SelectedShowtimeId"
                                   asp-route-outcome="@Model.SelectedOutcome">@p</a>
                            </li>
                        }
                        <li>
                            <a class="bgp-ops-page-link @(Model.CurrentPage >= Model.TotalPages ? "is-disabled" : "")"
                               asp-action="History"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-showtimeId="@Model.SelectedShowtimeId"
                               asp-route-outcome="@Model.SelectedOutcome">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</div>
