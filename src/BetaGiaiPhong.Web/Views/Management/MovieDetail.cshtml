@model BetaGiaiPhong.Web.Models.ViewModels.ManageMovieDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết phim: {Model.Movie.Title}";
    var m = Model.Movie;
    bool hasExternalProvenance = !string.IsNullOrWhiteSpace(m.WikidataQid) || !string.IsNullOrWhiteSpace(m.ImdbId) || m.TmdbId.HasValue;
    var ageMod = (m.AgeLabel ?? "").ToUpperInvariant() switch
    {
        "P" => "bgp-ops-age--p",
        "K" => "bgp-ops-age--k",
        "T13" => "bgp-ops-age--t13",
        "T16" => "bgp-ops-age--t16",
        "T18" => "bgp-ops-age--t18",
        "C" => "bgp-ops-age--c",
        _ => "bgp-ops-age--unset"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <ol class="bgp-ops-breadcrumb" aria-label="Breadcrumb">
        <li><a asp-action="Movies">Danh mục Phim</a></li>
        <li class="bgp-ops-breadcrumb__sep" aria-hidden="true">/</li>
        <li aria-current="page">@m.Title</li>
    </ol>

    @if (TempData["Success"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--success" role="status">
            <span>@TempData["Success"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--warning" role="status">
            <span>@TempData["Warning"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--danger alert-danger" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }

    <!-- Movie Profile & Provenance Card -->
    <section class="bgp-ops-card">
        <div class="bgp-ops-card__body">
            <div class="bgp-ops-movie-hero">
                <div class="bgp-ops-poster-frame @(string.IsNullOrWhiteSpace(m.PosterUrl) ? "" : "bgp-ops-poster-frame--has-img")">
                    @if (!string.IsNullOrWhiteSpace(m.PosterUrl))
                    {
                        <img src="@m.PosterUrl"
                             alt="@m.Title"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <div style="display:none; flex-direction:column; align-items:center; gap:6px; padding:14px;">
                            <strong style="color:#FFFFFF;">@m.Title</strong>
                            <span class="bgp-ops-hint">Poster chưa khả dụng</span>
                        </div>
                    }
                    else
                    {
                        <strong style="color:#FFFFFF; font-size:0.9rem;">@m.Title</strong>
                        <span class="bgp-ops-hint">Chưa cấu hình Poster</span>
                    }
                </div>

                <div>
                    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:12px;">
                        <div>
                            <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:6px;">
                                <span class="badge bgp-ops-badge bgp-ops-badge--slate bgp-ops-mono">Mã phim: #@m.MovieId</span>
                                @if (!string.IsNullOrWhiteSpace(m.AgeLabel))
                                {
                                    <span class="bgp-ops-age @ageMod">@m.AgeLabel</span>
                                }
                                else
                                {
                                    <span class="bgp-ops-age bgp-ops-age--unset">Chưa phân loại độ tuổi VN</span>
                                }
                            </div>
                            <h1 class="bgp-ops-title">@m.Title</h1>
                            @if (!string.IsNullOrWhiteSpace(m.OriginalTitle) && !string.Equals(m.OriginalTitle, m.Title, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="bgp-ops-movie-sub" style="font-size: 0.9rem; margin-top: 4px;">
                                    Tựa gốc: <strong style="color: var(--bgp-text-primary);">@m.OriginalTitle</strong>
                                    @if (m.ReleaseYear.HasValue)
                                    {
                                        <span> (@m.ReleaseYear)</span>
                                    }
                                </div>
                            }
                            <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:8px; font-size:0.86rem; color:var(--bgp-text-secondary);">
                                <span><strong style="color:#FFFFFF;">@m.DurationMin phút</strong></span>
                                <span>&bull;</span>
                                <span>@(string.IsNullOrWhiteSpace(m.GenreText) ? "Chưa phân loại thể loại" : m.GenreText)</span>
                                @if (!string.IsNullOrWhiteSpace(m.DirectorNames))
                                {
                                    <span>&bull;</span>
                                    <span>Đạo diễn: <strong style="color:#FFFFFF;">@m.DirectorNames</strong></span>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.OriginCountry))
                                {
                                    <span>&bull;</span>
                                    <span>@m.OriginCountry</span>
                                }
                            </div>
                        </div>

                        <div>
                            @switch (m.Status)
                            {
                                case "PUBLISHED":
                                    <span class="badge bgp-ops-badge bgp-ops-badge--emerald bgp-ops-badge--lg">PUBLISHED</span>
                                    break;
                                case "ARCHIVED":
                                    <span class="badge bgp-ops-badge bgp-ops-badge--slate bgp-ops-badge--lg">ARCHIVED</span>
                                    break;
                                default:
                                    <span class="badge bgp-ops-badge bgp-ops-badge--amber bgp-ops-badge--lg">DRAFT</span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Provenance & Sync Metadata Strip -->
                    <div class="bgp-override-box" style="margin-bottom: 16px;" data-testid="movie-provenance-card">
                        <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:8px;">
                            <span style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--bgp-text-muted);">
                                Nguồn gốc &amp; Định danh xác minh
                            </span>
                            @if (m.ExternalSyncedUtc.HasValue)
                            {
                                <span class="bgp-ops-hint bgp-ops-mono" style="margin:0;">
                                    Đồng bộ gần nhất: @m.ExternalSyncedUtc.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm") (VN)
                                </span>
                            }
                        </div>
                        <div class="bgp-ops-id-list" style="margin-top: 8px;">
                            @if (!string.IsNullOrWhiteSpace(m.WikidataQid))
                            {
                                <span class="bgp-ops-id-chip">Wikidata: @m.WikidataQid</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.ImdbId))
                            {
                                <span class="bgp-ops-id-chip">IMDb: @m.ImdbId</span>
                            }
                            @if (m.TmdbId.HasValue)
                            {
                                <span class="bgp-ops-id-chip">TMDB: #@m.TmdbId</span>
                            }
                            @if (m.RatingValue.HasValue)
                            {
                                <span class="badge bgp-ops-badge bgp-ops-badge--gold bgp-ops-mono">
                                    @(m.RatingSource == "TMDB" ? "TMDB" : "IMDb") @m.RatingValue.Value.ToString("0.0")
                                    @if (m.RatingVoteCount.HasValue)
                                    {
                                        <span>(@m.RatingVoteCount.Value.ToString("N0") lượt)</span>
                                    }
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.ArtworkSource))
                            {
                                <span class="bgp-ops-id-chip">Hình ảnh: @m.ArtworkSource</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.ArtworkLicenseText))
                            {
                                <span class="bgp-ops-id-chip">@m.ArtworkLicenseText</span>
                            }
                            @if (!hasExternalProvenance)
                            {
                                <span class="bgp-ops-hint" style="margin:0;">Hồ sơ biên tập nội bộ — có thể gắn mã Wikidata/IMDb/TMDB trong mục Chỉnh sửa.</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(m.ManualOverrideMask))
                        {
                            <div style="margin-top: 8px;">
                                <span class="bgp-ops-lock-pill" data-testid="active-override-mask">
                                    Khóa bảo toàn thủ công: @m.ManualOverrideMask
                                </span>
                            </div>
                        }
                    </div>

                    <div style="margin-bottom: 18px;">
                        <h3 style="margin: 0 0 6px; font-size: 0.84rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--bgp-text-muted);">
                            Tóm tắt nội dung
                        </h3>
                        <p style="margin: 0; color: var(--bgp-text-primary); line-height: 1.6; white-space: pre-line;">@(string.IsNullOrWhiteSpace(m.Synopsis) ? "Chưa có thông tin tóm tắt." : m.Synopsis)</p>
                    </div>

                    <!-- Lifecycle & Sync Action Bar -->
                    <div class="bgp-ops-actions" style="padding-top: 14px; border-top: 1px solid var(--bgp-border-subtle);">
                        <a asp-action="MovieEdit" asp-route-id="@m.MovieId" class="bgp-btn bgp-btn--outline bgp-btn--sm">
                            Chỉnh sửa thông tin
                        </a>

                        @if (hasExternalProvenance)
                        {
                            <form method="post" asp-action="SyncExternalMovie" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TargetMovieId" value="@m.MovieId" />
                                @if (m.TmdbId.HasValue)
                                {
                                    <input type="hidden" name="TmdbId" value="@m.TmdbId" />
                                }
                                <button type="submit"
                                        class="bgp-btn bgp-btn--glass bgp-btn--sm"
                                        data-testid="detail-resync-external-btn">
                                    Đồng bộ lại từ nguồn xác minh
                                </button>
                            </form>
                        }

                        @if (m.Status == "DRAFT")
                        {
                            <form method="post" asp-action="MoviePublish" asp-route-id="@m.MovieId" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bgp-btn bgp-btn--primary bgp-btn--sm">
                                    Xuất bản phim (PUBLISH)
                                </button>
                            </form>
                        }

                        @if (m.Status == "PUBLISHED")
                        {
                            <a asp-action="ShowtimeCreate" asp-route-movieId="@m.MovieId" class="bgp-btn bgp-btn--primary bgp-btn--sm">
                                + Lên lịch suất chiếu
                            </a>

                            <form method="post"
                                  asp-action="MovieArchive"
                                  asp-route-id="@m.MovieId"
                                  data-confirm-dialog="archiveMovieDialog"
                                  style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bgp-btn bgp-btn--danger bgp-btn--sm">
                                    Lưu trữ phim (ARCHIVE)
                                </button>
                            </form>
                        }

                        @if (m.Status == "ARCHIVED")
                        {
                            <span class="bgp-ops-hint" style="margin:0;">
                                (Phim đã lưu trữ — không thể công bố thêm suất chiếu mới.)
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Associated Showtimes -->
    <section class="bgp-ops-card">
        <div class="bgp-ops-card__header">
            <h3 class="bgp-ops-card__title">Danh sách suất chiếu của phim (@Model.Showtimes.Count)</h3>
            @if (m.Status == "PUBLISHED")
            {
                <a asp-action="ShowtimeCreate" asp-route-movieId="@m.MovieId" class="bgp-btn bgp-btn--outline bgp-btn--sm">
                    + Thêm suất chiếu
                </a>
            }
        </div>
        <div class="bgp-ops-card__body bgp-ops-card__body--flush">
            @if (Model.Showtimes.Count == 0)
            {
                <div style="padding: 36px 16px; text-align: center; color: var(--bgp-text-muted);">
                    Chưa có suất chiếu nào được tạo cho phim này.
                </div>
            }
            else
            {
                <div class="bgp-ops-table-wrap">
                    <table class="bgp-ops-table">
                        <thead>
                            <tr>
                                <th>Mã suất</th>
                                <th>Phòng chiếu</th>
                                <th>Thời gian bắt đầu (VN)</th>
                                <th>Thời gian kết thúc (VN)</th>
                                <th>Trạng thái</th>
                                <th class="is-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Showtimes.OrderByDescending(st => st.StartUtc))
                            {
                                <tr>
                                    <td class="bgp-ops-mono">#@s.ShowtimeId</td>
                                    <td style="font-weight: 700; color: #FFFFFF;">Phòng @s.RoomId</td>
                                    <td class="bgp-ops-mono">@s.StartUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="bgp-ops-mono">@s.EndUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @switch (s.Status)
                                        {
                                            case "ON_SALE":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--emerald">ON_SALE</span>
                                                break;
                                            case "DRAFT":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--amber">DRAFT</span>
                                                break;
                                            case "CLOSED":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--slate">CLOSED</span>
                                                break;
                                            case "CANCELLED":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--danger">CANCELLED</span>
                                                break;
                                            default:
                                                <span class="badge bgp-ops-badge bgp-ops-badge--slate">@s.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="is-right">
                                        <a asp-action="ShowtimeDetail" asp-route-id="@s.ShowtimeId" class="bgp-btn bgp-btn--outline bgp-btn--sm">
                                            Xem chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <!-- Accessible Confirmation Dialog for Archiving Movie -->
    @if (m.Status == "PUBLISHED")
    {
        <dialog id="archiveMovieDialog"
                class="bgp-dialog bgp-ops-dialog"
                data-testid="archive-movie-dialog"
                aria-labelledby="archiveMovieDialogTitle">
            <h3 id="archiveMovieDialogTitle" class="bgp-ops-dialog__title">Xác nhận lưu trữ phim</h3>
            <p class="bgp-ops-dialog__desc">
                Bạn có chắc chắn muốn chuyển phim <strong>@m.Title</strong> sang trạng thái <code>ARCHIVED</code>?
                @if (Model.HasActiveShowtimes)
                {
                    <br /><strong style="color: #FCA5A5;">Lưu ý:</strong> <span>Phim này đang có suất chiếu hiệu lực trong tương lai; máy chủ sẽ kiểm tra ràng buộc nghiệp vụ trước khi cho phép lưu trữ.</span>
                }
                else
                {
                    <br /><span>Sau khi lưu trữ, phim sẽ ẩn khỏi trang đặt vé khách hàng và không thể công bố thêm suất chiếu mới.</span>
                }
            </p>
            <div class="bgp-ops-dialog__actions">
                <button type="button" class="bgp-btn bgp-btn--outline bgp-btn--sm" data-dialog-cancel>
                    Giữ nguyên PUBLISHED
                </button>
                <button type="button"
                        class="bgp-btn bgp-btn--danger bgp-btn--sm"
                        data-dialog-confirm
                        data-testid="confirm-archive-movie-btn">
                    Xác nhận lưu trữ (ARCHIVE)
                </button>
            </div>
        </dialog>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/modules/ops-management.js" asp-append-version="true"></script>
}
