@model BetaGiaiPhong.Web.Models.ViewModels.ManageRoomsViewModel
@{
    ViewData["Title"] = "Danh mục Phòng chiếu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <header class="bgp-ops-header">
        <div class="bgp-ops-header__main">
            <div class="bgp-ops-eyebrow">AUDITORIUM INVENTORY • READ-ONLY REFERENCE</div>
            <h1 class="bgp-ops-title">Phòng chiếu &amp; Sơ đồ ghế vật lý</h1>
            <p class="bgp-ops-subtitle">
                Tham chiếu danh mục phòng chiếu, sức chứa ghế hoạt động và cấu trúc phân hạng ghế vật lý của rạp Beta Giải Phóng.
            </p>
        </div>
    </header>

    <div class="bgp-ops-rooms-grid">
        @foreach (var room in Model.Rooms)
        {
            <article class="bgp-ops-card" style="margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between;">
                <div>
                    <div class="bgp-ops-card__header">
                        <div>
                            <h2 class="bgp-ops-card__title" style="font-size: 1.05rem;">@room.RoomName</h2>
                            <div class="bgp-ops-movie-sub bgp-ops-mono">Mã phòng: @room.RoomCode</div>
                        </div>
                        <span class="badge bgp-ops-badge @(room.Status == "ACTIVE" ? "bgp-ops-badge--emerald" : "bgp-ops-badge--slate")">
                            @room.Status
                        </span>
                    </div>
                    <div class="bgp-ops-card__body">
                        <div class="bgp-ops-form-row-2" style="margin-bottom: 14px;">
                            <div style="padding: 12px; border-radius: 8px; background: #101016; border: 1px solid var(--bgp-border-subtle); text-align: center;">
                                <div class="bgp-ops-hint" style="margin:0;">Tổng số ghế</div>
                                <div class="bgp-ops-mono" style="font-size: 1.35rem; font-weight: 800; color: #FFFFFF; margin-top: 4px;">@room.TotalSeats</div>
                            </div>
                            <div style="padding: 12px; border-radius: 8px; background: #101016; border: 1px solid var(--bgp-border-subtle); text-align: center;">
                                <div class="bgp-ops-hint" style="margin:0;">Ghế khả dụng</div>
                                <div class="bgp-ops-mono" style="font-size: 1.35rem; font-weight: 800; color: #6EE7B7; margin-top: 4px;">@room.ActiveSeats</div>
                            </div>
                        </div>

                        <div>
                            <span class="bgp-ops-label">Các hạng ghế cấu hình</span>
                            <div class="bgp-ops-id-list">
                                @foreach (var st in room.SeatTypes)
                                {
                                    <span class="bgp-ops-id-chip">@st</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bgp-ops-card__footer" style="justify-content: flex-end;">
                    <a asp-action="RoomDetail" asp-route-id="@room.RoomId" class="bgp-btn bgp-btn--outline bgp-btn--sm">
                        Xem sơ đồ ghế vật lý &rarr;
                    </a>
                </div>
            </article>
        }
    </div>
</div>
