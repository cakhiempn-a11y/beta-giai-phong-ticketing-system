@model BetaGiaiPhong.Web.Models.ViewModels.ManageRoomsViewModel
@{
    ViewData["Title"] = "Danh mục Phòng chiếu";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">Phòng chiếu & Sơ đồ ghế vật lý</h1>
            <p class="text-secondary mb-0 small">Thông tin tham chiếu danh mục phòng chiếu, số lượng ghế và phân loại ghế vật lý (Read-only).</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var room in Model.Rooms)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-0 text-dark">@room.RoomName</h2>
                            <span class="text-muted small">Mã phòng: @room.RoomCode</span>
                        </div>
                        <span class="badge @(room.Status == "ACTIVE" ? "bg-success" : "bg-secondary")">
                            @room.Status
                        </span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-6">
                                <div class="p-2 bg-light rounded">
                                    <div class="text-muted small">Tổng số ghế</div>
                                    <div class="h5 fw-bold text-dark mb-0">@room.TotalSeats</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded">
                                    <div class="text-muted small">Ghế khả dụng</div>
                                    <div class="h5 fw-bold text-success mb-0">@room.ActiveSeats</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <span class="small fw-semibold text-muted d-block mb-1">Các loại ghế hiện có:</span>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var st in room.SeatTypes)
                                {
                                    <span class="badge bg-light text-dark border">@st</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top py-2 px-3 text-end">
                        <a asp-action="RoomDetail" asp-route-id="@room.RoomId" class="btn btn-sm btn-outline-primary">
                            Xem sơ đồ ghế vật lý &rarr;
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
