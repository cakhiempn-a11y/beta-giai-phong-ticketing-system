@model BetaGiaiPhong.Web.Models.ViewModels.ManageShowtimeCreateViewModel
@{
    ViewData["Title"] = "Công bố suất chiếu mới";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page bgp-ops-page--narrow">
    <ol class="bgp-ops-breadcrumb" aria-label="Breadcrumb">
        <li><a asp-action="Showtimes">Lịch chiếu</a></li>
        <li class="bgp-ops-breadcrumb__sep" aria-hidden="true">/</li>
        <li aria-current="page">Công bố suất chiếu mới</li>
    </ol>

    <section class="bgp-ops-card">
        <div class="bgp-ops-card__header">
            <div>
                <h1 class="bgp-ops-title" style="font-size: 1.35rem;">Công bố suất chiếu mới</h1>
                <div class="bgp-ops-movie-sub">Khởi tạo suất chiếu mở bán (<code>ON_SALE</code>), kiểm tra xung đột phòng và thiết lập bảng giá ghế.</div>
            </div>
            <span class="badge bgp-ops-badge bgp-ops-badge--emerald">PUBLISH ON_SALE</span>
        </div>
        <div class="bgp-ops-card__body">
            @if (Model.PublishedMovies.Count == 0)
            {
                <div class="bgp-ops-alert bgp-ops-alert--warning" role="alert" style="margin-bottom:0;">
                    <div>
                        <strong style="display:block; margin-bottom:4px; color:#FFFFFF;">Chưa có phim nào ở trạng thái PUBLISHED!</strong>
                        <p style="margin: 0 0 10px;">Bạn cần xuất bản (Publish) ít nhất một bộ phim trước khi có thể lên lịch suất chiếu.</p>
                        <a asp-action="Movies" class="bgp-btn bgp-btn--outline bgp-btn--sm">Đi tới Danh mục Phim</a>
                    </div>
                </div>
            }
            else
            {
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bgp-ops-alert bgp-ops-alert--danger alert-danger" role="alert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form method="post" asp-action="ShowtimeCreate">
                    @Html.AntiForgeryToken()

                    <div class="bgp-ops-form-group">
                        <label for="stCreateMovie" class="bgp-ops-label">Phim chiếu <span style="color: #F87171;">*</span></label>
                        <select id="stCreateMovie" name="MovieId" class="bgp-ops-select" required>
                            <option value="">-- Chọn phim đã xuất bản --</option>
                            @foreach (var m in Model.PublishedMovies)
                            {
                                <option value="@m.MovieId" selected="@(Model.SelectedMovieId == m.MovieId)">
                                    @m.Title (@m.DurationMin phút@(string.IsNullOrWhiteSpace(m.AgeLabel) ? "" : $" | {m.AgeLabel}"))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="bgp-ops-form-group">
                        <label for="stCreateRoom" class="bgp-ops-label">Phòng chiếu <span style="color: #F87171;">*</span></label>
                        <select id="stCreateRoom" name="RoomId" class="bgp-ops-select" required>
                            <option value="">-- Chọn phòng chiếu hoạt động --</option>
                            @foreach (var r in Model.ActiveRooms)
                            {
                                <option value="@r.RoomId" selected="@(Model.SelectedRoomId == r.RoomId)">
                                    @r.RoomName (Sức chứa danh nghĩa: @r.Seats.Count ghế)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="bgp-ops-form-row-2 bgp-ops-form-group">
                        <div>
                            <label for="stCreateStart" class="bgp-ops-label">Thời gian bắt đầu (Giờ Việt Nam - UTC+7) <span style="color: #F87171;">*</span></label>
                            @{
                                var defaultTimeStr = (Model.StartTimeVn ?? DateTime.Now.AddHours(2)).ToString("yyyy-MM-ddTHH:mm");
                            }
                            <input id="stCreateStart"
                                   type="datetime-local"
                                   name="StartTimeVn"
                                   value="@defaultTimeStr"
                                   class="bgp-ops-input bgp-ops-mono"
                                   required />
                            <div class="bgp-ops-hint">Hệ thống tự động quy đổi sang chuẩn lưu trữ UTC và kiểm tra chống chồng lấn.</div>
                        </div>
                        <div>
                            <label for="stCreateBuffer" class="bgp-ops-label">Thời gian đệm dọn phòng (phút)</label>
                            <input id="stCreateBuffer"
                                   type="number"
                                   name="BufferMinutes"
                                   value="@Model.BufferMinutes"
                                   min="0"
                                   max="120"
                                   class="bgp-ops-input bgp-ops-mono"
                                   required />
                            <div class="bgp-ops-hint">Khoảng nghỉ giữa 2 suất liên tiếp (mặc định 15 phút).</div>
                        </div>
                    </div>

                    <!-- Seat Pricing Section -->
                    <div class="bgp-override-box">
                        <div style="font-weight: 700; font-size: 0.9rem; color: #FFFFFF; margin-bottom: 4px;">
                            Bảng giá vé theo loại ghế (VNĐ) <span style="color: #F87171;">*</span>
                        </div>
                        <p class="bgp-ops-hint" style="margin: 0 0 12px;">
                            Nhập giá vé cho từng loại ghế áp dụng cho suất chiếu này. Mọi loại ghế trong phòng phải được định giá dương.
                        </p>

                        <div class="bgp-ops-form-row-3">
                            @foreach (var st in Model.SeatTypes)
                            {
                                var currentPrice = Model.Prices.TryGetValue(st.SeatTypeCode, out var p)
                                    ? p
                                    : (st.SeatTypeCode switch { "VIP" => 90000, "SWEETBOX" => 160000, _ => 75000 });
                                var priceInputId = $"price_{st.SeatTypeCode}";
                                <div>
                                    <label for="@priceInputId" class="bgp-ops-label">
                                        @st.TypeName (<span class="bgp-ops-mono">@st.SeatTypeCode</span>)
                                    </label>
                                    <input id="@priceInputId"
                                           type="number"
                                           name="Prices[@st.SeatTypeCode]"
                                           value="@currentPrice"
                                           min="1000"
                                           step="1000"
                                           class="bgp-ops-input bgp-ops-mono"
                                           required />
                                </div>
                            }
                        </div>
                    </div>

                    <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; padding-top:16px; border-top:1px solid var(--bgp-border-subtle);">
                        <a asp-action="Showtimes" class="bgp-btn bgp-btn--outline">Hủy bỏ</a>
                        <button type="submit" class="bgp-btn bgp-btn--primary">
                            Công bố suất chiếu (PUBLISH)
                        </button>
                    </div>
                </form>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/modules/ops-management.js" asp-append-version="true"></script>
}
