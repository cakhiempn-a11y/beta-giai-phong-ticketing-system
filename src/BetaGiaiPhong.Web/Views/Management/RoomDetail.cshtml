@model BetaGiaiPhong.Web.Models.ViewModels.ManageRoomDetailViewModel
@{
    var r = Model.Room;
    ViewData["Title"] = $"Sơ đồ phòng: {r.RoomName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <ol class="bgp-ops-breadcrumb" aria-label="Breadcrumb">
        <li><a asp-action="Rooms">Phòng chiếu</a></li>
        <li class="bgp-ops-breadcrumb__sep" aria-hidden="true">/</li>
        <li aria-current="page">@r.RoomName</li>
    </ol>

    <header class="bgp-ops-header">
        <div class="bgp-ops-header__main">
            <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:8px;">
                <span class="badge bgp-ops-badge bgp-ops-badge--slate bgp-ops-mono">Mã phòng: @r.RoomCode</span>
                <span class="badge bgp-ops-badge @(r.Status == "ACTIVE" ? "bgp-ops-badge--emerald" : "bgp-ops-badge--slate")">@r.Status</span>
            </div>
            <h1 class="bgp-ops-title">@r.RoomName</h1>
            <p class="bgp-ops-subtitle">
                Cấu hình danh mục ghế vật lý (Read-only Reference). Không cho phép sửa đổi cấu trúc phòng đã vận hành để bảo toàn toàn vẹn lịch sử vé.
            </p>
        </div>

        <div class="bgp-ops-actions">
            <div style="padding: 8px 14px; border-radius: 8px; background: var(--bgp-bg-surface-1); border: 1px solid var(--bgp-border-default); text-align: right;">
                <div class="bgp-ops-hint" style="margin:0;">Tổng số ghế</div>
                <div class="bgp-ops-mono" style="font-size: 1.2rem; font-weight: 800; color: #FFFFFF;">@r.TotalSeats</div>
            </div>
            <div style="padding: 8px 14px; border-radius: 8px; background: var(--bgp-bg-surface-1); border: 1px solid var(--bgp-border-default); text-align: right;">
                <div class="bgp-ops-hint" style="margin:0;">Ghế hoạt động</div>
                <div class="bgp-ops-mono" style="font-size: 1.2rem; font-weight: 800; color: #6EE7B7;">@r.ActiveSeats</div>
            </div>
        </div>
    </header>

    <section class="bgp-ops-card">
        <div class="bgp-ops-card__header">
            <h2 class="bgp-ops-card__title">Sơ đồ bố trí ghế vật lý</h2>
            <div class="bgp-ops-legend">
                <span class="bgp-ops-legend__item">
                    <span class="bgp-ops-legend__swatch bgp-ops-seat--standard"></span>
                    <span>STANDARD (Thường)</span>
                </span>
                <span class="bgp-ops-legend__item">
                    <span class="bgp-ops-legend__swatch bgp-ops-seat--vip"></span>
                    <span>VIP (Ghế VIP)</span>
                </span>
                <span class="bgp-ops-legend__item">
                    <span class="bgp-ops-legend__swatch bgp-ops-seat--sweetbox"></span>
                    <span>SWEETBOX (Ghế đôi)</span>
                </span>
                <span class="bgp-ops-legend__item">
                    <span class="bgp-ops-legend__swatch bgp-ops-seat--inactive"></span>
                    <span>Ngừng hoạt động</span>
                </span>
            </div>
        </div>
        <div class="bgp-ops-card__body">
            <div class="bgp-ops-stage">
                <div class="bgp-ops-screen-arc">[ MÀN HÌNH CHIẾU ]</div>

                <div class="bgp-ops-seat-scroll">
                    <div class="bgp-ops-seat-matrix">
                        @{
                            var groupedSeats = r.Seats.GroupBy(s => s.RowLabel).OrderBy(g => g.Key);
                        }
                        @foreach (var row in groupedSeats)
                        {
                            <div class="bgp-ops-seat-row">
                                <span class="bgp-ops-seat-row__label">@row.Key</span>
                                @foreach (var seat in row.OrderBy(s => s.ColumnNo))
                                {
                                    var seatMod = !seat.IsActive
                                        ? "bgp-ops-seat--inactive"
                                        : seat.SeatTypeCode switch
                                        {
                                            "VIP" => "bgp-ops-seat--vip",
                                            "SWEETBOX" => "bgp-ops-seat--sweetbox",
                                            _ => "bgp-ops-seat--standard"
                                        };

                                    <div class="bgp-ops-seat @seatMod"
                                         title="@seat.SeatCode (@seat.SeatTypeCode) - @(seat.IsActive ? "Hoạt động" : "Ngừng hoạt động")">
                                        @seat.SeatCode
                                    </div>
                                }
                                <span class="bgp-ops-seat-row__label">@row.Key</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
