@model BetaGiaiPhong.Web.Models.ViewModels.ManageMoviesViewModel
@{
    ViewData["Title"] = "Quản lý Phim";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <header class="bgp-ops-header">
        <div class="bgp-ops-header__main">
            <div class="bgp-ops-eyebrow">VERIFIED FILM CATALOG • PROVENANCE GOVERNANCE</div>
            <h1 class="bgp-ops-title">Danh mục Phim</h1>
            <p class="bgp-ops-subtitle">
                Quản lý vòng đời phim (<code>DRAFT &rarr; PUBLISHED &rarr; ARCHIVED</code>) cùng định danh xác minh Wikidata, IMDb &amp; TMDB.
            </p>
        </div>
        <div class="bgp-ops-actions">
            @if (Model.IsTmdbConfigured)
            {
                <span class="bgp-ops-env-pill bgp-ops-env-pill--live" data-testid="tmdb-env-status">
                    <span class="bgp-ops-env-pill__dot"></span>
                    <span>TMDB API: Sẵn sàng</span>
                </span>
            }
            else
            {
                <span class="bgp-ops-env-pill bgp-ops-env-pill--keyless"
                      data-testid="tmdb-env-status"
                      title="Chưa cấu hình biến môi trường BGP_TMDB_READ_TOKEN — vẫn hỗ trợ đầy đủ danh mục xác minh Wikidata/IMDb nội bộ.">
                    <span class="bgp-ops-env-pill__dot"></span>
                    <span>Chế độ không khóa TMDB (Wikidata/IMDb sẵn sàng)</span>
                </span>
            }

            <button type="button"
                    class="bgp-btn bgp-btn--glass bgp-btn--sm"
                    data-toggle-sync-panel="externalSyncDrawer"
                    data-testid="toggle-external-lookup-btn"
                    aria-expanded="false"
                    aria-controls="externalSyncDrawer">
                Tra cứu &amp; Nhập nguồn xác minh
            </button>

            <form method="post" asp-action="SyncVerifiedCatalog" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="bgp-btn bgp-btn--outline bgp-btn--sm"
                        data-testid="sync-verified-catalog-btn"
                        title="Đồng bộ lại danh mục xác minh mà không ghi đè các trường đã khóa thủ công">
                    Đồng bộ danh mục xác minh
                </button>
            </form>

            <a asp-action="MovieCreate" class="bgp-btn bgp-btn--primary bgp-btn--sm">
                + Thêm phim mới
            </a>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--success" role="status">
            <span>@TempData["Success"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--warning" role="status">
            <span>@TempData["Warning"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--danger alert-danger" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }

    <!-- Controlled External Lookup & Sync Drawer -->
    <section id="externalSyncDrawer"
             class="bgp-sync-panel"
             data-external-lookup-root
             data-lookup-mode="catalog"
             data-testid="external-lookup-drawer"
             hidden>
        <div class="bgp-sync-panel__head">
            <div>
                <h2 class="bgp-sync-panel__title">Tra cứu &amp; Nhập bản nháp từ TMDB / Wikidata / IMDb</h2>
                <p class="bgp-sync-panel__desc">
                    Nhập tên phim, mã IMDb (<code>tt...</code>), mã Wikidata (<code>Q...</code>) hoặc TMDB ID. Mọi tác phẩm nhập mới mặc định ở <code>DRAFT</code> và không tự quy đổi nhãn độ tuổi nước ngoài sang chuẩn Việt Nam.
                </p>
            </div>
        </div>

        <div class="bgp-sync-search-bar">
            <label for="externalLookupInput" class="bgp-sr-only">Từ khóa hoặc mã định danh phim xác minh</label>
            <input id="externalLookupInput"
                   type="text"
                   class="bgp-ops-input"
                   data-sync-search-input
                   data-testid="external-lookup-input"
                   placeholder="Ví dụ: tt0807840, Q731114, Elephants Dream, Big Buck Bunny, Charade..." />
            <button type="button"
                    class="bgp-btn bgp-btn--primary bgp-btn--sm"
                    data-sync-search-btn
                    data-testid="external-lookup-submit">
                Tra cứu nguồn xác minh
            </button>
        </div>

        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-bottom:12px;">
            <span class="bgp-ops-hint" style="margin:0;">Gợi ý tra nhanh:</span>
            <button type="button" class="bgp-ops-id-chip" style="cursor:pointer;" data-sync-quick-query="tt0807840">tt0807840 (Elephants Dream)</button>
            <button type="button" class="bgp-ops-id-chip" style="cursor:pointer;" data-sync-quick-query="Q731114">Q731114 (Big Buck Bunny)</button>
            <button type="button" class="bgp-ops-id-chip" style="cursor:pointer;" data-sync-quick-query="Q496266">Q496266 (Charade)</button>
            <button type="button" class="bgp-ops-id-chip" style="cursor:pointer;" data-sync-quick-query="">Xem toàn bộ nguồn xác minh</button>
        </div>

        <div class="bgp-sync-status" data-sync-status data-testid="external-lookup-status" hidden></div>
        <div class="bgp-sync-results" data-sync-results data-testid="external-lookup-results"></div>
    </section>

    <!-- Search & Filter Bar -->
    <div class="bgp-ops-filter-bar">
        <form method="get" asp-action="Movies" class="bgp-ops-filter-grid">
            <div>
                <label for="movieSearchInput" class="bgp-ops-label">Tìm kiếm tên phim, đạo diễn hoặc mã QID / IMDb / TMDB</label>
                <input id="movieSearchInput"
                       type="text"
                       name="search"
                       value="@Model.Search"
                       class="bgp-ops-input"
                       placeholder="Nhập tên phim, đạo diễn, Q496266, tt0056923..." />
            </div>
            <div>
                <label for="movieStatusSelect" class="bgp-ops-label">Trạng thái vòng đời</label>
                <select id="movieStatusSelect" name="status" class="bgp-ops-select">
                    <option value="ALL" selected="@(Model.StatusFilter == "ALL")">-- Tất cả trạng thái --</option>
                    <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">DRAFT (Bản nháp)</option>
                    <option value="PUBLISHED" selected="@(Model.StatusFilter == "PUBLISHED")">PUBLISHED (Đã xuất bản)</option>
                    <option value="ARCHIVED" selected="@(Model.StatusFilter == "ARCHIVED")">ARCHIVED (Lưu trữ)</option>
                </select>
            </div>
            <div class="bgp-ops-filter-actions">
                <button type="submit" class="bgp-btn bgp-btn--primary bgp-btn--sm">Tìm kiếm</button>
                <a asp-action="Movies" class="bgp-btn bgp-btn--outline bgp-btn--sm" title="Đặt lại">Đặt lại</a>
            </div>
        </form>
    </div>

    <!-- Movies Table -->
    <section class="bgp-ops-card">
        <div class="bgp-ops-card__header">
            <h2 class="bgp-ops-card__title">Danh sách Phim trong Hệ thống</h2>
            <span class="badge bgp-ops-badge bgp-ops-badge--slate">Tổng số: @Model.TotalCount phim</span>
        </div>
        <div class="bgp-ops-card__body bgp-ops-card__body--flush">
            @if (Model.Items.Count == 0)
            {
                <div style="padding: 36px 16px; text-align: center; color: var(--bgp-text-muted);">
                    Không tìm thấy phim nào khớp với điều kiện tìm kiếm.
                </div>
            }
            else
            {
                <div class="bgp-ops-table-wrap">
                    <table class="bgp-ops-table">
                        <thead>
                            <tr>
                                <th>#ID</th>
                                <th>Tác phẩm</th>
                                <th class="is-center">Thời lượng</th>
                                <th>Thể loại &amp; Độ tuổi VN</th>
                                <th>Nguồn xác minh</th>
                                <th class="is-center">Trạng thái</th>
                                <th class="is-center">Suất chiếu</th>
                                <th class="is-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Items)
                            {
                                var ageMod = (m.AgeLabel ?? "").ToUpperInvariant() switch
                                {
                                    "P" => "bgp-ops-age--p",
                                    "K" => "bgp-ops-age--k",
                                    "T13" => "bgp-ops-age--t13",
                                    "T16" => "bgp-ops-age--t16",
                                    "T18" => "bgp-ops-age--t18",
                                    "C" => "bgp-ops-age--c",
                                    _ => "bgp-ops-age--unset"
                                };
                                <tr>
                                    <td class="bgp-ops-mono">#@m.MovieId</td>
                                    <td>
                                        <div class="bgp-ops-movie-cell">
                                            <div class="bgp-ops-thumb">
                                                @if (!string.IsNullOrWhiteSpace(m.PosterUrl))
                                                {
                                                    <img src="@m.PosterUrl"
                                                         alt="@m.Title"
                                                         loading="lazy"
                                                         onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                                                    <span class="bgp-ops-thumb__fallback" style="display:none;">BGP</span>
                                                }
                                                else
                                                {
                                                    <span class="bgp-ops-thumb__fallback">BGP</span>
                                                }
                                            </div>
                                            <div class="bgp-ops-movie-meta">
                                                <a asp-action="MovieDetail" asp-route-id="@m.MovieId" class="bgp-ops-movie-title">
                                                    @m.Title
                                                </a>
                                                <div class="bgp-ops-movie-sub">
                                                    @if (!string.IsNullOrWhiteSpace(m.OriginalTitle) && !string.Equals(m.OriginalTitle, m.Title, StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span>@m.OriginalTitle</span>
                                                        <span> &bull; </span>
                                                    }
                                                    @if (m.ReleaseYear.HasValue)
                                                    {
                                                        <span>@m.ReleaseYear</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(m.DirectorNames))
                                                    {
                                                        <span> &bull; ĐD: @m.DirectorNames</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="is-center bgp-ops-mono">
                                        <span class="badge bgp-ops-badge bgp-ops-badge--slate">@m.DurationMin phút</span>
                                    </td>
                                    <td style="max-width: 175px;">
                                        <div style="color: var(--bgp-text-primary); margin-bottom: 4px; font-size: 0.81rem;">@(m.GenreText ?? "Chưa phân loại")</div>
                                        @if (!string.IsNullOrWhiteSpace(m.AgeLabel))
                                        {
                                            <span class="bgp-ops-age @ageMod">@m.AgeLabel</span>
                                        }
                                        else
                                        {
                                            <span class="bgp-ops-age bgp-ops-age--unset">Chưa phân loại VN</span>
                                        }
                                    </td>
                                    <td style="max-width: 195px;">
                                        <div class="bgp-ops-id-list" style="margin-top:0;">
                                            @if (!string.IsNullOrWhiteSpace(m.WikidataQid))
                                            {
                                                <span class="bgp-ops-id-chip">@m.WikidataQid</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(m.ImdbId))
                                            {
                                                <span class="bgp-ops-id-chip">@m.ImdbId</span>
                                            }
                                            @if (m.TmdbId.HasValue)
                                            {
                                                <span class="bgp-ops-id-chip">TMDB #@m.TmdbId</span>
                                            }
                                            @if (string.IsNullOrWhiteSpace(m.WikidataQid) && string.IsNullOrWhiteSpace(m.ImdbId) && !m.TmdbId.HasValue)
                                            {
                                                <span class="bgp-ops-hint" style="margin:0;">Nội bộ / Thủ công</span>
                                            }
                                        </div>
                                        <div class="bgp-ops-id-list">
                                            @if (m.RatingValue.HasValue)
                                            {
                                                <span class="badge bgp-ops-badge bgp-ops-badge--gold bgp-ops-mono">
                                                    @(m.RatingSource == "TMDB" ? "TMDB" : "IMDb") @m.RatingValue.Value.ToString("0.0")
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(m.ManualOverrideMask))
                                            {
                                                <span class="bgp-ops-lock-pill" title="Các trường đã khóa thủ công: @m.ManualOverrideMask">
                                                    Khóa ghi đè
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="is-center">
                                        @if (m.Status == "PUBLISHED")
                                        {
                                            <span class="badge bgp-ops-badge bgp-ops-badge--emerald">PUBLISHED</span>
                                        }
                                        else if (m.Status == "DRAFT")
                                        {
                                            <span class="badge bgp-ops-badge bgp-ops-badge--amber">DRAFT</span>
                                        }
                                        else if (m.Status == "ARCHIVED")
                                        {
                                            <span class="badge bgp-ops-badge bgp-ops-badge--slate">ARCHIVED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bgp-ops-badge bgp-ops-badge--slate">@m.Status</span>
                                        }
                                    </td>
                                    <td class="is-center bgp-ops-mono">
                                        <strong style="color: #FFFFFF;">@m.TotalShowtimes</strong> suất
                                        @if (m.ActiveShowtimes > 0)
                                        {
                                            <div style="font-size: 0.75rem; color: #6EE7B7;">(@m.ActiveShowtimes hiệu lực)</div>
                                        }
                                    </td>
                                    <td class="is-right" style="white-space: nowrap;">
                                        <div style="display:inline-flex; gap:6px; flex-wrap:nowrap; justify-content:flex-end;">
                                            <a asp-action="MovieDetail" asp-route-id="@m.MovieId" class="bgp-btn bgp-btn--outline bgp-btn--sm" style="padding: 0 10px;">
                                                Chi tiết
                                            </a>
                                            <a asp-action="MovieEdit" asp-route-id="@m.MovieId" class="bgp-btn bgp-btn--glass bgp-btn--sm" style="padding: 0 10px;">
                                                Sửa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="bgp-ops-card__footer">
                        <span class="bgp-ops-hint" style="margin:0;">Trang @Model.CurrentPage / @Model.TotalPages</span>
                        <nav aria-label="Phân trang danh mục phim">
                            <ul class="bgp-ops-pagination">
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li>
                                        <a class="bgp-ops-page-link @(p == Model.CurrentPage ? "is-active" : "")"
                                           asp-action="Movies"
                                           asp-route-page="@p"
                                           asp-route-search="@Model.Search"
                                           asp-route-status="@Model.StatusFilter">@p</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/modules/ops-management.js" asp-append-version="true"></script>
}
