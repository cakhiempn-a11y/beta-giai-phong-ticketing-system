@model BetaGiaiPhong.Web.Models.ViewModels.ManageMoviesViewModel
@{
    ViewData["Title"] = "Quản lý Phim";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">Danh mục Phim</h1>
            <p class="text-secondary mb-0 small">Quản lý vòng đời phim: DRAFT &rarr; PUBLISHED &rarr; ARCHIVED.</p>
        </div>
        <div>
            <a asp-action="MovieCreate" class="btn btn-primary btn-sm px-3 shadow-sm">
                + Thêm phim mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Movies" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Tìm kiếm tên phim hoặc thể loại</label>
                    <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Nhập từ khóa tìm kiếm..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Trạng thái</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="ALL" selected="@(Model.StatusFilter == "ALL")">-- Tất cả trạng thái --</option>
                        <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">DRAFT (Bản nháp)</option>
                        <option value="PUBLISHED" selected="@(Model.StatusFilter == "PUBLISHED")">PUBLISHED (Đã xuất bản)</option>
                        <option value="ARCHIVED" selected="@(Model.StatusFilter == "ARCHIVED")">ARCHIVED (Lưu trữ)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Tìm kiếm</button>
                    <a asp-action="Movies" class="btn btn-outline-secondary btn-sm" title="Đặt lại">&#x21bb;</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Movies Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div class="fw-bold">Danh sách Phim</div>
            <span class="badge bg-secondary">Tổng số: @Model.TotalCount phim</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <p class="mb-0">Không tìm thấy phim nào khớp với điều kiện tìm kiếm.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>#ID</th>
                                <th>Tên phim</th>
                                <th class="text-center">Thời lượng</th>
                                <th>Thể loại &amp; Độ tuổi</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Suất chiếu</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Items)
                            {
                                <tr>
                                    <td class="text-muted small">#@m.MovieId</td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <a asp-action="MovieDetail" asp-route-id="@m.MovieId" class="text-decoration-none">
                                                @m.Title
                                            </a>
                                        </div>
                                        @if (!string.IsNullOrEmpty(m.Synopsis))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 350px;">
                                                @m.Synopsis
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@m.DurationMin phút</span>
                                    </td>
                                    <td class="small">
                                        <div>@(m.GenreText ?? "Chưa phân loại")</div>
                                        @if (!string.IsNullOrEmpty(m.AgeLabel))
                                        {
                                            <span class="badge bg-warning text-dark small">@m.AgeLabel</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (m.Status == "PUBLISHED")
                                        {
                                            <span class="badge bg-success">PUBLISHED</span>
                                        }
                                        else if (m.Status == "DRAFT")
                                        {
                                            <span class="badge bg-secondary">DRAFT</span>
                                        }
                                        else if (m.Status == "ARCHIVED")
                                        {
                                            <span class="badge bg-dark">ARCHIVED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">@m.Status</span>
                                        }
                                    </td>
                                    <td class="text-center small">
                                        <span class="fw-semibold">@m.TotalShowtimes</span> suất
                                        @if (m.ActiveShowtimes > 0)
                                        {
                                            <div class="text-success small">(@m.ActiveShowtimes đang chiếu)</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="MovieDetail" asp-route-id="@m.MovieId" class="btn btn-outline-primary" title="Xem chi tiết">
                                                Chi tiết
                                            </a>
                                            <a asp-action="MovieEdit" asp-route-id="@m.MovieId" class="btn btn-outline-secondary" title="Sửa thông tin">
                                                Sửa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                        <small class="text-muted">Trang @Model.CurrentPage / @Model.TotalPages</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Movies"
                                           asp-route-page="@p"
                                           asp-route-search="@Model.Search"
                                           asp-route-status="@Model.StatusFilter">@p</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>
