@model BetaGiaiPhong.Web.Models.ViewModels.ManageDashboardViewModel
@{
    ViewData["Title"] = "Báo cáo Doanh thu & Tỷ lệ Lấp đầy";
    var report = Model.Report;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">Báo cáo Vận hành & Doanh thu</h1>
            <p class="text-secondary mb-0 small">Dữ liệu từ <code>dbo.vw_ShowtimeSales</code> — Doanh thu thực tế chỉ ghi nhận từ các đơn hàng PAID có vé phát hành hợp lệ.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Movies" class="btn btn-outline-primary btn-sm">Quản lý Phim</a>
            <a asp-action="Showtimes" class="btn btn-outline-success btn-sm">Quản lý Suất chiếu</a>
            <a asp-action="Rooms" class="btn btn-outline-secondary btn-sm">Sơ đồ Phòng</a>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Reports" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Từ ngày (VN)</label>
                    <input type="date" name="fromDate" value="@Model.FromDateVn" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Đến ngày (VN)</label>
                    <input type="date" name="toDate" value="@Model.ToDateVn" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Phim</label>
                    <select name="movieId" class="form-select form-select-sm">
                        <option value="">-- Tất cả phim --</option>
                        @foreach (var m in Model.Movies)
                        {
                            <option value="@m.MovieId" selected="@(Model.SelectedMovieId == m.MovieId)">@m.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Phòng chiếu</label>
                    <select name="roomId" class="form-select form-select-sm">
                        <option value="">-- Tất cả phòng --</option>
                        @foreach (var r in Model.Rooms)
                        {
                            <option value="@r.RoomId" selected="@(Model.SelectedRoomId == r.RoomId)">@r.RoomName</option>
                        }
                    </select>
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Lọc</button>
                    <a asp-action="Reports" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">&#x21bb;</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Top KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body p-3">
                    <div class="text-white-50 small text-uppercase fw-bold">Tổng Doanh thu Hợp lệ</div>
                    <div class="fs-3 fw-bold mt-1">@report.TotalRevenueVnd.ToString("N0") <small class="fs-6">VND</small></div>
                    <div class="small mt-2 text-white-50">Chỉ tính đơn PAID &amp; vé phát hành</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body p-3">
                    <div class="text-white-50 small text-uppercase fw-bold">Tổng Vé Đã Bán</div>
                    <div class="fs-3 fw-bold mt-1">@report.TotalTicketsSold.ToString("N0") <small class="fs-6">vé</small></div>
                    <div class="small mt-2 text-white-50">Vé thực tế thuộc đơn PAID</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body p-3">
                    <div class="text-white-50 small text-uppercase fw-bold">Tỷ lệ Lấp đầy Bình quân</div>
                    <div class="fs-3 fw-bold mt-1">@report.WeightedOccupancyPct.ToString("F2")%</div>
                    <div class="small mt-2 text-white-50">Tổng vé bán / Tổng sức chứa suất</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-dark text-white">
                <div class="card-body p-3">
                    <div class="text-white-50 small text-uppercase fw-bold">Tổng Số Suất Chiếu</div>
                    <div class="fs-3 fw-bold mt-1">@report.TotalShowtimes.ToString("N0") <small class="fs-6">suất</small></div>
                    <div class="small mt-2 text-white-50">Trong phạm vi bộ lọc hiện tại</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts / Breakdowns -->
    <div class="row g-4 mb-4">
        <!-- Revenue by Movie -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold border-bottom">
                    Doanh thu &amp; Lượng vé theo Phim
                </div>
                <div class="card-body p-0">
                    @if (report.RevenueByMovie.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">Không có dữ liệu trong khoảng thời gian này.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Tên phim</th>
                                        <th class="text-center">Vé bán</th>
                                        <th class="text-end">Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in report.RevenueByMovie)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@m.Title</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border">@m.TicketsSold</span></td>
                                            <td class="text-end text-success fw-bold">@m.RevenueVnd.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Revenue by Room -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold border-bottom">
                    Doanh thu theo Phòng chiếu
                </div>
                <div class="card-body p-0">
                    @if (report.RevenueByRoom.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">Không có dữ liệu trong khoảng thời gian này.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Phòng chiếu</th>
                                        <th class="text-center">Vé bán</th>
                                        <th class="text-end">Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in report.RevenueByRoom)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@r.RoomName</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border">@r.TicketsSold</span></td>
                                            <td class="text-end text-success fw-bold">@r.RevenueVnd.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue by Day & Top Showtimes -->
    <div class="row g-4 mb-4">
        <!-- Daily Breakdown -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold border-bottom">
                    Doanh thu theo Ngày chiếu (Giờ VN)
                </div>
                <div class="card-body p-0">
                    @if (report.RevenueByDay.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">Không có dữ liệu trong khoảng thời gian này.</div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small sticky-top">
                                    <tr>
                                        <th>Ngày chiếu (VN)</th>
                                        <th class="text-center">Vé bán</th>
                                        <th class="text-end">Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in report.RevenueByDay)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@d.DateVn</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border">@d.TicketsSold</span></td>
                                            <td class="text-end text-success fw-bold">@d.RevenueVnd.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Top Showtimes -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 fw-bold border-bottom">
                    Top 5 Suất chiếu có Doanh thu cao nhất
                </div>
                <div class="card-body p-0">
                    @if (report.TopShowtimes.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">Không có dữ liệu suất chiếu.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Suất chiếu</th>
                                        <th>Thời gian</th>
                                        <th class="text-center">Lấp đầy</th>
                                        <th class="text-end">Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ts in report.TopShowtimes)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-action="ShowtimeDetail" asp-route-id="@ts.ShowtimeId" class="fw-semibold text-decoration-none">
                                                    @ts.MovieTitle
                                                </a>
                                                <div class="small text-muted">@ts.RoomName</div>
                                            </td>
                                            <td class="small">@ts.StartUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-center">
                                                <span class="badge bg-info text-dark">@ts.OccupancyPct.ToString("F1")%</span>
                                                <div class="small text-muted">@ts.TicketsSold vé</div>
                                            </td>
                                            <td class="text-end text-success fw-bold">@ts.RevenueVnd.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Paginated Details Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div class="fw-bold">Bảng Chi tiết Doanh thu theo Suất chiếu</div>
            <span class="badge bg-secondary">Tổng cộng: @report.ShowtimeDetails.TotalCount suất</span>
        </div>
        <div class="card-body p-0">
            @if (report.ShowtimeDetails.Items.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <p class="mb-0">Không tìm thấy suất chiếu nào khớp với điều kiện lọc.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>#ID</th>
                                <th>Phim &amp; Phòng</th>
                                <th>Khung giờ (VN)</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Vé bán / Sức chứa</th>
                                <th class="text-center">Tỷ lệ lấp đầy</th>
                                <th class="text-end">Doanh thu</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in report.ShowtimeDetails.Items)
                            {
                                <tr>
                                    <td class="text-muted small">#@s.ShowtimeId</td>
                                    <td>
                                        <div class="fw-semibold">@s.MovieTitle</div>
                                        <div class="small text-muted">@s.RoomName</div>
                                    </td>
                                    <td class="small">
                                        <div>@s.StartUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="text-muted small">đến @s.EndUtc.AddHours(7).ToString("HH:mm")</div>
                                    </td>
                                    <td class="text-center">
                                        @if (s.Status == "ON_SALE")
                                        {
                                            <span class="badge bg-success">ĐANG BÁN</span>
                                        }
                                        else if (s.Status == "CLOSED")
                                        {
                                            <span class="badge bg-secondary">ĐÃ ĐÓNG</span>
                                        }
                                        else if (s.Status == "CANCELLED")
                                        {
                                            <span class="badge bg-danger">ĐÃ HỦY</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@s.Status</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold">@s.TicketsSold</span>
                                        <span class="text-muted">/ @s.SellableCapacity</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="progress" style="height: 6px; width: 80px; margin: 0 auto 4px;">
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @Math.Min(s.OccupancyPct, 100m)%"></div>
                                        </div>
                                        <span class="small fw-semibold">@s.OccupancyPct.ToString("F1")%</span>
                                    </td>
                                    <td class="text-end text-success fw-bold">
                                        @s.RevenueVnd.ToString("N0") đ
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="ShowtimeDetail" asp-route-id="@s.ShowtimeId" class="btn btn-outline-primary btn-sm py-0 px-2" title="Xem chi tiết">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (report.ShowtimeDetails.TotalPages > 1)
                {
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                        <small class="text-muted">Trang @report.ShowtimeDetails.Page / @report.ShowtimeDetails.TotalPages</small>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @for (int p = 1; p <= report.ShowtimeDetails.TotalPages; p++)
                                {
                                    <li class="page-item @(p == report.ShowtimeDetails.Page ? "active" : "")">
                                        <a class="page-link" asp-action="Reports"
                                           asp-route-page="@p"
                                           asp-route-fromDate="@Model.FromDateVn"
                                           asp-route-toDate="@Model.ToDateVn"
                                           asp-route-movieId="@Model.SelectedMovieId"
                                           asp-route-roomId="@Model.SelectedRoomId">@p</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>
