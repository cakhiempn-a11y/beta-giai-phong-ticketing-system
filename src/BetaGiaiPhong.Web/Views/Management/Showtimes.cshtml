@model BetaGiaiPhong.Web.Models.ViewModels.ManageShowtimesViewModel
@{
    ViewData["Title"] = "Quản lý Suất chiếu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <header class="bgp-ops-header">
        <div class="bgp-ops-header__main">
            <div class="bgp-ops-eyebrow">SHOWTIME SCHEDULING &amp; AUDITORIUM ALLOCATION</div>
            <h1 class="bgp-ops-title">Lịch chiếu &amp; Suất chiếu</h1>
            <p class="bgp-ops-subtitle">
                Quản lý khung giờ chiếu, kiểm soát không trùng lịch phòng chiếu, giám sát tỷ lệ lấp đầy và công bố suất chiếu mới.
            </p>
        </div>
        <div class="bgp-ops-actions">
            <a asp-action="ShowtimeCreate" class="bgp-btn bgp-btn--primary bgp-btn--sm">
                + Công bố suất chiếu mới
            </a>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--success" role="status">
            <span>@TempData["Success"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--danger alert-danger" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }

    <!-- Filter Bar -->
    <div class="bgp-ops-filter-bar">
        <form method="get" asp-action="Showtimes" class="bgp-ops-filter-grid">
            <div>
                <label for="stMovieId" class="bgp-ops-label">Phim</label>
                <select id="stMovieId" name="movieId" class="bgp-ops-select">
                    <option value="">-- Tất cả phim --</option>
                    @foreach (var m in Model.Movies)
                    {
                        <option value="@m.MovieId" selected="@(Model.SelectedMovieId == m.MovieId)">@m.Title</option>
                    }
                </select>
            </div>
            <div>
                <label for="stRoomId" class="bgp-ops-label">Phòng chiếu</label>
                <select id="stRoomId" name="roomId" class="bgp-ops-select">
                    <option value="">-- Tất cả phòng --</option>
                    @foreach (var r in Model.Rooms)
                    {
                        <option value="@r.RoomId" selected="@(Model.SelectedRoomId == r.RoomId)">@r.RoomName</option>
                    }
                </select>
            </div>
            <div>
                <label for="stDate" class="bgp-ops-label">Ngày chiếu (VN)</label>
                <input id="stDate" type="date" name="date" value="@Model.DateFilter" class="bgp-ops-input" />
            </div>
            <div>
                <label for="stStatus" class="bgp-ops-label">Trạng thái</label>
                <select id="stStatus" name="status" class="bgp-ops-select">
                    <option value="ALL" selected="@(Model.StatusFilter == "ALL")">-- Tất cả --</option>
                    <option value="ON_SALE" selected="@(Model.StatusFilter == "ON_SALE")">ON_SALE (Đang mở bán)</option>
                    <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">DRAFT (Bản nháp)</option>
                    <option value="CLOSED" selected="@(Model.StatusFilter == "CLOSED")">CLOSED (Đã đóng)</option>
                    <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">CANCELLED (Đã hủy)</option>
                </select>
            </div>
            <div class="bgp-ops-filter-actions">
                <button type="submit" class="bgp-btn bgp-btn--primary bgp-btn--sm">Lọc danh sách</button>
                <a asp-action="Showtimes" class="bgp-btn bgp-btn--outline bgp-btn--sm" title="Đặt lại bộ lọc">Đặt lại</a>
            </div>
        </form>
    </div>

    <!-- Showtimes Table -->
    <section class="bgp-ops-card">
        <div class="bgp-ops-card__header">
            <h2 class="bgp-ops-card__title">Tổng số suất chiếu: @Model.TotalCount</h2>
            <span class="badge bgp-ops-badge bgp-ops-badge--slate">Trang @Model.CurrentPage / @Model.TotalPages</span>
        </div>
        <div class="bgp-ops-card__body bgp-ops-card__body--flush">
            @if (Model.Items.Count == 0)
            {
                <div style="padding: 36px 16px; text-align: center; color: var(--bgp-text-muted);">
                    Không tìm thấy suất chiếu nào phù hợp với bộ lọc.
                </div>
            }
            else
            {
                <div class="bgp-ops-table-wrap">
                    <table class="bgp-ops-table">
                        <thead>
                            <tr>
                                <th>Mã suất</th>
                                <th>Phim</th>
                                <th>Phòng chiếu</th>
                                <th>Bắt đầu &amp; Kết thúc (VN)</th>
                                <th>Trạng thái</th>
                                <th class="is-center">Vé đã bán</th>
                                <th class="is-center">Tỷ lệ lấp đầy</th>
                                <th class="is-right">Doanh thu (VNĐ)</th>
                                <th class="is-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                var occ = item.OccupancyPct;
                                var meterMod = occ >= 70m ? "bgp-ops-meter__fill--high" : occ >= 30m ? "bgp-ops-meter__fill--mid" : "";
                                <tr>
                                    <td class="bgp-ops-mono">#@item.ShowtimeId</td>
                                    <td>
                                        <a asp-action="MovieDetail" asp-route-id="@item.MovieId" class="bgp-ops-link">
                                            @item.MovieTitle
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bgp-ops-badge bgp-ops-badge--slate">@item.RoomName</span>
                                    </td>
                                    <td class="bgp-ops-mono" style="white-space: nowrap;">
                                        <div style="font-weight: 700; color: #FFFFFF;">@item.StartUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="bgp-ops-movie-sub">đến @item.EndUtc.AddHours(7).ToString("HH:mm") (đệm @item.BufferMinutes p)</div>
                                    </td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "ON_SALE":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--emerald">ON_SALE</span>
                                                break;
                                            case "DRAFT":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--amber">DRAFT</span>
                                                break;
                                            case "CLOSED":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--slate">CLOSED</span>
                                                break;
                                            case "CANCELLED":
                                                <span class="badge bgp-ops-badge bgp-ops-badge--danger">CANCELLED</span>
                                                break;
                                            default:
                                                <span class="badge bgp-ops-badge bgp-ops-badge--slate">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="is-center bgp-ops-mono">
                                        <strong style="color: #FFFFFF;">@item.TicketsSold</strong>
                                        <span>/ @item.SellableCapacity</span>
                                    </td>
                                    <td class="is-center">
                                        <div class="bgp-ops-meter">
                                            <div class="bgp-ops-meter__fill @meterMod" style="width: @Math.Min(occ, 100m).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                        <span class="bgp-ops-mono" style="font-size: 0.78rem; font-weight: 700; color: #FFFFFF;">@occ.ToString("F1")%</span>
                                    </td>
                                    <td class="is-right bgp-ops-money">
                                        @item.RevenueVnd.ToString("N0") đ
                                    </td>
                                    <td class="is-right">
                                        <a asp-action="ShowtimeDetail" asp-route-id="@item.ShowtimeId" class="bgp-btn bgp-btn--outline bgp-btn--sm">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="bgp-ops-card__footer">
                <span class="bgp-ops-hint" style="margin:0;">Hiển thị trang @Model.CurrentPage / @Model.TotalPages</span>
                <nav aria-label="Phân trang danh sách suất chiếu">
                    <ul class="bgp-ops-pagination">
                        <li>
                            <a class="bgp-ops-page-link @(Model.CurrentPage <= 1 ? "is-disabled" : "")"
                               asp-action="Showtimes"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-movieId="@Model.SelectedMovieId"
                               asp-route-roomId="@Model.SelectedRoomId"
                               asp-route-date="@Model.DateFilter"
                               asp-route-status="@Model.StatusFilter">&laquo; Trước</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li>
                                <a class="bgp-ops-page-link @(p == Model.CurrentPage ? "is-active" : "")"
                                   asp-action="Showtimes"
                                   asp-route-page="@p"
                                   asp-route-movieId="@Model.SelectedMovieId"
                                   asp-route-roomId="@Model.SelectedRoomId"
                                   asp-route-date="@Model.DateFilter"
                                   asp-route-status="@Model.StatusFilter">@p</a>
                            </li>
                        }
                        <li>
                            <a class="bgp-ops-page-link @(Model.CurrentPage >= Model.TotalPages ? "is-disabled" : "")"
                               asp-action="Showtimes"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-movieId="@Model.SelectedMovieId"
                               asp-route-roomId="@Model.SelectedRoomId"
                               asp-route-date="@Model.DateFilter"
                               asp-route-status="@Model.StatusFilter">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/modules/ops-management.js" asp-append-version="true"></script>
}
