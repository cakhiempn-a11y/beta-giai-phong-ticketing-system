@model BetaGiaiPhong.Web.Models.ViewModels.ManageShowtimesViewModel
@{
    ViewData["Title"] = "Quản lý Suất chiếu";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark">Lịch chiếu & Suất chiếu</h1>
            <p class="text-secondary mb-0 small">Theo dõi trạng thái, doanh thu, công suất phòng và công bố suất chiếu mới.</p>
        </div>
        <div>
            <a asp-action="ShowtimeCreate" class="btn btn-primary btn-sm px-3 shadow-sm">
                + Công bố suất chiếu mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Showtimes" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Phim</label>
                    <select name="movieId" class="form-select form-select-sm">
                        <option value="">-- Tất cả phim --</option>
                        @foreach (var m in Model.Movies)
                        {
                            <option value="@m.MovieId" selected="@(Model.SelectedMovieId == m.MovieId)">@m.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Phòng chiếu</label>
                    <select name="roomId" class="form-select form-select-sm">
                        <option value="">-- Tất cả phòng --</option>
                        @foreach (var r in Model.Rooms)
                        {
                            <option value="@r.RoomId" selected="@(Model.SelectedRoomId == r.RoomId)">@r.RoomName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Ngày chiếu</label>
                    <input type="date" name="date" value="@Model.DateFilter" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Trạng thái</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="ALL" selected="@(Model.StatusFilter == "ALL")">-- Tất cả --</option>
                        <option value="ON_SALE" selected="@(Model.StatusFilter == "ON_SALE")">ON_SALE (Đang mở bán)</option>
                        <option value="DRAFT" selected="@(Model.StatusFilter == "DRAFT")">DRAFT (Bản nháp)</option>
                        <option value="CLOSED" selected="@(Model.StatusFilter == "CLOSED")">CLOSED (Đã đóng)</option>
                        <option value="CANCELLED" selected="@(Model.StatusFilter == "CANCELLED")">CANCELLED (Đã hủy)</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Lọc danh sách</button>
                    <a asp-action="Showtimes" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">&#x21bb;</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Showtimes Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">Tổng số suất chiếu: <strong>@Model.TotalCount</strong></span>
            <span class="small text-muted">Trang @Model.CurrentPage / @Model.TotalPages</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <p class="mb-0">Không tìm thấy suất chiếu nào phù hợp với bộ lọc.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small">
                            <tr>
                                <th class="ps-3" style="width: 80px;">Mã suất</th>
                                <th>Phim</th>
                                <th>Phòng chiếu</th>
                                <th>Bắt đầu & Kết thúc (VN)</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Vé đã bán</th>
                                <th class="text-center">Tỷ lệ lấp đầy</th>
                                <th class="text-end">Doanh thu (VNĐ)</th>
                                <th class="text-end pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">#@item.ShowtimeId</td>
                                    <td>
                                        <a asp-action="MovieDetail" asp-route-id="@item.MovieId" class="fw-semibold text-decoration-none text-dark">
                                            @item.MovieTitle
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.RoomName</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.StartUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="small text-muted">đến @item.EndUtc.AddHours(7).ToString("HH:mm") (đệm @item.BufferMinutes p)</div>
                                    </td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "ON_SALE":
                                                <span class="badge bg-success">ON_SALE</span>
                                                break;
                                            case "DRAFT":
                                                <span class="badge bg-warning text-dark">DRAFT</span>
                                                break;
                                            case "CLOSED":
                                                <span class="badge bg-secondary">CLOSED</span>
                                                break;
                                            case "CANCELLED":
                                                <span class="badge bg-danger">CANCELLED</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold">@item.TicketsSold</span>
                                        <span class="text-muted small">/ @item.SellableCapacity</span>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var occ = item.OccupancyPct;
                                            var occBadge = occ >= 70 ? "bg-success" : occ >= 30 ? "bg-primary" : "bg-secondary";
                                        }
                                        <span class="badge @occBadge">@occ.ToString("F1")%</span>
                                    </td>
                                    <td class="text-end fw-semibold text-dark">
                                        @item.RevenueVnd.ToString("N0") đ
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="ShowtimeDetail" asp-route-id="@item.ShowtimeId" class="btn btn-sm btn-outline-primary">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2 border-top">
                <span class="small text-muted">Hiển thị trang @Model.CurrentPage / @Model.TotalPages</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Showtimes"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-movieId="@Model.SelectedMovieId"
                               asp-route-roomId="@Model.SelectedRoomId"
                               asp-route-date="@Model.DateFilter"
                               asp-route-status="@Model.StatusFilter">Trước</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Showtimes"
                                   asp-route-page="@p"
                                   asp-route-movieId="@Model.SelectedMovieId"
                                   asp-route-roomId="@Model.SelectedRoomId"
                                   asp-route-date="@Model.DateFilter"
                                   asp-route-status="@Model.StatusFilter">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Showtimes"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-movieId="@Model.SelectedMovieId"
                               asp-route-roomId="@Model.SelectedRoomId"
                               asp-route-date="@Model.DateFilter"
                               asp-route-status="@Model.StatusFilter">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
