@model BetaGiaiPhong.Web.Models.ViewModels.ManageShowtimeDetailViewModel
@{
    var d = Model.Details;
    ViewData["Title"] = $"Suất chiếu #{d.ShowtimeId}: {d.MovieTitle}";
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Showtimes">Lịch chiếu</a></li>
            <li class="breadcrumb-item active" aria-current="page">Suất chiếu #@d.ShowtimeId</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action Overview -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-secondary">Mã suất: #@d.ShowtimeId</span>
                        @switch (d.Status)
                        {
                            case "ON_SALE":
                                <span class="badge bg-success">ON_SALE - Đang mở bán</span>
                                break;
                            case "DRAFT":
                                <span class="badge bg-warning text-dark">DRAFT - Bản nháp</span>
                                break;
                            case "CLOSED":
                                <span class="badge bg-secondary">CLOSED - Đã đóng</span>
                                break;
                            case "CANCELLED":
                                <span class="badge bg-danger">CANCELLED - Đã hủy</span>
                                break;
                            default:
                                <span class="badge bg-light text-dark">@d.Status</span>
                                break;
                        }
                    </div>
                    <h1 class="h3 fw-bold text-dark mb-1">@d.MovieTitle</h1>
                    <div class="text-muted small">
                        <strong>@d.RoomName</strong> &bull;
                        Thời lượng: @d.MovieDurationMin phút &bull;
                        Bắt đầu: <strong>@d.StartUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (VN)</strong> &bull;
                        Kết thúc: <strong>@d.EndUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (VN)</strong> (Đệm: @d.BufferMinutes p)
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (d.Status == "ON_SALE" || d.Status == "DRAFT")
                    {
                        <form method="post" asp-action="ShowtimeClose" asp-route-id="@d.ShowtimeId" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn đóng bán vé cho suất chiếu này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm px-3">
                                Đóng bán vé (CLOSE)
                            </button>
                        </form>
                    }

                    @if (d.Status != "CANCELLED")
                    {
                        if (d.CanCancel)
                        {
                            <form method="post" asp-action="ShowtimeCancel" asp-route-id="@d.ShowtimeId" class="d-inline" onsubmit="return confirm('CẢNH BÁO: Hủy suất chiếu sẽ giải phóng toàn bộ ghế giữ và không thể mở lại. Bạn có chắc chắn muốn hủy?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                                    Hủy suất chiếu (CANCEL)
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm px-3" disabled title="Không thể hủy vì đã có vé bán ra hoặc ghế đã thanh toán.">
                                Không thể hủy (Đã bán vé)
                            </button>
                        }
                    }
                </div>
            </div>

            <!-- KPI Row -->
            <div class="row g-3 pt-3 border-top">
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small mb-1">Doanh thu thu được</div>
                        <div class="h4 fw-bold text-success mb-0">@d.RevenueVnd.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small mb-1">Vé đã bán</div>
                        <div class="h4 fw-bold text-dark mb-0">@d.TicketsSold <span class="fs-6 fw-normal text-muted">/ @d.SellableCapacity</span></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small mb-1">Tỷ lệ lấp đầy</div>
                        <div class="h4 fw-bold text-primary mb-0">@d.OccupancyPct.ToString("F1")%</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-light rounded text-center">
                        <div class="text-muted small mb-1">Trạng thái ghế</div>
                        <div class="d-flex justify-content-center gap-2 small fw-semibold">
                            <span class="text-success" title="Ghế trống">@d.SeatCounts.Available Trống</span>
                            <span class="text-warning" title="Đang giữ">@d.SeatCounts.Held Giữ</span>
                            <span class="text-primary" title="Đã bán">@d.SeatCounts.Sold Bán</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Seat Price Reference -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="h6 fw-bold mb-0 text-dark">Bảng giá vé theo loại ghế</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var price in d.Prices)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <span class="fw-semibold">@price.SeatTypeCode</span>
                                    <div class="small text-muted">Loại ghế định cấu hình</div>
                                </div>
                                <span class="badge bg-light text-dark fs-6 border">@price.AmountVnd.ToString("N0") đ</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Legend and summary -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="h6 fw-bold mb-0 text-dark">Chú giải trạng thái sơ đồ phòng chiếu</h5>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success border" style="width: 24px; height: 24px; display:inline-block;"> </span>
                            <span class="small">Ghế trống (AVAILABLE): <strong>@d.SeatCounts.Available</strong></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning border" style="width: 24px; height: 24px; display:inline-block;"> </span>
                            <span class="small">Đang giữ chỗ (HELD): <strong>@d.SeatCounts.Held</strong></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary border" style="width: 24px; height: 24px; display:inline-block;"> </span>
                            <span class="small">Đã thanh toán (SOLD): <strong>@d.SeatCounts.Sold</strong></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary border" style="width: 24px; height: 24px; display:inline-block;"> </span>
                            <span class="small">Ghế khóa (BLOCKED): <strong>@d.SeatCounts.Blocked</strong></span>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        Sơ đồ phản ánh thời gian thực tình trạng bán vé của phòng chiếu cho suất này.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Seat Map Visualization Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom text-center">
            <h5 class="h6 fw-bold mb-0 text-dark">Sơ đồ ghế thời gian thực</h5>
        </div>
        <div class="card-body p-4 bg-light">
            <!-- Screen Representation -->
            <div class="text-center mb-4">
                <div class="mx-auto py-2 px-5 bg-dark text-white rounded-pill shadow-sm" style="max-width: 450px; letter-spacing: 2px; font-size: 0.85rem;">
                    [ MÀN HÌNH CHIẾU ]
                </div>
            </div>

            <!-- Seat Matrix Grid -->
            <div class="overflow-auto py-3 text-center">
                <div class="d-inline-block text-start">
                    @{
                        var groupedSeats = d.Seats.GroupBy(s => s.RowLabel).OrderBy(g => g.Key);
                    }
                    @foreach (var row in groupedSeats)
                    {
                        <div class="d-flex align-items-center justify-content-center mb-2 gap-1">
                            <span class="fw-bold text-muted text-center me-2" style="width: 24px;">@row.Key</span>
                            @foreach (var seat in row.OrderBy(s => s.ColumnNo))
                            {
                                var badgeClass = seat.State switch
                                {
                                    "AVAILABLE" => "bg-success text-white",
                                    "HELD" => "bg-warning text-dark",
                                    "SOLD" => "bg-primary text-white",
                                    "BLOCKED" => "bg-secondary text-white",
                                    _ => "bg-light text-dark"
                                };

                                var tooltip = $"{seat.SeatCode} ({seat.SeatTypeCode}) - {seat.State}";
                                if (seat.State == "HELD" && seat.HoldExpiresUtc.HasValue)
                                {
                                    tooltip += $" (Hết hạn: {seat.HoldExpiresUtc.Value.AddHours(7):HH:mm:ss})";
                                }

                                <div class="badge @badgeClass d-flex align-items-center justify-content-center border"
                                     style="width: 38px; height: 32px; font-size: 0.75rem; cursor: pointer;"
                                     title="@tooltip">
                                    @seat.SeatCode
                                </div>
                            }
                            <span class="fw-bold text-muted text-center ms-2" style="width: 24px;">@row.Key</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
