@model BetaGiaiPhong.Web.Models.ViewModels.ManageShowtimeDetailViewModel
@{
    var d = Model.Details;
    ViewData["Title"] = $"Suất chiếu #{d.ShowtimeId}: {d.MovieTitle}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cinema/page-ops.css" asp-append-version="true" />
}

<div class="bgp-ops-page">
    <ol class="bgp-ops-breadcrumb" aria-label="Breadcrumb">
        <li><a asp-action="Showtimes">Lịch chiếu</a></li>
        <li class="bgp-ops-breadcrumb__sep" aria-hidden="true">/</li>
        <li aria-current="page">Suất chiếu #@d.ShowtimeId</li>
    </ol>

    @if (TempData["Success"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--success" role="status">
            <span>@TempData["Success"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bgp-ops-alert bgp-ops-alert--danger alert-danger" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" class="bgp-ops-alert__close" data-dismiss-alert aria-label="Đóng thông báo">&times;</button>
        </div>
    }

    <!-- Header & Lifecycle Controls -->
    <header class="bgp-ops-header">
        <div class="bgp-ops-header__main">
            <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:8px;">
                <span class="badge bgp-ops-badge bgp-ops-badge--slate bgp-ops-mono">Mã suất: #@d.ShowtimeId</span>
                @switch (d.Status)
                {
                    case "ON_SALE":
                        <span class="badge bgp-ops-badge bgp-ops-badge--emerald">ON_SALE - Đang mở bán</span>
                        break;
                    case "DRAFT":
                        <span class="badge bgp-ops-badge bgp-ops-badge--amber">DRAFT - Bản nháp</span>
                        break;
                    case "CLOSED":
                        <span class="badge bgp-ops-badge bgp-ops-badge--slate">CLOSED - Đã đóng</span>
                        break;
                    case "CANCELLED":
                        <span class="badge bgp-ops-badge bgp-ops-badge--danger">CANCELLED - Đã hủy</span>
                        break;
                    default:
                        <span class="badge bgp-ops-badge bgp-ops-badge--slate">@d.Status</span>
                        break;
                }
            </div>
            <h1 class="bgp-ops-title">@d.MovieTitle</h1>
            <p class="bgp-ops-subtitle">
                <strong style="color:#FFFFFF;">@d.RoomName</strong> &bull;
                Thời lượng: @d.MovieDurationMin phút &bull;
                Bắt đầu: <strong class="bgp-ops-mono" style="color:#FFFFFF;">@d.StartUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (VN)</strong> &bull;
                Kết thúc: <strong class="bgp-ops-mono" style="color:#FFFFFF;">@d.EndUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (VN)</strong> (Đệm: @d.BufferMinutes p)
            </p>
        </div>

        <div class="bgp-ops-actions">
            @if (d.Status == "ON_SALE" || d.Status == "DRAFT")
            {
                <form method="post"
                      asp-action="ShowtimeClose"
                      asp-route-id="@d.ShowtimeId"
                      data-confirm-dialog="closeShowtimeDialog"
                      style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bgp-btn bgp-btn--outline bgp-btn--sm" data-testid="trigger-close-showtime-btn">
                        Đóng bán vé (CLOSE)
                    </button>
                </form>
            }

            @if (d.Status != "CANCELLED")
            {
                if (d.CanCancel)
                {
                    <form method="post"
                          asp-action="ShowtimeCancel"
                          asp-route-id="@d.ShowtimeId"
                          data-confirm-dialog="cancelShowtimeDialog"
                          style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="bgp-btn bgp-btn--danger bgp-btn--sm" data-testid="trigger-cancel-showtime-btn">
                            Hủy suất chiếu (CANCEL)
                        </button>
                    </form>
                }
                else
                {
                    <button type="button"
                            class="bgp-btn bgp-btn--danger bgp-btn--sm"
                            disabled
                            title="Không thể hủy vì đã có vé bán ra hoặc ghế đã thanh toán.">
                        Không thể hủy (Đã bán vé)
                    </button>
                }
            }
        </div>
    </header>

    <!-- KPI Strip -->
    <div class="bgp-ops-kpi-grid">
        <article class="bgp-ops-kpi bgp-ops-kpi--emerald">
            <div class="bgp-ops-kpi__label">Doanh thu thu được</div>
            <div class="bgp-ops-kpi__value">@d.RevenueVnd.ToString("N0") <span class="bgp-ops-kpi__unit">đ</span></div>
            <div class="bgp-ops-kpi__note">Từ vé đã thanh toán thành công</div>
        </article>
        <article class="bgp-ops-kpi bgp-ops-kpi--brand">
            <div class="bgp-ops-kpi__label">Vé đã bán</div>
            <div class="bgp-ops-kpi__value">@d.TicketsSold <span class="bgp-ops-kpi__unit">/ @d.SellableCapacity</span></div>
            <div class="bgp-ops-kpi__note">Trên tổng sức chứa mở bán</div>
        </article>
        <article class="bgp-ops-kpi bgp-ops-kpi--sky">
            <div class="bgp-ops-kpi__label">Tỷ lệ lấp đầy</div>
            <div class="bgp-ops-kpi__value">@d.OccupancyPct.ToString("F1")%</div>
            <div class="bgp-ops-kpi__note">Công suất phòng thời gian thực</div>
        </article>
        <article class="bgp-ops-kpi bgp-ops-kpi--gold">
            <div class="bgp-ops-kpi__label">Trạng thái ghế</div>
            <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:10px;">
                <span class="badge bgp-ops-badge bgp-ops-badge--emerald bgp-ops-mono">@d.SeatCounts.Available Trống</span>
                <span class="badge bgp-ops-badge bgp-ops-badge--amber bgp-ops-mono">@d.SeatCounts.Held Giữ</span>
                <span class="badge bgp-ops-badge bgp-ops-badge--danger bgp-ops-mono">@d.SeatCounts.Sold Bán</span>
            </div>
        </article>
    </div>

    <div class="bgp-ops-split-sidebar">
        <!-- Seat Price Reference -->
        <section class="bgp-ops-card" style="margin-bottom:0;">
            <div class="bgp-ops-card__header">
                <h2 class="bgp-ops-card__title">Bảng giá vé theo loại ghế</h2>
            </div>
            <div class="bgp-ops-card__body">
                <ul class="bgp-ticket-kv-list">
                    @foreach (var price in d.Prices)
                    {
                        <li class="bgp-ticket-kv-item">
                            <span class="bgp-ticket-kv-label bgp-ops-mono" style="color: #FFFFFF; font-weight: 700;">@price.SeatTypeCode</span>
                            <span class="bgp-ops-money">@price.AmountVnd.ToString("N0") đ</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <!-- Legend -->
        <section class="bgp-ops-card" style="margin-bottom:0;">
            <div class="bgp-ops-card__header">
                <h2 class="bgp-ops-card__title">Chú giải trạng thái sơ đồ phòng chiếu</h2>
            </div>
            <div class="bgp-ops-card__body">
                <div class="bgp-ops-legend" style="margin-bottom: 10px;">
                    <div class="bgp-ops-legend__item">
                        <span class="bgp-ops-legend__swatch bgp-ops-seat--available"></span>
                        <span>Ghế trống (AVAILABLE): <strong style="color:#FFFFFF;">@d.SeatCounts.Available</strong></span>
                    </div>
                    <div class="bgp-ops-legend__item">
                        <span class="bgp-ops-legend__swatch bgp-ops-seat--held"></span>
                        <span>Đang giữ chỗ (HELD): <strong style="color:#FFFFFF;">@d.SeatCounts.Held</strong></span>
                    </div>
                    <div class="bgp-ops-legend__item">
                        <span class="bgp-ops-legend__swatch bgp-ops-seat--sold"></span>
                        <span>Đã thanh toán (SOLD): <strong style="color:#FFFFFF;">@d.SeatCounts.Sold</strong></span>
                    </div>
                    <div class="bgp-ops-legend__item">
                        <span class="bgp-ops-legend__swatch bgp-ops-seat--blocked"></span>
                        <span>Ghế khóa (BLOCKED): <strong style="color:#FFFFFF;">@d.SeatCounts.Blocked</strong></span>
                    </div>
                </div>
                <p class="bgp-ops-hint" style="margin:0;">
                    Sơ đồ phản ánh thời gian thực tình trạng bán vé và khóa ghế của phòng chiếu cho suất chiếu này.
                </p>
            </div>
        </section>
    </div>

    <!-- Seat Map Visualization Card -->
    <section class="bgp-ops-card">
        <div class="bgp-ops-card__header">
            <h2 class="bgp-ops-card__title">Sơ đồ ghế thời gian thực</h2>
            <span class="badge bgp-ops-badge bgp-ops-badge--slate">@d.RoomName</span>
        </div>
        <div class="bgp-ops-card__body">
            <div class="bgp-ops-stage">
                <div class="bgp-ops-screen-arc">[ MÀN HÌNH CHIẾU ]</div>

                <div class="bgp-ops-seat-scroll">
                    <div class="bgp-ops-seat-matrix">
                        @{
                            var groupedSeats = d.Seats.GroupBy(s => s.RowLabel).OrderBy(g => g.Key);
                        }
                        @foreach (var row in groupedSeats)
                        {
                            <div class="bgp-ops-seat-row">
                                <span class="bgp-ops-seat-row__label">@row.Key</span>
                                @foreach (var seat in row.OrderBy(s => s.ColumnNo))
                                {
                                    var seatMod = seat.State switch
                                    {
                                        "AVAILABLE" => "bgp-ops-seat--available",
                                        "HELD" => "bgp-ops-seat--held",
                                        "SOLD" => "bgp-ops-seat--sold",
                                        "BLOCKED" => "bgp-ops-seat--blocked",
                                        _ => "bgp-ops-seat--standard"
                                    };

                                    var tooltip = $"{seat.SeatCode} ({seat.SeatTypeCode}) - {seat.State}";
                                    if (seat.State == "HELD" && seat.HoldExpiresUtc.HasValue)
                                    {
                                        tooltip += $" (Hết hạn: {seat.HoldExpiresUtc.Value.AddHours(7):HH:mm:ss})";
                                    }

                                    <div class="bgp-ops-seat @seatMod" title="@tooltip">
                                        @seat.SeatCode
                                    </div>
                                }
                                <span class="bgp-ops-seat-row__label">@row.Key</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Accessible Confirmation Dialogs -->
    @if (d.Status == "ON_SALE" || d.Status == "DRAFT")
    {
        <dialog id="closeShowtimeDialog"
                class="bgp-dialog bgp-ops-dialog"
                data-testid="close-showtime-dialog"
                aria-labelledby="closeShowtimeDialogTitle">
            <h2 id="closeShowtimeDialogTitle" class="bgp-ops-dialog__title">Xác nhận đóng bán vé suất chiếu</h2>
            <p class="bgp-ops-dialog__desc">
                Bạn có chắc chắn muốn đóng bán vé cho suất chiếu <strong>#@d.ShowtimeId (@d.MovieTitle)</strong>?
                Khách hàng sẽ không thể đặt giữ thêm ghế mới, nhưng các vé đã phát hành vẫn được soát vé bình thường tại cổng rạp.
            </p>
            <div class="bgp-ops-dialog__actions">
                <button type="button" class="bgp-btn bgp-btn--outline bgp-btn--sm" data-dialog-cancel>
                    Giữ mở bán
                </button>
                <button type="button"
                        class="bgp-btn bgp-btn--primary bgp-btn--sm"
                        data-dialog-confirm
                        data-testid="confirm-close-showtime-btn">
                    Xác nhận đóng bán vé
                </button>
            </div>
        </dialog>
    }

    @if (d.Status != "CANCELLED" && d.CanCancel)
    {
        <dialog id="cancelShowtimeDialog"
                class="bgp-dialog bgp-ops-dialog"
                data-testid="cancel-showtime-dialog"
                aria-labelledby="cancelShowtimeDialogTitle">
            <h2 id="cancelShowtimeDialogTitle" class="bgp-ops-dialog__title">Cảnh báo hủy suất chiếu</h2>
            <p class="bgp-ops-dialog__desc">
                Hủy suất chiếu <strong>#@d.ShowtimeId (@d.MovieTitle)</strong> sẽ giải phóng toàn bộ ghế đang giữ tạm thời và chuyển suất chiếu sang trạng thái <code>CANCELLED</code> không thể mở lại.
            </p>
            <div class="bgp-ops-dialog__actions">
                <button type="button" class="bgp-btn bgp-btn--outline bgp-btn--sm" data-dialog-cancel>
                    Không hủy
                </button>
                <button type="button"
                        class="bgp-btn bgp-btn--danger bgp-btn--sm"
                        data-dialog-confirm
                        data-testid="confirm-cancel-showtime-btn">
                    Xác nhận hủy suất chiếu
                </button>
            </div>
        </dialog>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/modules/ops-management.js" asp-append-version="true"></script>
}
