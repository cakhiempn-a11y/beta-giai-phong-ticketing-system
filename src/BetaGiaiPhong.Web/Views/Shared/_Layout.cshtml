<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beta Giải Phóng Cinema</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-compat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bgp-app-shell">
    <a href="#main-content" class="bgp-skip-link">Chuyển đến nội dung chính</a>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool isHomeActive = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);
        bool isMoviesActive = currentController.Equals("Movies", StringComparison.OrdinalIgnoreCase);
        bool isOrdersActive = currentController.Equals("Orders", StringComparison.OrdinalIgnoreCase);
        bool isStaffCheckInActive = currentController.Equals("StaffCheckIn", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase);
        bool isStaffHistoryActive = currentController.Equals("StaffCheckIn", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("History", StringComparison.OrdinalIgnoreCase);
        bool isManagementActive = currentController.Equals("Management", StringComparison.OrdinalIgnoreCase);
        bool isPrivacyActive = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Privacy", StringComparison.OrdinalIgnoreCase);
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bgp-navbar">
            <div class="container">
                <a class="navbar-brand bgp-brand" asp-controller="Home" asp-action="Index">
                    <span class="bgp-brand-badge">BETA</span>
                    <span class="bgp-brand-name">Giải Phóng</span>
                </a>
                <button class="navbar-toggler bgp-navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse bgp-navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(isHomeActive ? "active" : "")" aria-current="@(isHomeActive ? "page" : null)" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isMoviesActive ? "active" : "")" aria-current="@(isMoviesActive ? "page" : null)" asp-controller="Movies" asp-action="Index">Phim đang chiếu</a>
                        </li>
                        @if (User.IsInRole("CUSTOMER"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isOrdersActive ? "active" : "")" aria-current="@(isOrdersActive ? "page" : null)" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a>
                            </li>
                        }
                        @if (User.IsInRole("STAFF") || User.IsInRole("MANAGER") || User.IsInRole("ADMIN"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isStaffCheckInActive ? "active" : "")" aria-current="@(isStaffCheckInActive ? "page" : null)" asp-controller="StaffCheckIn" asp-action="Index">Soát vé</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isStaffHistoryActive ? "active" : "")" aria-current="@(isStaffHistoryActive ? "page" : null)" asp-controller="StaffCheckIn" asp-action="History">Lịch sử soát vé</a>
                            </li>
                        }
                        @if (User.IsInRole("MANAGER") || User.IsInRole("ADMIN"))
                        {
                            bool isReportsActive = isManagementActive && currentAction.Equals("Reports", StringComparison.OrdinalIgnoreCase);
                            bool isMgmtMoviesActive = isManagementActive && currentAction.StartsWith("Movie", StringComparison.OrdinalIgnoreCase);
                            bool isMgmtShowtimesActive = isManagementActive && currentAction.StartsWith("Showtime", StringComparison.OrdinalIgnoreCase);
                            bool isMgmtRoomsActive = isManagementActive && currentAction.StartsWith("Room", StringComparison.OrdinalIgnoreCase);

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(isManagementActive ? "active" : "")" href="#" id="managementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span>Vận hành</span>
                                </a>
                                <ul class="dropdown-menu bgp-dropdown-menu shadow" aria-labelledby="managementDropdown">
                                    <li><a class="dropdown-item bgp-dropdown-item @(isReportsActive ? "active" : "")" aria-current="@(isReportsActive ? "page" : null)" asp-controller="Management" asp-action="Reports">Báo cáo &amp; Doanh thu</a></li>
                                    <li><hr class="dropdown-divider bgp-dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item bgp-dropdown-item @(isMgmtMoviesActive ? "active" : "")" aria-current="@(isMgmtMoviesActive ? "page" : null)" asp-controller="Management" asp-action="Movies">Quản lý Phim</a></li>
                                    <li><a class="dropdown-item bgp-dropdown-item @(isMgmtShowtimesActive ? "active" : "")" aria-current="@(isMgmtShowtimesActive ? "page" : null)" asp-controller="Management" asp-action="Showtimes">Lịch chiếu &amp; Suất chiếu</a></li>
                                    <li><a class="dropdown-item bgp-dropdown-item @(isMgmtRoomsActive ? "active" : "")" aria-current="@(isMgmtRoomsActive ? "page" : null)" asp-controller="Management" asp-action="Rooms">Phòng chiếu &amp; Sơ đồ ghế</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(isPrivacyActive ? "active" : "")" aria-current="@(isPrivacyActive ? "page" : null)" asp-controller="Home" asp-action="Privacy">Giới thiệu &amp; Quy chế</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var roleClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "USER";
                            var displayName = User.Identity.Name ?? "Tài khoản";
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle bgp-user-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@displayName">
                                    <span class="bgp-role-pill">@roleClaim</span>
                                    <span class="bgp-user-name">@displayName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end bgp-dropdown-menu shadow" aria-labelledby="userDropdown">
                                    <li class="px-3 py-2 border-bottom border-secondary border-opacity-25">
                                        <div class="fw-bold text-truncate text-light" style="max-width: 200px;" title="@displayName">@displayName</div>
                                        <div class="small text-muted">Vai trò: <span class="text-light">@roleClaim</span></div>
                                    </li>
                                    <li><a class="dropdown-item bgp-dropdown-item" asp-controller="Account" asp-action="Profile">Hồ sơ tài khoản</a></li>
                                    <li><hr class="dropdown-divider bgp-dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item bgp-dropdown-item text-danger">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="bgp-footer">
        <div class="container text-center text-md-start d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div>
                <div class="fw-bold text-light mb-1">Beta Giải Phóng — MIS Capstone Project &copy; 2026.</div>
                <div class="bgp-footer-disclaimer">
                    Hệ thống học thuật sử dụng dữ liệu mô phỏng. Không phải dịch vụ thương mại của Beta Cinemas.
                </div>
            </div>
            <div class="text-md-end">
                <a class="bgp-footer-link small" asp-controller="Home" asp-action="Privacy">Giới thiệu &amp; Quy chế</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
