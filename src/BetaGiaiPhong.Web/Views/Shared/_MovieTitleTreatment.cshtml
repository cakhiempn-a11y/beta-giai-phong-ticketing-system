            </defs>
            <g transform="translate(4, 8)">
                <polygon points="18,12 30,0 42,12 30,24" fill="none" stroke="#E50914" stroke-width="2.4" />
                <polygon points="18,12 30,4 42,12 30,20" fill="#F6DE9D" opacity="0.9" />
                <line x1="52" y1="12" x2="152" y2="12" stroke="#F6DE9D" stroke-width="1.2" opacity="0.65" />
                <text x="160" y="16" fill="#F6DE9D" font-family="Georgia, 'Times New Roman', serif" font-size="12" font-weight="700" letter-spacing="4.5">PARIS • 1963</text>
            </g>
