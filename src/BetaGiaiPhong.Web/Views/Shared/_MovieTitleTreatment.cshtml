@using BetaGiaiPhong.Web.Models.Responses
@model (MovieSummaryDto? Movie, string Variant)
@{
    var movie = Model.Movie;
    string variant = string.IsNullOrWhiteSpace(Model.Variant) ? "hero" : Model.Variant;
    bool isHero = string.Equals(variant, "hero", StringComparison.OrdinalIgnoreCase);

    string rawTitle = movie?.Title ?? "Điện Ảnh Đích Thực";
    string? logoUrl = movie?.Artwork?.TitleLogoUrl;
    string qid = movie?.Provenance?.WikidataQid?.Trim() ?? "";
    string uid = $"bgp-tt-{variant}-{movie?.MovieId ?? 0}";
}

<span class="bgp-sr-only">@(movie?.Title ?? "Điện Ảnh Đích Thực Tại Beta Giải Phóng")</span>

@if (!string.IsNullOrWhiteSpace(logoUrl))
{
    <span class="bgp-title-treatment bgp-title-treatment--@variant bgp-title-treatment--img" aria-hidden="true">
        <img src="@logoUrl"
             alt=""
             class="bgp-title-treatment__img"
             loading="@(isHero ? "eager" : "lazy")"
             decoding="async"
             onerror="this.onerror=null;this.parentElement.classList.add('is-fallback');this.remove();" />
        <span class="bgp-title-treatment__img-fallback">@rawTitle</span>
    </span>
}
