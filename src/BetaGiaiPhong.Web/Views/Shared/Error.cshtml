@model BetaGiaiPhong.Web.Models.ViewModels.ErrorViewModel
@{
    Layout = "_CinemaLayout";
    ViewData["Title"] = $"Trạng thái hệ thống ({Model.StatusCode})";
    string headingText = Model.StatusCode == 404 ? "Không Tìm Thấy Nội Dung" : "Đã Xảy Ra Sự Cố";
}

<section class="bgp-static-page" aria-labelledby="error-status-title">
    <div class="bgp-container--center">
        <div class="bgp-panel bgp-panel--elevated bgp-status-panel" data-testid="error-status-panel">
            <div class="bgp-status-panel__code bgp-status-panel__code--warning">@Model.StatusCode</div>
            <h1 id="error-status-title" class="bgp-status-panel__title">@headingText</h1>
            <p class="bgp-status-panel__message">@Model.Message</p>

            @if (Model.ShowCorrelationId)
            {
                <div class="bgp-trace-box" aria-label="Thông tin truy vết kỹ thuật">
                    <div><strong>Correlation ID:</strong> <span>@Model.CorrelationId</span></div>
                    @if (Model.ShowRequestId)
                    {
                        <div style="margin-top:4px;"><strong>Request ID:</strong> <span>@Model.RequestId</span></div>
                    }
                </div>
            }

            <div class="bgp-status-panel__actions">
                <a class="bgp-btn bgp-btn--primary bgp-btn--responsive" href="/">
                    Quay lại trang chủ
                </a>
                <a class="bgp-btn bgp-btn--outline bgp-btn--responsive" asp-controller="Movies" asp-action="Index">
                    Khám phá danh mục phim
                </a>
            </div>
        </div>
    </div>
</section>
